App(
    appid="hone",
    name="HONE",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="hone_app",
    requires=["gui", "storage", "bt"],
    # 8 KB — ed25519 sign via TweetNaCl needs ~2 KB stack for SHA-512 + field math
    stack_size=8 * 1024,
    fap_category="Tools",
    fap_version="0.2.0",
    fap_icon="hone_wallet.png",
    fap_description="HONE chain identity node — ed25519 signing, BLE sensor relay, Sub-GHz/NFC/RFID collection",
    fap_author="Shin Devlin",
    fap_weburl="https://honemesh.net",
    fap_icon_assets="images",
    sources=[
        "hone.c",
        "hone_ble.c",
        "hone_scheduler.c",
        "crypto/ed25519.c",
        "crypto/tweetnacl.c",
        "protocol/hone_protocol.c",
        "scenes/hone_scene_main.c",
        "scenes/hone_scene_identity.c",
        "scenes/hone_scene_ble.c",
        "scenes/hone_scene_subghz.c",
        "scenes/hone_scene_rotate.c",
    ],
)
