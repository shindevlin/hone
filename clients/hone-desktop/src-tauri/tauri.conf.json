{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HONE",
  "version": "0.1.0",
  "identifier": "net.hone.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HONE",
        "width": 900,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true,
      "title": "HONE"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mine HONE with one click",
    "longDescription": "HONE Desktop runs a Bitcoin Proof of Compute node on your computer. Mining means useful AI inference — every token earned by real compute. No terminal, no setup, just click and mine."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
