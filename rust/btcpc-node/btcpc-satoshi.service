[Unit]
Description=BTCPC Testnet Node (btcpc-satoshi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=btcpc
WorkingDirectory=/home/btcpc

ExecStart=/usr/local/bin/btcpc-node

Environment="BTCPC_CHAIN_ID=btcpc-satoshi"
Environment="BTCPC_DATA_DIR=/var/lib/btcpc-satoshi"
Environment="BTCPC_ACCOUNT=satoshi-node"
Environment="BTCPC_NODE_ID=satoshi-node-1"
Environment="BTCPC_API_PORT=4243"
Environment="BTCPC_P2P_PORT=6943"
Environment="BTCPC_MINER=true"
Environment="BTCPC_CLOCK=true"
Environment="BTCPC_LOG_LEVEL=btcpc_node=info"
# Bootstrap against other testnet nodes:
# Environment="BTCPC_BOOTSTRAP_PEERS=/dns4/testnet1.btcpc.net/tcp/6943"
# Optional genesis file:
# Environment="BTCPC_GENESIS_FILE=/etc/btcpc/satoshi-genesis.json"

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btcpc-satoshi

[Install]
WantedBy=multi-user.target
