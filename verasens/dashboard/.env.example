# Verasens Institutional Dashboard — environment configuration.
# Copy to .env (gitignored) and fill in real values. NEVER commit real
# secrets — this file must only ever contain placeholders.

# HTTP port the dashboard service listens on.
VERASENS_DASHBOARD_PORT=7043

# Postgres connection string for the B2B service DB (org/member/api_key/
# usage_event/settlement_intent). If unset, the service falls back to an
# in-memory store — fine for local dev/demo, NOT for production (state is
# lost on restart).
DATABASE_URL=postgres://user:password@localhost:5432/verasens_dashboard

# Base URL of the Phase 1.2 aggregation service (rust/verasens, branch
# platform/p1-verasens-aggregation). The dashboard only ever calls its
# public GET /api/verasens/query endpoint.
VERASENS_AGG_URL=http://localhost:7044

# Stripe secret key (test mode: sk_test_..., live: sk_live_...). If unset,
# the service falls back to an in-memory mock Stripe client — no real
# charges are ever made without this set.
STRIPE_SECRET_KEY=

# Pepper mixed into the API-key hash (defense in depth on top of the
# already-random 24-byte key secret). Set to a random value in production.
VERASENS_API_KEY_PEPPER=

# Session cookie tuning.
VERASENS_SESSION_IDLE_MINUTES=30
VERASENS_SESSION_ABSOLUTE_HOURS=12
