[Unit]
Description=BTCPC Wallet Telegram Bot — thin client for BTCPC wallet operations
Documentation=https://btcpc.network
After=network.target btcpc-node.service

[Service]
Type=simple
WorkingDirectory=%h/repos/btcpcwalletbot
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10
EnvironmentFile=%h/repos/btcpcwalletbot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
