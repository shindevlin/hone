[Unit]
Description=HONE Wallet Telegram Bot — thin client for HONE wallet operations
Documentation=https://hone.network
After=network.target hone-node.service

[Service]
Type=simple
WorkingDirectory=%h/repos/honewalletbot
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=10
EnvironmentFile=%h/repos/honewalletbot/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
