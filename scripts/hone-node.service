[Unit]
Description=HONE Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hone
WorkingDirectory=/var/lib/hone

ExecStart=/usr/local/bin/hone-node

Environment="HONE_CHAIN_ID=hone"
Environment="HONE_DATA_DIR=/var/lib/hone"
Environment="HONE_GENESIS_TIMESTAMP=1783191600000"
Environment="HONE_API_PORT=4242"
Environment="HONE_P2P_PORT=6942"
Environment="HONE_MINER=true"
Environment="HONE_CLOCK=true"
Environment="HONE_LOG_LEVEL=hone_node=info"
# Required — set these before enabling the service:
Environment="HONE_ACCOUNT=your-account-name"
Environment="HONE_NODE_ID=MachineName(your-account-name)"
# Optional — set to your VPN interface IP to hide your real IP from peers:
# Environment="HONE_P2P_ANNOUNCE_ADDR=/ip4/10.x.x.x/tcp/6942"

# License gate: HONE will not start until its license (UFL 3.8, Operational
# Scope: Decentralized) is accepted, and exits with status 3 until then.
# Either run `hone-license accept` once as this service's user with the same
# HONE_DATA_DIR, or uncomment the next line. Uncommenting it is the act of
# accepting the license. See docs/LICENSE_ACCEPTANCE.md.
# Environment="HONE_ACCEPT_LICENSE=UFL-3.8-D"
RestartPreventExitStatus=3
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hone-node

[Install]
WantedBy=multi-user.target
