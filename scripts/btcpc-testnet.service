[Unit]
Description=BTCPC Testnet Node (btcpc-satoshi)
After=network-online.target btcpc-node.service
Wants=network-online.target

[Service]
Type=simple
User=btcpc
WorkingDirectory=/var/lib/btcpc-testnet

ExecStart=/usr/local/bin/btcpc-node

Environment="BTCPC_CHAIN_ID=btcpc-satoshi"
Environment="BTCPC_DATA_DIR=/var/lib/btcpc-testnet"
Environment="BTCPC_GENESIS_FILE=/var/lib/btcpc-testnet/genesis.json"
Environment="BTCPC_GENESIS_TIMESTAMP=1777633200000"
Environment="BTCPC_API_PORT=4343"
Environment="BTCPC_P2P_PORT=6943"
Environment="BTCPC_MINER=true"
Environment="BTCPC_CLOCK=true"
Environment="BTCPC_LOG_LEVEL=btcpc_node=info"
# Required — set these before enabling the service:
Environment="BTCPC_ACCOUNT=your-account-name"
Environment="BTCPC_NODE_ID=MachineName(your-account-name)-testnet"
# Testnet bootstrap peers (separate from mainnet — port 6943)
# Bootstrap: Grouchly(shindevlin) — LAN: 192.168.68.72, VPN: 100.90.146.17
Environment="BTCPC_BOOTSTRAP_PEERS=/dns4/bootstrap1.btcpc.net/tcp/6943"

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btcpc-testnet

[Install]
WantedBy=multi-user.target
