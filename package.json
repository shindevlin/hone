{
  "name": "btcpc",
  "version": "2.1.9",
  "description": "Bitcoin Proof of Compute — sovereign blockchain where mining means useful AI inference",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "test:watch": "jest --watch",
    "cli": "node bin/btcpc-cli",
    "setup": "node bin/btcpc-setup",
    "mine": "node bin/btcpc-mine",
    "clock": "node bin/btcpc-clock",
    "tray": "bash bin/btcpc-tray",
    "all": "node bin/btcpc-mine & node bin/btcpc-clock & bash bin/btcpc-tray &",
    "explorer": "node src/explorer/server.js",
    "p2p": "node src/p2p/network.js",
    "update": "node bin/btcpc-update",
    "website": "npx serve website",
    "smoke:api": "bash scripts/smoke-api.sh",
    "smoke:inference": "node scripts/smoke-inference.js",
    "docs": "npx docsify-cli serve docs"
  },
  "dependencies": {
    "@hiveio/dhive": "^1.3.5",
    "@openzeppelin/contracts": "^5.6.1",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "bs58": "^4.0.1",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "hdkey": "^2.1.0",
    "helmet": "^7.1.0",
    "js-sha3": "^0.9.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "secp256k1": "^5.0.1",
    "winston": "^3.11.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "blockchain",
    "wallet",
    "staking",
    "hive",
    "ton",
    "telegram"
  ],
  "author": "",
  "license": "MIT"
}
