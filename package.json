{
  "name": "freeport-protocol",
  "version": "3.1.159",
  "description": "Freeport Protocol — sovereign blockchain where compute, storage, and commerce flow without gatekeepers",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "test:watch": "jest --watch",
    "mcp:hone": "node src/mcp/honeMcpServer.js",
    "cli": "node bin/hone-cli",
    "setup": "node bin/hone-setup",
    "install:user": "bash scripts/install-user.sh",
    "mine": "node bin/hone-mine",
    "clock": "node bin/hone-clock",
    "tray": "bash bin/hone-tray",
    "all": "node bin/hone-mine & node bin/hone-clock & bash bin/hone-tray &",
    "explorer": "node src/explorer/server.js",
    "p2p": "node src/p2p/network.js",
    "update": "node bin/hone-update",
    "website": "npx serve website",
    "docs:wiki": "node scripts/code-wiki.js",
    "desktop": "electron --no-sandbox desktop/main.js",
    "desktop:dev": "HONE_DESKTOP_DEV=1 electron --no-sandbox desktop/main.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "smoke:api": "bash scripts/smoke-api.sh",
    "smoke:inference": "node scripts/smoke-inference.js",
    "smoke:testnet": "HONE_SMOKE_SKIP=0 HONE_SMOKE_URL=https://hone.net npm test -- --testPathPattern=smoke --forceExit",
    "docs": "npx docsify-cli serve docs",
    "pair-flipper": "node scripts/pair-flipper.js",
    "phone-setup": "node scripts/phone-setup.js",
    "build:pair-tool": "pkg scripts/pair-flipper.js -t node18-win,node18-linux,node18-macos --output dist/honeflipper"
  },
  "dependencies": {
    "@hiveio/dhive": "^1.3.5",
    "@openzeppelin/contracts": "^5.6.1",
    "@solana/web3.js": "^0.0.3",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.2",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "bech32": "^2.0.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bs58": "^4.0.1",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "follow-redirects": "^1.16.0",
    "hdkey": "^0.6.0",
    "helmet": "^7.1.0",
    "js-sha3": "^0.9.3",
    "jsonwebtoken": "^9.0.2",
    "level": "^10.0.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "secp256k1": "^5.0.1",
    "serialport": "^13.0.0",
    "speakeasy": "^2.0.0",
    "tiny-secp256k1": "^2.2.4",
    "winston": "^3.11.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "electron": "41.2.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/hone/",
      "<rootDir>/\\.claude/",
      "<rootDir>/camofox-browser/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/\\.claude/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/\\.claude/"
    ]
  },
  "keywords": [
    "blockchain",
    "wallet",
    "staking",
    "hive",
    "ton",
    "telegram"
  ],
  "author": "Shin Devlin <shindevlin@proton.me>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/shindevlin/hone.git"
  },
  "homepage": "https://hone.net",
  "bugs": {
    "url": "https://github.com/shindevlin/hone/issues"
  }
}
