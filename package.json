{
  "name": "btcpc",
  "version": "3.1.141",
  "description": "Bitcoin Proof of Compute — sovereign blockchain where mining means useful AI inference",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "test:watch": "jest --watch",
    "cli": "node bin/btcpc-cli",
    "setup": "node bin/btcpc-setup",
    "install:user": "bash scripts/install-user.sh",
    "mine": "node bin/btcpc-mine",
    "clock": "node bin/btcpc-clock",
    "tray": "bash bin/btcpc-tray",
    "all": "node bin/btcpc-mine & node bin/btcpc-clock & bash bin/btcpc-tray &",
    "explorer": "node src/explorer/server.js",
    "p2p": "node src/p2p/network.js",
    "update": "node bin/btcpc-update",
    "website": "npx serve website",
    "desktop": "electron --no-sandbox desktop/main.js",
    "desktop:dev": "BTCPC_DESKTOP_DEV=1 electron --no-sandbox desktop/main.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "smoke:api": "bash scripts/smoke-api.sh",
    "smoke:inference": "node scripts/smoke-inference.js",
    "docs": "npx docsify-cli serve docs"
  },
  "dependencies": {
    "@hiveio/dhive": "^1.3.5",
    "@openzeppelin/contracts": "^5.6.1",
    "@solana/web3.js": "^1.98.4",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.2",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "bs58": "^4.0.1",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "follow-redirects": "^1.16.0",
    "hdkey": "^2.1.0",
    "helmet": "^7.1.0",
    "js-sha3": "^0.9.3",
    "jsonwebtoken": "^9.0.2",
    "level": "^10.0.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "secp256k1": "^5.0.1",
    "serialport": "^13.0.0",
    "speakeasy": "^2.0.0",
    "winston": "^3.11.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^7.6.2",
    "electron": "41.2.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/btcpc/",
      "<rootDir>/\\.claude/",
      "<rootDir>/camofox-browser/"
    ]
  },
  "keywords": [
    "blockchain",
    "wallet",
    "staking",
    "hive",
    "ton",
    "telegram"
  ],
  "author": "Shin Devlin <shin@btcpc.network>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/shindevlin/btcpc.git"
  },
  "homepage": "https://btcpc.net",
  "bugs": {
    "url": "https://github.com/shindevlin/btcpc/issues"
  }
}
