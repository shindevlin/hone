<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — Material3 dark, BTCPC orange accent -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btcpc_orange</item>
        <item name="colorPrimaryVariant">@color/btcpc_surface_alt</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorSecondary">@color/btcpc_green</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSurface">@color/btcpc_surface</item>
        <item name="colorOnSurface">@color/btcpc_text</item>
        <item name="android:colorBackground">@color/btcpc_bg</item>
        <item name="colorOnBackground">@color/btcpc_text</item>
        <item name="android:windowBackground">@color/btcpc_bg</item>
        <item name="android:statusBarColor">@color/btcpc_bg</item>
        <item name="android:navigationBarColor">@color/btcpc_surface</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.BtcpcDark</item>
    </style>

    <style name="ThemeOverlay.BtcpcDark" parent="">
        <item name="colorControlHighlight">#33F7931A</item>
        <item name="colorControlActivated">@color/btcpc_orange</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="windowSplashScreenBackground">@color/btcpc_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/btcpc_logo</item>
    </style>

    <!-- Card style used in Earn fragment -->
    <style name="BtcpcCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/btcpc_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingTop">16dp</item>
        <item name="contentPaddingBottom">16dp</item>
    </style>

    <!-- Bottom nav dark background -->
    <style name="BtcpcBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/btcpc_surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
    </style>

</resources>
