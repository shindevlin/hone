<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hone_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header row: title + version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="@color/hone_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v0.0.0"
                android:textColor="@color/hone_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Update row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/settings_update_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/hone_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_update_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/hone_surface_alt"
                android:text="Check for updates"
                android:textColor="@color/hone_orange"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:strokeColor="@color/hone_orange"
                android:strokeWidth="1" />

        </LinearLayout>

        <!-- Signed-in account row -->
        <LinearLayout
            android:id="@+id/settings_account_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/hone_surface"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/settings_account_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Not signed in"
                android:textColor="@color/hone_text"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_signout_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sign Out"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:backgroundTint="@color/hone_surface_alt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:strokeColor="#EF4444"
                android:strokeWidth="1"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Posting Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Posting Key (required to mine)"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/settings_posting_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/hone_surface"
            android:hint="64-char hex posting private key"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="@color/hone_text"
            android:textColorHint="@color/hone_muted"
            android:textSize="15sp"
            android:importantForAutofill="no" />

        <!-- API URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Base URL"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/settings_api_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/hone_surface"
            android:hint="https://hone.net"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="@color/hone_text"
            android:textColorHint="@color/hone_muted"
            android:textSize="15sp" />


        <!-- Testnet mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/hone_surface"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Testnet Mode"
                    android:textColor="@color/hone_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect to hone.net:4343 (hone-satoshi)"
                    android:textColor="@color/hone_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/settings_testnet_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />

        </LinearLayout>

        <!-- Clock Relay URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clock Relay (WebSocket)"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/settings_relay_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/hone_surface"
            android:hint="wss://hone-relay.shindevlin.workers.dev/ws"
            android:inputType="textUri"
            android:padding="14dp"
            android:textColor="@color/hone_text"
            android:textColorHint="@color/hone_muted"
            android:textSize="15sp" />

        <!-- Device name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Name"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <EditText
            android:id="@+id/settings_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@color/hone_surface"
            android:hint="android-phone"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/hone_text"
            android:textColorHint="@color/hone_muted"
            android:textSize="15sp" />

        <!-- Wi-Fi privacy allowlist -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi Privacy"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Add home, office, or doctor Wi-Fi names here. GPS pauses on private Wi-Fi to protect your location privacy, while it can still broadcast when you are on other Wi-Fi away from home."
            android:textColor="@color/hone_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nearby Wi-Fi you can add"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <AutoCompleteTextView
            android:id="@+id/settings_wifi_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/hone_surface"
            android:hint="Tap a Wi-Fi name"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/hone_text"
            android:textColorHint="@color/hone_muted"
            android:textSize="15sp"
            android:completionThreshold="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_wifi_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/hone_surface_alt"
            android:text="Add to Privacy List"
            android:textColor="@color/hone_orange"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:strokeColor="@color/hone_orange"
            android:strokeWidth="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Privacy List"
            android:textColor="@color/hone_muted"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/settings_trusted_wifi_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            app:singleLine="false"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_save_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/hone_orange"
            android:text="Save"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_save_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/hone_green"
            android:textSize="13sp" />

        <!-- Process status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="PROCESS STATUS"
            android:textColor="@color/hone_muted"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hone_surface"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Relay"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_relay_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clock"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_clock_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sensor"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_sensor_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Miner"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_miner_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Storage"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_storage_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Services section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="SERVICES"
            android:textColor="@color/hone_muted"
            android:textSize="12sp"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hone_surface"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Relay (Flipper)"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_relay_status2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hone_surface_alt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clock Peer"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_clock_status2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hone_surface_alt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sensors"
                    android:textColor="@color/hone_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/settings_sensor_status2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_muted"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
