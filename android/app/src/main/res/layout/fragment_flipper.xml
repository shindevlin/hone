<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/btcpc_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Flipper Zero Relay"
        android:textColor="@color/btcpc_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Setup instructions card (always visible) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/BtcpcCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="How to pair"
                android:textColor="@color/btcpc_muted"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On your Flipper Zero:"
                android:textColor="@color/btcpc_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1. Install BTCPC Relay from the App Hub (or sideload from flipper/ in this repo)\n2. Open it: Apps &gt; GPIO &gt; BTCPC Relay\n3. Navigate to page 2 - note the BLE address shown\n4. Open BLE UART Bridge: Apps &gt; GPIO &gt; UART BLE Bridge"
                android:textColor="@color/btcpc_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="On this phone:"
                android:textColor="@color/btcpc_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="5. Plug Flipper into phone via USB - pairing scan starts automatically\n   OR tap &quot;Pair via BLE&quot; below to scan wirelessly\n6. Select your Flipper from the list\n7. Done - future connections are BLE only"
                android:textColor="@color/btcpc_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="If scan finds nothing: open BTCPC Relay on Flipper, go to page 2, and enter the address manually."
                android:textColor="@color/btcpc_muted"
                android:textSize="12sp"
                android:fontFamily="monospace" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Pairing card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/flipper_pair_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/BtcpcCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/flipper_pair_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Flipper paired"
                android:textColor="@color/btcpc_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/flipper_pair_gps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/btcpc_green"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/flipper_pair_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Plug in your Flipper via USB - the app will scan for it over BLE and pair automatically. Or tap below to scan manually."
                android:textColor="@color/btcpc_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flipper_pair_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pair via BLE"
                android:textColor="@color/btcpc_orange" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Transport indicators -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/BtcpcCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Connection"
                android:textColor="@color/btcpc_muted"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- USB indicator -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/flipper_usb_dot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@android:drawable/presence_offline"
                        android:contentDescription="USB status" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="USB"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/flipper_usb_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disconnected"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- BLE indicator -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/flipper_ble_dot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@android:drawable/presence_offline"
                        android:contentDescription="BLE status" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="BLE"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/flipper_ble_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disconnected"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- WiFi indicator -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/flipper_wifi_dot"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@android:drawable/presence_offline"
                        android:contentDescription="WiFi status" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="WiFi"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/flipper_wifi_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listening :6942"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Last reading -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/BtcpcCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Last Reading"
                android:textColor="@color/btcpc_muted"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/flipper_last_reading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No readings yet"
                android:textColor="@color/btcpc_text"
                android:textSize="14sp"
                android:fontFamily="monospace" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Reading log -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Reading Log"
        android:textColor="@color/btcpc_muted"
        android:textSize="13sp"
        android:letterSpacing="0.08" />

    <ScrollView
        android:id="@+id/flipper_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/btcpc_surface"
        android:padding="12dp">

        <TextView
            android:id="@+id/flipper_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/btcpc_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

</LinearLayout>
