<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    style="@style/HoneCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Role title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stake_role_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Role"
                android:textColor="@color/hone_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stake_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1AF7931A"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="OPEN"
                android:textColor="@color/hone_orange"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/stake_role_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="Description"
            android:textColor="@color/hone_muted"
            android:textSize="13sp" />

        <!-- Min stake + unlock row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min. Stake"
                    android:textColor="@color/hone_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/stake_role_min_stake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/hone_orange"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HONE"
                    android:textColor="@color/hone_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlock Period"
                    android:textColor="@color/hone_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/stake_role_unlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- days"
                    android:textColor="@color/hone_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Stake button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stake_role_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Stake"
            android:textColor="@android:color/black"
            android:backgroundTint="@color/hone_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
