<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/btcpc_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Section: This Device ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THIS DEVICE"
            android:textColor="@color/btcpc_muted"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <!-- 2×2 grid of service cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Clock card -->
            <LinearLayout
                android:id="@+id/card_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:id="@+id/clock_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:textColor="#4B5563"/>
                    <TextView
                        android:id="@+id/clock_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clock"
                        android:textColor="@color/btcpc_text"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/clock_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Miner card -->
            <LinearLayout
                android:id="@+id/card_miner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:id="@+id/miner_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:textColor="#4B5563"/>
                    <TextView
                        android:id="@+id/miner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Miner"
                        android:textColor="@color/btcpc_text"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/miner_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Sensors card -->
            <LinearLayout
                android:id="@+id/card_sensors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:id="@+id/sensors_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:textColor="#4B5563"/>
                    <TextView
                        android:id="@+id/sensors_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensors"
                        android:textColor="@color/btcpc_text"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/sensors_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Storage card -->
            <LinearLayout
                android:id="@+id/card_storage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:id="@+id/storage_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textSize="10sp"
                        android:layout_marginEnd="6dp"
                        android:textColor="#4B5563"/>
                    <TextView
                        android:id="@+id/storage_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage"
                        android:textColor="@color/btcpc_text"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/storage_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── Section: Chain ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BTCPC NETWORK"
                android:textColor="@color/btcpc_muted"
                android:textSize="11sp"
                android:letterSpacing="0.12"/>
            <TextView
                android:id="@+id/sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/btcpc_muted"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Epoch progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/btcpc_surface"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Epoch"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/stat_epoch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/btcpc_orange"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/epoch_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/btcpc_orange"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/epoch_progress_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/btcpc_muted"
                android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Stats grid: 2 rows × 3 cols -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/stat_peers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/btcpc_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peers"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/stat_miners"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/btcpc_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Miners"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/stat_clocks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/btcpc_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clocks"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/stat_nodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/btcpc_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nodes"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginStart="4dp"
                android:background="@color/btcpc_surface"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/stat_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#22C55E"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chain Status"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="11sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
