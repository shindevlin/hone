<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/btcpc_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Earn BTCPC"
            android:textColor="@color/btcpc_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Miner card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/BtcpcCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Miner"
                            android:textColor="@color/btcpc_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="On-device ONNX inference"
                            android:textColor="@color/btcpc_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/earn_miner_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Model"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/earn_miner_model_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/btcpc_bg"
                    android:paddingStart="8dp"
                    android:popupBackground="@color/btcpc_surface" />

                <TextView
                    android:id="@+id/earn_miner_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/btcpc_bg"
                    android:padding="8dp"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Clock peer card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/BtcpcCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clock Peer"
                            android:textColor="@color/btcpc_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="WebSocket time relay"
                            android:textColor="@color/btcpc_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/earn_clock_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:id="@+id/earn_clock_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/btcpc_bg"
                    android:padding="8dp"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sensor rig card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/BtcpcCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sensor Rig"
                            android:textColor="@color/btcpc_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Phone sensors to chain"
                            android:textColor="@color/btcpc_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/earn_sensors_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Per-sensor opt-in checkboxes (visible when toggle is on) -->
                <LinearLayout
                    android:id="@+id/earn_sensors_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="ACTIVE SENSORS"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="11sp"
                        android:letterSpacing="0.1" />

                    <CheckBox android:id="@+id/sensor_motion"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Motion (accelerometer, gyroscope)"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                    <CheckBox android:id="@+id/sensor_orientation"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Orientation (rotation vector)"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                    <CheckBox android:id="@+id/sensor_environment"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Environment (light, pressure, temp, humidity)"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                    <CheckBox android:id="@+id/sensor_magnetometer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Magnetometer"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                    <CheckBox android:id="@+id/sensor_proximity"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Proximity"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                    <CheckBox android:id="@+id/sensor_steps"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Step counter"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                    <CheckBox android:id="@+id/sensor_heartrate"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Heart rate"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="false" />

                    <CheckBox android:id="@+id/sensor_gps"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="GPS location"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="false" />

                    <CheckBox android:id="@+id/sensor_battery"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Battery level"
                        android:textColor="@color/btcpc_text" android:textSize="13sp"
                        android:buttonTint="@color/btcpc_orange" android:checked="true" />

                </LinearLayout>

                <TextView
                    android:id="@+id/earn_sensors_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/btcpc_bg"
                    android:padding="8dp"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Storage card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            style="@style/BtcpcCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Storage"
                            android:textColor="@color/btcpc_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Host BTCPC-FS blobs"
                            android:textColor="@color/btcpc_muted"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/earn_storage_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <!-- Storage quota picker -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quota: "
                        android:textColor="@color/btcpc_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/earn_storage_quota_label"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="1 GB"
                        android:textColor="@color/btcpc_orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/earn_storage_quota_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="18"
                    android:progress="3"
                    android:progressTint="@color/btcpc_orange"
                    android:thumbTint="@color/btcpc_orange" />

                <TextView
                    android:id="@+id/earn_storage_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/btcpc_bg"
                    android:padding="8dp"
                    android:text="Stopped"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
