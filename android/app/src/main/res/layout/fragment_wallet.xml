<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallet_swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/btcpc_bg"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Login section (shown when not signed in) -->
            <LinearLayout
                android:id="@+id/wallet_login_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Sign In"
                    android:textColor="@color/btcpc_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Enter your BTCPC account credentials"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Name"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/wallet_login_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/btcpc_surface"
                    android:hint="shindevlin"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:padding="14dp"
                    android:textColor="@color/btcpc_text"
                    android:textColorHint="@color/btcpc_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/wallet_login_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/btcpc_surface"
                    android:hint="password"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:padding="14dp"
                    android:textColor="@color/btcpc_text"
                    android:textColorHint="@color/btcpc_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Posting Key (optional — required to mine)"
                    android:textColor="@color/btcpc_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/wallet_login_posting_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"
                    android:background="@color/btcpc_surface"
                    android:hint="64-char hex posting private key"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:padding="14dp"
                    android:textColor="@color/btcpc_text"
                    android:textColorHint="@color/btcpc_muted"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wallet_login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="@color/btcpc_orange"
                    android:text="Sign In"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wallet_create_account_btn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/btcpc_surface_alt"
                    android:text="Create Account"
                    android:textColor="@color/btcpc_orange"
                    android:textSize="15sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:strokeColor="@color/btcpc_orange"
                    android:strokeWidth="1" />

                <TextView
                    android:id="@+id/wallet_login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View android:layout_width="match_parent" android:layout_height="24dp" />

            </LinearLayout>

            <!-- Wallet content (shown when signed in) -->
            <LinearLayout
                android:id="@+id/wallet_content_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Balance card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/BtcpcCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="13sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/wallet_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="--"
                        android:textColor="@color/btcpc_orange"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="BTCPC"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/wallet_delegated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/btcpc_muted"
                        android:textSize="13sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Address card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                style="@style/BtcpcCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Receive Address"
                        android:textColor="@color/btcpc_muted"
                        android:textSize="13sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/wallet_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textColor="@color/btcpc_text"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wallet_send_btn"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Send"
                    android:textColor="@android:color/black"
                    android:backgroundTint="@color/btcpc_orange"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wallet_receive_btn"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Receive"
                    android:textColor="@color/btcpc_orange"
                    android:backgroundTint="@color/btcpc_surface_alt"
                    android:strokeColor="@color/btcpc_orange"
                    android:strokeWidth="1"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Status / error label -->
            <TextView
                android:id="@+id/wallet_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textColor="@color/btcpc_muted"
                android:textSize="13sp"
                android:gravity="center" />

            </LinearLayout><!-- end wallet_content_section -->

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
