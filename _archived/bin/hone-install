#!/usr/bin/env node
"use strict";

var path = require("path");
require("dotenv").config({ path: path.resolve(__dirname, "../.env") });

var argv = process.argv.slice(2);

// --wizard forces plain readline wizard regardless of what's installed
if (argv.indexOf("--wizard") !== -1) {
  require("../src/installer/engines/wizard").run().catch(function (e) {
    console.error("[hone-install] " + e.message);
    process.exit(1);
  });
} else {
  require("../src/installer").run().catch(function (e) {
    console.error("[hone-install] " + e.message);
    process.exit(1);
  });
}
