#!/usr/bin/env node
"use strict";

/**
 * hone-rekey — Rebroadcast on-chain public keys for an existing account
 * Shin Devlin
 *
 * Why this exists:
 *   Accounts created BEFORE v2.13.1 (commit e234234) had their
 *   ACCOUNT_CREATE ledger entries trapped in the API server's private
 *   pendingEntries array. The miner process never saw them, so they
 *   never landed in any block payload. Replaying the chain finds the
 *   account (because of FAUCET / MINING_REWARD side-effects that auto-
 *   create empty account records) but the public_keys map is empty.
 *
 *   That breaks downstream features that need on-chain key proof:
 *     - Telegram /link verification (needs posting_public_key on chain)
 *     - Recovery via mnemonic — recoverAccount() can derive the keys
 *       but can't match them back to the username without on-chain data
 *     - Dispute escrow + ownership proofs
 *
 *   This tool fixes legacy accounts. You provide the mnemonic; it
 *   derives all the keys via the same code path createAccount uses,
 *   then writes a fresh ACCOUNT_CREATE through the cross-process queue
 *   (data/pending-entries.jsonl) so the next block written by the
 *   miner picks it up. After ~5 minutes (one epoch) the keys are
 *   permanently on chain.
 *
 * Usage:
 *   node bin/hone-rekey <username>             — interactive mnemonic prompt
 *   node bin/hone-rekey <username> --pubkeys   — paste pre-derived public keys
 *
 * The username argument is required and must already exist on chain.
 *
 * --pubkeys mode (RECOMMENDED for high-value accounts):
 *   Derive the keys on a separate trusted machine first via:
 *     node bin/hone-cli wallet recover
 *   That command takes the mnemonic interactively and prints the four
 *   public keys + EVM address WITHOUT broadcasting anything. Copy the
 *   four hex strings to this machine and paste them at the prompts.
 *   The mnemonic NEVER touches this script in --pubkeys mode.
 *
 * Default mode reads the mnemonic from stdin (12 BIP-39 words). The
 * mnemonic exists in process memory only for the ~50ms derivation step,
 * is never logged, and is never written to disk — but the safer pattern
 * is to use --pubkeys so the mnemonic never leaves your cold machine.
 *
 * --from-cli mode (NON-INTERACTIVE — for setup wizards / batch installers):
 *   Must be combined with --pubkeys. All four required public keys are
 *   supplied as CLI flags. No readline prompts are issued at any point.
 *   The 'overwrite' and 'continue' confirmation prompts are skipped.
 *
 *   Required flags (all four must be present):
 *     --owner-pk   <66-or-64-hex-char compressed public key>
 *     --active-pk  <66-or-64-hex-char compressed public key>
 *     --posting-pk <66-or-64-hex-char compressed public key>
 *     --memo-pk    <66-or-64-hex-char compressed public key>
 *
 *   Optional flag:
 *     --evm-addr   <0x + 40 hex chars>   (defaults to null if omitted)
 *
 *   Example:
 *     node bin/hone-rekey shindevlin --pubkeys --from-cli \
 *       --owner-pk   <hex> \
 *       --active-pk  <hex> \
 *       --posting-pk <hex> \
 *       --memo-pk    <hex> \
 *       --evm-addr   0x...
 *
 *   Exit codes:
 *     0 — success (ACCOUNT_CREATE written to pending-entries.jsonl)
 *     1 — bad arguments supplied by caller (usage printed to stderr)
 */

var path = require("path");
var readline = require("readline");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

var keyManager = require("../src/wallet/keyManager");
var stateStore = require("../src/chain/stateStore");
var replay = require("../src/chain/replay");
var ledger = require("../src/services/ledger");

function prompt(question) {
  return new Promise(function (resolve) {
    var rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question(question, function (answer) {
      rl.close();
      resolve(answer);
    });
  });
}

function getArgValue(argv, flag) {
  var idx = argv.indexOf(flag);
  return (idx !== -1 && idx + 1 < argv.length) ? argv[idx + 1] : null;
}

async function main() {
  var argv = process.argv.slice(2);
  var username = argv[0];
  var pubkeysMode = argv.indexOf("--pubkeys") !== -1;
  var fromCli = argv.indexOf("--from-cli") !== -1;
  if (!username || username.startsWith("--")) {
    console.error("usage: node bin/hone-rekey <username> [--pubkeys] [--from-cli ...]");
    console.error("");
    console.error("  default mode  — interactive mnemonic prompt, derives keys locally");
    console.error("  --pubkeys     — paste pre-derived hex public keys (no mnemonic)");
    console.error("  --from-cli    — non-interactive; requires --pubkeys plus:");
    console.error("                    --owner-pk <hex>  --active-pk <hex>");
    console.error("                    --posting-pk <hex>  --memo-pk <hex>");
    console.error("                    --evm-addr <0x...>  (optional)");
    process.exit(1);
  }

  if (fromCli && !pubkeysMode) {
    console.error("[hone-rekey] --from-cli requires --pubkeys");
    process.exit(1);
  }
  username = username.trim().toLowerCase();
  if (!/^[a-z0-9][a-z0-9.\-]{2,19}$/.test(username)) {
    console.error("invalid username: must be 3-20 lowercase letters/numbers/hyphens/dots");
    process.exit(1);
  }

  console.log("[hone-rekey] " + username);
  console.log("[hone-rekey] Replaying chain to check current state...");

  try {
    await replay.replayFromDisk({ verbose: false });
  } catch (err) {
    console.error("[hone-rekey] Replay error: " + err.message);
    process.exit(1);
  }

  var account = stateStore.getAccount(username);
  if (!account) {
    console.error("[hone-rekey] Account '" + username + "' not found on chain.");
    console.error("[hone-rekey] This tool only re-keys EXISTING accounts.");
    console.error("[hone-rekey] To create a new account, use bin/hone-cli wallet create.");
    process.exit(1);
  }

  var hasOwner = account.public_keys && account.public_keys.owner;
  console.log("[hone-rekey] Found '" + username + "' on chain:");
  console.log("[hone-rekey]   balance: " + account.balance + " HONE");
  console.log("[hone-rekey]   staked:  " + account.staked);
  console.log("[hone-rekey]   owner_pk: " + (hasOwner ? account.public_keys.owner.slice(0, 16) + "..." : "(empty)"));

  if (hasOwner && !fromCli) {
    console.log("");
    console.log("[hone-rekey] WARNING: " + username + " already has an owner public key on chain.");
    console.log("[hone-rekey] Re-keying will OVERWRITE the existing keys with new ones derived");
    console.log("[hone-rekey] from the mnemonic you supply. If the mnemonic is different from the");
    console.log("[hone-rekey] one originally used to create this account, you will lose access to");
    console.log("[hone-rekey] the original keys forever.");
    var confirm = await prompt("[hone-rekey] Type 'overwrite' to continue: ");
    if (confirm.trim() !== "overwrite") {
      console.log("[hone-rekey] Aborted.");
      process.exit(0);
    }
  } else if (hasOwner && fromCli) {
    console.log("[hone-rekey] WARNING: " + username + " already has an owner public key on chain — overwriting (--from-cli).");
  }

  var publicKeys;
  var chainAddresses;

  if (pubkeysMode) {
    // ── Safer path: pre-derived public keys, no mnemonic ──
    function isHexKey(s) { return /^[a-f0-9]{66}$/.test(s) || /^[a-f0-9]{64}$/.test(s); }
    function isEvmAddr(s) { return /^0x[a-f0-9]{40}$/i.test(s); }

    var owner, active, posting, memo, evm;

    if (fromCli) {
      // ── Non-interactive: read everything from CLI flags ──
      owner   = (getArgValue(process.argv, "--owner-pk")   || "").trim().toLowerCase();
      active  = (getArgValue(process.argv, "--active-pk")  || "").trim().toLowerCase();
      posting = (getArgValue(process.argv, "--posting-pk") || "").trim().toLowerCase();
      memo    = (getArgValue(process.argv, "--memo-pk")    || "").trim().toLowerCase();
      evm     = (getArgValue(process.argv, "--evm-addr")   || "").trim();

      var missing = [];
      if (!owner)   missing.push("--owner-pk");
      if (!active)  missing.push("--active-pk");
      if (!posting) missing.push("--posting-pk");
      if (!memo)    missing.push("--memo-pk");
      if (missing.length) {
        console.error("[hone-rekey] --from-cli: missing required flag(s): " + missing.join(", "));
        console.error("[hone-rekey] usage: node bin/hone-rekey <username> --pubkeys --from-cli \\");
        console.error("[hone-rekey]          --owner-pk <hex> --active-pk <hex> --posting-pk <hex> --memo-pk <hex> [--evm-addr <0x...>]");
        process.exit(1);
      }
      if (!isHexKey(owner))   { console.error("[hone-rekey] --owner-pk: invalid (expected 64 or 66 hex chars).");   process.exit(1); }
      if (!isHexKey(active))  { console.error("[hone-rekey] --active-pk: invalid (expected 64 or 66 hex chars).");  process.exit(1); }
      if (!isHexKey(posting)) { console.error("[hone-rekey] --posting-pk: invalid (expected 64 or 66 hex chars)."); process.exit(1); }
      if (!isHexKey(memo))    { console.error("[hone-rekey] --memo-pk: invalid (expected 64 or 66 hex chars).");    process.exit(1); }
      if (evm && !isEvmAddr(evm)) { console.error("[hone-rekey] --evm-addr: invalid (expected 0x + 40 hex)."); process.exit(1); }

    } else {
      // ── Interactive: prompt for each key ──
      console.log("");
      console.log("[hone-rekey] --pubkeys mode: paste the four hex public keys + EVM address.");
      console.log("[hone-rekey] Derive them on a separate trusted machine first via:");
      console.log("[hone-rekey]   node bin/hone-cli wallet recover");
      console.log("[hone-rekey] The mnemonic will NEVER touch this script.");
      console.log("");

      owner = (await prompt("[hone-rekey] Owner public key (hex):   ")).trim().toLowerCase();
      if (!isHexKey(owner)) { console.error("[hone-rekey] Invalid owner key (expected 64 or 66 hex chars)."); process.exit(1); }
      active = (await prompt("[hone-rekey] Active public key (hex):  ")).trim().toLowerCase();
      if (!isHexKey(active)) { console.error("[hone-rekey] Invalid active key."); process.exit(1); }
      posting = (await prompt("[hone-rekey] Posting public key (hex): ")).trim().toLowerCase();
      if (!isHexKey(posting)) { console.error("[hone-rekey] Invalid posting key."); process.exit(1); }
      memo = (await prompt("[hone-rekey] Memo public key (hex):    ")).trim().toLowerCase();
      if (!isHexKey(memo)) { console.error("[hone-rekey] Invalid memo key."); process.exit(1); }
      evm = (await prompt("[hone-rekey] EVM address (0x..):        ")).trim();
      if (!isEvmAddr(evm)) { console.error("[hone-rekey] Invalid EVM address (expected 0x + 40 hex)."); process.exit(1); }
    }

    publicKeys = { owner: owner, active: active, posting: posting, memo: memo };
    chainAddresses = {
      hone: null,
      evm: evm ? evm.toLowerCase() : null,
      solana: null,
      bitcoin: null,
      ton: null,
      hive: username,
    };
    console.log("");
    console.log("[hone-rekey] Public keys received. No mnemonic was entered on this machine.");
  } else {
    // ── Default: interactive mnemonic, derive keys locally ──
    console.log("");
    console.log("[hone-rekey] Enter the 12-word BIP-39 mnemonic for '" + username + "'.");
    console.log("[hone-rekey] Words must be space-separated. They will not be echoed.");

    var mnemonic = await prompt("[hone-rekey] Mnemonic: ");
    mnemonic = mnemonic.trim();

    if (!keyManager.validateMnemonic(mnemonic)) {
      console.error("[hone-rekey] Invalid BIP-39 mnemonic.");
      process.exit(1);
    }

    var words = mnemonic.split(/\s+/);
    if (words.length !== 12) {
      console.error("[hone-rekey] Mnemonic must be exactly 12 words (got " + words.length + ").");
      process.exit(1);
    }

    console.log("[hone-rekey] Deriving keys...");
    var keys = await keyManager.mnemonicToKeys(mnemonic);
    var chainWallets = await keyManager.deriveChainWallets(mnemonic);
    // Drop the mnemonic from the local scope as soon as derivation is done
    mnemonic = null;
    words = null;

    publicKeys = {
      owner: keys.owner.publicKey,
      active: keys.active.publicKey,
      posting: keys.posting.publicKey,
      memo: keys.memo.publicKey,
    };
    chainAddresses = {
      hone: chainWallets.hone ? chainWallets.hone.address : null,
      evm: chainWallets.evm ? chainWallets.evm.address : null,
      solana: chainWallets.solana ? chainWallets.solana.address : null,
      bitcoin: chainWallets.bitcoin ? chainWallets.bitcoin.address : null,
      ton: chainWallets.ton ? chainWallets.ton.address : null,
      hive: username,
    };
  }

  console.log("[hone-rekey] Public keys to broadcast:");
  console.log("[hone-rekey]   owner:   " + publicKeys.owner.slice(0, 32) + "...");
  console.log("[hone-rekey]   active:  " + publicKeys.active.slice(0, 32) + "...");
  console.log("[hone-rekey]   posting: " + publicKeys.posting.slice(0, 32) + "...");
  console.log("[hone-rekey]   memo:    " + publicKeys.memo.slice(0, 32) + "...");

  if (hasOwner && account.public_keys.owner !== publicKeys.owner) {
    console.log("");
    console.log("[hone-rekey] WARNING: supplied owner key does NOT match the existing on-chain key.");
    console.log("[hone-rekey] Existing: " + account.public_keys.owner.slice(0, 32) + "...");
    console.log("[hone-rekey] Supplied: " + publicKeys.owner.slice(0, 32) + "...");
    if (!fromCli) {
      var confirm2 = await prompt("[hone-rekey] Keys do not match prior on-chain keys. Type 'continue' to proceed: ");
      if (confirm2.trim() !== "continue") {
        console.log("[hone-rekey] Aborted.");
        process.exit(0);
      }
    } else {
      console.log("[hone-rekey] Keys do not match prior on-chain keys — proceeding anyway (--from-cli).");
    }
  }

  // Get current epoch from chain
  var epoch = stateStore.getChainHeight() || 0;
  console.log("");
  console.log("[hone-rekey] Writing ACCOUNT_CREATE for '" + username + "' at epoch " + epoch + "...");

  // recordAccountCreate goes through _persist which:
  //   1. applies to local stateStore immediately
  //   2. pushes to in-memory pendingEntries (for this process, ignored on exit)
  //   3. appends to data/pending-entries.jsonl (the cross-process queue)
  // The miner process drains the queue at its next flush (every epoch).
  await ledger.recordAccountCreate(username, publicKeys, chainAddresses, epoch);

  console.log("[hone-rekey] Wrote ACCOUNT_CREATE entry to data/pending-entries.jsonl");
  console.log("[hone-rekey] The miner will pick it up at the next epoch finalization.");
  console.log("");
  console.log("[hone-rekey] Verify in ~5 minutes by replaying the chain:");
  console.log("[hone-rekey]   node -e \"const ss=require('./src/chain/stateStore');const r=require('./src/chain/replay');(async()=>{await r.replayFromDisk({});console.log(ss.getAccount('" + username + "').public_keys)})()\"");
  console.log("");
  if (pubkeysMode) {
    console.log("[hone-rekey] Done. No mnemonic touched this machine.");
  } else {
    console.log("[hone-rekey] Done. Mnemonic discarded after derivation, NOT stored anywhere.");
  }

  process.exit(0);
}

main().catch(function (err) {
  console.error("[hone-rekey] Fatal: " + err.message);
  if (err.stack) console.error(err.stack);
  process.exit(1);
});
