#!/usr/bin/env node
"use strict";

/**
 * hone-gnss-bridge — Hyfix GNSS Base Station → HONE Chain Bridge
 * Shin Devlin
 *
 * Polls a Hyfix MobileCM device on the local network and submits
 * GNSS correction data as sensor readings to the HONE chain.
 * The device earns IoT rewards for every epoch it reports data.
 *
 * Usage:
 *   node bin/hone-gnss-bridge
 *
 * Environment:
 *   HONE_GNSS_HOST      — IP of the Hyfix device (default: auto-discover)
 *   HONE_GNSS_MINER_KEY — the miner key set during Hyfix setup
 *   HONE_GNSS_INTERVAL  — poll interval in ms (default: 30000)
 *   HONE_MINER          — HONE account to earn rewards
 *   HONE_API_PORT       — local API port (default: 4242)
 */

var path = require("path");
var http = require("http");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

var GNSS_HOST = process.env.HONE_GNSS_HOST || "192.168.68.54";
var GNSS_PORT = 80;
var MINER_KEY = process.env.HONE_GNSS_MINER_KEY || "honeshin2026";
var POLL_INTERVAL = parseInt(process.env.HONE_GNSS_INTERVAL) || 30000;
var MINER_ACCOUNT = process.env.HONE_GNSS_MINER || process.env.HONE_MINER || "shindevlin";
var API_HOST = "127.0.0.1";
var API_PORT = parseInt(process.env.HONE_API_PORT) || 4242;

// Best-effort in-process modules (only available when running inside main process context)
var ledger, stateStore, sensorRegistry;
try {
  ledger = require("../src/services/ledger");
  stateStore = require("../src/chain/stateStore");
  sensorRegistry = require("../src/services/sensorRegistry");
} catch (e) {
  // Running standalone — HTTP path is the durable submission path
}

var loginCookie = null;
var sensorRegistered = false;
var readingCount = 0;
var sensorId = MINER_ACCOUNT + "/gnss-base";
// URL-encoded sensor ID for API paths (sensorId contains a "/" which must be encoded)
var sensorIdEncoded = encodeURIComponent(sensorId);

function log(msg) { console.log("[gnss-bridge] " + msg); }
function warn(msg) { console.warn("[gnss-bridge] WARN: " + msg); }

// ─── HTTP helpers ────────────────────────────────────────────────

function httpGet(host, port, urlPath, cookie) {
  return new Promise(function (resolve, reject) {
    var opts = {
      hostname: host, port: port, path: urlPath,
      method: "GET", timeout: 5000,
      headers: cookie ? { Cookie: "USER=" + cookie } : {}
    };
    var req = http.request(opts, function (res) {
      var data = "";
      res.on("data", function (chunk) { data += chunk; });
      res.on("end", function () { resolve({ status: res.statusCode, body: data }); });
    });
    req.on("error", reject);
    req.on("timeout", function () { req.destroy(); reject(new Error("timeout")); });
    req.end();
  });
}

function httpPost(host, port, urlPath, body, contentType) {
  return new Promise(function (resolve, reject) {
    var opts = {
      hostname: host, port: port, path: urlPath,
      method: "POST", timeout: 8000,
      headers: {
        "Content-Type": contentType || "application/x-www-form-urlencoded",
        "Content-Length": Buffer.byteLength(body)
      }
    };
    var req = http.request(opts, function (res) {
      var data = "";
      res.on("data", function (chunk) { data += chunk; });
      res.on("end", function () { resolve({ status: res.statusCode, body: data }); });
    });
    req.on("error", reject);
    req.on("timeout", function () { req.destroy(); reject(new Error("timeout")); });
    req.write(body);
    req.end();
  });
}

/**
 * POST JSON to the local HONE API.
 * Returns { status, body } or throws on network error.
 */
function apiPost(urlPath, payload) {
  var bodyStr = JSON.stringify(payload);
  return new Promise(function (resolve, reject) {
    var opts = {
      hostname: API_HOST, port: API_PORT, path: urlPath,
      method: "POST", timeout: 8000,
      headers: {
        "Content-Type": "application/json",
        "Content-Length": Buffer.byteLength(bodyStr)
      }
    };
    var req = http.request(opts, function (res) {
      var data = "";
      res.on("data", function (chunk) { data += chunk; });
      res.on("end", function () { resolve({ status: res.statusCode, body: data }); });
    });
    req.on("error", reject);
    req.on("timeout", function () { req.destroy(); reject(new Error("timeout")); });
    req.write(bodyStr);
    req.end();
  });
}

// ─── Hyfix authentication ────────────────────────────────────────

async function login() {
  try {
    var res = await httpPost(GNSS_HOST, GNSS_PORT, "/login", "mkey=" + MINER_KEY);
    if (res.status === 200 && res.body) {
      loginCookie = res.body.trim();
      log("authenticated with Hyfix");
      return true;
    }
    warn("login failed: " + res.status + " " + res.body);
    return false;
  } catch (e) {
    warn("login error: " + e.message);
    return false;
  }
}

// ─── Register sensor on HONE chain ─────────────────────────────

async function ensureSensorRegistered() {
  if (sensorRegistered) return;

  var spec = {
    type: "gps",
    unit: "gnss_correction",
    decimals: 8,
    region: "sv-san-salvador",
    hardware_model: "Hyfix MobileCM MCMv3",
    firmware_version: "MCMv3-2.2.1",
  };

  // Fast path: in-process sensorRegistry (only works inside main process)
  if (sensorRegistry) {
    try {
      var existing = sensorRegistry.getSensor(sensorId);
      if (existing) {
        sensorRegistered = true;
        log("sensor already registered (in-process): " + sensorId);
      } else {
        sensorRegistry.registerSensor(MINER_ACCOUNT, sensorId, spec);
        sensorRegistered = true;
        log("sensor registered in-process: " + sensorId);
      }
    } catch (e) {
      if (!/already/i.test(e.message)) {
        warn("in-process sensor registration failed: " + e.message);
      } else {
        sensorRegistered = true;
      }
    }
  }

  // Durable path: HTTP POST to local API (auto-registers if not found)
  // The readings endpoint auto-registers on first submission (not-found self-heal),
  // but we also try explicit registration here so metadata is set correctly.
  try {
    var payload = {
      account: MINER_ACCOUNT,
      name: "gnss-base",
      type: spec.type,
      unit: spec.unit,
      decimals: spec.decimals,
      region: spec.region,
      hardware_model: spec.hardware_model,
      firmware_version: spec.firmware_version,
    };
    var res = await apiPost("/api/sensors", payload);
    if (res.status === 201) {
      sensorRegistered = true;
      log("sensor registered via API: " + sensorId);
    } else if (res.status === 409) {
      // Already registered — that's fine
      sensorRegistered = true;
      log("sensor already registered on chain: " + sensorId);
    } else {
      warn("API sensor registration returned " + res.status + ": " + res.body.slice(0, 200));
    }
  } catch (e) {
    warn("API sensor registration failed (will retry on next reading): " + e.message);
  }
}

// ─── Poll device status ──────────────────────────────────────────

async function pollStatus() {
  try {
    if (!loginCookie) {
      var ok = await login();
      if (!ok) return null;
    }

    var res = await httpGet(GNSS_HOST, GNSS_PORT, "/devStatus", loginCookie);

    if (res.status === 401 || res.status === 403) {
      log("session expired, re-authenticating...");
      loginCookie = null;
      var ok2 = await login();
      if (!ok2) return null;
      res = await httpGet(GNSS_HOST, GNSS_PORT, "/devStatus", loginCookie);
    }

    if (res.status !== 200) {
      warn("devStatus returned " + res.status);
      return null;
    }

    try {
      return JSON.parse(res.body);
    } catch (e) {
      warn("invalid JSON from devStatus: " + res.body.slice(0, 100));
      return null;
    }
  } catch (e) {
    warn("poll error: " + e.message);
    return null;
  }
}

// ─── Submit reading to HONE chain ──────────────────────────────

async function submitReading(status) {
  readingCount++;

  var value = status.upDateRate ? parseFloat(status.upDateRate) : 0;
  var metadata = {
    ns_status: status.nsStatus,
    update_rate: parseFloat(status.upDateRate) || 0,
    gnss_data_rate: parseFloat(status.gnssDataRate) || 0,
    wifi_strength: parseInt(status.wifiStrength) || 0,
    uptime: status.uptime,
    gnss_type: status.gnss,
    firmware: status.fwVer,
    timestamp: status.ts,
    source: "hyfix-mobilecm",
  };

  log(
    "#" + readingCount +
    " status=" + status.nsStatus +
    " updateRate=" + status.upDateRate +
    " gnssRate=" + status.gnssDataRate +
    " wifi=" + status.wifiStrength + "dBm" +
    " uptime=" + status.uptime
  );

  // Fast path: in-process sensorRegistry (best-effort, may be a no-op in standalone mode)
  if (sensorRegistry) {
    try {
      sensorRegistry.submitReading(sensorId, value, metadata, readingCount);
    } catch (e) {
      // Duplicate reading for same epoch — that's fine
      if (!/already|duplicate/i.test(e.message)) {
        warn("in-process submit error: " + e.message);
      }
    }
  }

  // Durable path: HTTP POST to local HONE API
  // POST /api/sensors/:id/readings  body: { account, value, metadata }
  // The endpoint accepts body.account without requiring a JWT Bearer token.
  try {
    var apiPath = "/api/sensors/" + sensorIdEncoded + "/readings";
    var payload = {
      account: MINER_ACCOUNT,
      value: value,
      metadata: {
        type: "gps",
        unit: "gnss_correction",
        source: "hyfix-mobilecm",
        latitude: metadata.latitude,
        longitude: metadata.longitude,
        altitude: metadata.altitude,
        battery_pct: undefined,
        signal_strength_dbm: metadata.wifi_strength || undefined,
        gateway_id: undefined,
      },
    };
    var res = await apiPost(apiPath, payload);
    if (res.status === 201) {
      var parsed = {};
      try { parsed = JSON.parse(res.body); } catch (_) {}
      log("reading submitted to chain #" + readingCount +
        (parsed.auto_registered ? " (auto-registered sensor)" : ""));
    } else if (res.status === 200) {
      // Duplicate — same epoch already has a reading, that's fine
      log("reading already recorded for this epoch #" + readingCount + " (duplicate OK)");
    } else {
      warn("API reading submission returned " + res.status + ": " + res.body.slice(0, 300));
      // If sensor wasn't registered yet, reset the flag so we try again
      if (res.status === 422 || res.status === 404) {
        sensorRegistered = false;
      }
    }
  } catch (e) {
    warn("API reading submission failed: " + e.message +
      " (is hone-api running on port " + API_PORT + "?)");
  }

  // Legacy: also call ledger directly if available (belt-and-suspenders)
  if (ledger && typeof ledger.recordSensorReading === "function") {
    try {
      await ledger.recordSensorReading(sensorId, value, {
        ns_status: status.nsStatus,
        update_rate: parseFloat(status.upDateRate) || 0,
        gnss_data_rate: parseFloat(status.gnssDataRate) || 0,
        wifi_strength: parseInt(status.wifiStrength) || 0,
      }, readingCount);
    } catch (e) {
      // Ledger call is best-effort — HTTP path is the durable path
      if (!/duplicate|already/i.test(e.message)) {
        warn("ledger direct call failed (non-fatal): " + e.message);
      }
    }
  }
}

// ─── Main loop ──────────────────────────────────────────────────

async function main() {
  log("HONE GNSS Bridge — Hyfix MobileCM");
  log("device: " + GNSS_HOST + ":" + GNSS_PORT);
  log("account: " + MINER_ACCOUNT);
  log("sensor: " + sensorId);
  log("api: http://" + API_HOST + ":" + API_PORT);
  log("poll interval: " + (POLL_INTERVAL / 1000) + "s");
  log("");

  await ensureSensorRegistered();

  // Initial poll
  var status = await pollStatus();
  if (status) await submitReading(status);

  // Polling loop
  setInterval(async function () {
    // Re-attempt sensor registration if it failed previously
    if (!sensorRegistered) await ensureSensorRegistered();
    var s = await pollStatus();
    if (s) await submitReading(s);
  }, POLL_INTERVAL);
}

// Graceful shutdown
process.on("SIGINT", function () { log("shutdown"); process.exit(0); });
process.on("SIGTERM", function () { log("shutdown"); process.exit(0); });

main().catch(function (e) {
  console.error("[gnss-bridge] fatal: " + e.message);
  process.exit(1);
});
