#!/usr/bin/env node
"use strict";

/**
 * hone-meshtastic — Meshtastic Mesh Radio → HONE Chain Bridge
 * Shin Devlin
 *
 * Connects to a Meshtastic device via USB serial and relays HONE
 * sensor data from the mesh network to the HONE chain. Any Meshtastic
 * device on the "hone" channel can submit sensor readings and earn
 * relay fees from the IoT pool.
 *
 * Usage:
 *   node bin/hone-meshtastic [options]
 *
 * Options:
 *   --account <name>    HONE account name (relay operator)
 *   --port <dev>        serial port (default: auto-detect)
 *   --channel <name>    mesh channel name (default: hone)
 *   --node-url <url>    HONE node API base URL (default: http://localhost:4242)
 *   --dry-run           parse and log packets without submitting
 *
 * Environment:
 *   HONE_MESH_PORT     — serial port override (default: auto)
 *   HONE_MESH_CHANNEL  — channel name (default: hone)
 *   HONE_MINER         — HONE account to earn relay fees
 *   HONE_NODE_URL      — node API base URL
 *   HONE_AUTH_TOKEN    — optional auth token for API
 */

var path = require("path");
var fs = require("fs");
var http = require("http");
var https = require("https");
var { spawn } = require("child_process");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

// ─── Argument parsing ───────────────────────────────────────────

var args = process.argv.slice(2);

function getArg(flag, fallback) {
  var idx = args.indexOf(flag);
  if (idx !== -1 && args[idx + 1]) return args[idx + 1];
  return fallback;
}

function hasFlag(flag) {
  return args.indexOf(flag) !== -1;
}

var ACCOUNT     = getArg("--account", process.env.HONE_MINER || "");
var SERIAL_PORT = getArg("--port", process.env.HONE_MESH_PORT || "auto");
var CHANNEL     = getArg("--channel", process.env.HONE_MESH_CHANNEL || "hone");
var NODE_URL    = getArg("--node-url", process.env.HONE_NODE_URL || "http://localhost:4242");
var DRY_RUN     = hasFlag("--dry-run") || process.env.HONE_DRY_RUN === "1";
var AUTH_TOKEN  = process.env.HONE_AUTH_TOKEN || "";

var STATS_INTERVAL = 30000;
var RECONNECT_DELAY = 5000;

// ─── Optional chain services ────────────────────────────────────

var ledger, sensorRegistry;
try {
  ledger = require("../src/services/ledger");
  sensorRegistry = require("../src/services/sensorRegistry");
} catch (e) {
  // Running standalone without full HONE — API mode only
}

// ─── Stats ──────────────────────────────────────────────────────

var stats = {
  started: Date.now(),
  packetsReceived: 0,
  readingsSubmitted: 0,
  relayFeesEarned: 0,
  errors: 0,
  lastPacket: null,
  deviceConnected: false,
  devicePort: null,
  deviceBattery: null,
  deviceGps: null,
  deviceSignal: null,
};

function log(msg) { console.log("[meshtastic] " + msg); }
function warn(msg) { console.warn("[meshtastic] WARN: " + msg); stats.errors++; }

// ─── HTTP helpers ───────────────────────────────────────────────

function apiRequest(method, urlPath, body) {
  return new Promise(function (resolve, reject) {
    var url = new URL(urlPath, NODE_URL);
    var mod = url.protocol === "https:" ? https : http;
    var bodyStr = body ? JSON.stringify(body) : "";
    var headers = {
      "Content-Type": "application/json",
      "Content-Length": Buffer.byteLength(bodyStr),
    };
    if (AUTH_TOKEN) headers["Authorization"] = "Bearer " + AUTH_TOKEN;

    var req = mod.request({
      hostname: url.hostname,
      port: url.port || (url.protocol === "https:" ? 443 : 80),
      path: url.pathname + url.search,
      method: method,
      headers: headers,
      timeout: 10000,
    }, function (res) {
      var data = "";
      res.on("data", function (c) { data += c; });
      res.on("end", function () {
        try { resolve({ status: res.statusCode, body: JSON.parse(data) }); }
        catch (_) { resolve({ status: res.statusCode, body: data }); }
      });
    });
    req.on("error", reject);
    req.on("timeout", function () { req.destroy(new Error("request timeout")); });
    if (bodyStr) req.write(bodyStr);
    req.end();
  });
}

// ─── Serial port auto-detection ─────────────────────────────────

function detectSerialPort() {
  var candidates = [
    "/dev/ttyUSB0", "/dev/ttyUSB1",
    "/dev/ttyACM0", "/dev/ttyACM1",
    "/dev/serial/by-id",
  ];

  for (var i = 0; i < candidates.length; i++) {
    var dev = candidates[i];
    if (dev === "/dev/serial/by-id") {
      // Check for Meshtastic-specific serial devices
      try {
        var files = fs.readdirSync(dev);
        for (var j = 0; j < files.length; j++) {
          if (/meshtastic|cp210|ch340|esp32|t-beam|heltec/i.test(files[j])) {
            var resolved = fs.realpathSync(path.join(dev, files[j]));
            log("auto-detected Meshtastic device: " + resolved + " (" + files[j] + ")");
            return resolved;
          }
        }
      } catch (_) {}
      continue;
    }
    if (fs.existsSync(dev)) {
      log("auto-detected serial port: " + dev);
      return dev;
    }
  }

  return null;
}

// ─── Meshtastic channel setup ───────────────────────────────────

function ensureChannel(port) {
  return new Promise(function (resolve) {
    log("ensuring '" + CHANNEL + "' channel exists on device...");
    var portArg = port === "auto" ? "auto" : port;

    // Try to add the hone channel — if it already exists, meshtastic CLI
    // will return an error which we can safely ignore
    var proc = spawn("meshtastic", [
      "--port", portArg,
      "--ch-add", CHANNEL,
    ], { timeout: 15000 });

    var output = "";
    proc.stdout.on("data", function (d) { output += d.toString(); });
    proc.stderr.on("data", function (d) { output += d.toString(); });

    proc.on("close", function (code) {
      if (code === 0) {
        log("channel '" + CHANNEL + "' added to device");
      } else if (/already|exists|duplicate/i.test(output)) {
        log("channel '" + CHANNEL + "' already exists on device");
      } else {
        warn("channel setup returned code " + code + ": " + output.slice(0, 200));
        log("continuing anyway — channel may already be configured");
      }
      resolve();
    });

    proc.on("error", function (err) {
      warn("meshtastic CLI not found: " + err.message);
      log("install with: pip3 install meshtastic");
      log("continuing without channel setup — configure manually if needed");
      resolve();
    });
  });
}

// ─── Sensor registration ────────────────────────────────────────

var registeredSensors = {};

async function ensureSensorRegistered(sensorId, sensorType) {
  if (registeredSensors[sensorId]) return;

  if (sensorRegistry) {
    try {
      var existing = sensorRegistry.getSensor(sensorId);
      if (!existing) {
        sensorRegistry.registerSensor(ACCOUNT, sensorId, {
          type: sensorType || "mesh_relay",
          unit: "varies",
          decimals: 8,
          hardware_model: "meshtastic",
          relay_account: ACCOUNT,
        });
        if (ledger && typeof ledger.recordSensorRegister === "function") {
          await ledger.recordSensorRegister(ACCOUNT, sensorId, {
            type: sensorType || "mesh_relay",
            unit: "varies",
            hardware_model: "meshtastic",
          }, 0);
        }
      }
      registeredSensors[sensorId] = true;
      log("sensor registered: " + sensorId);
    } catch (e) {
      if (!/already/.test(e.message)) warn("sensor registration: " + e.message);
      registeredSensors[sensorId] = true;
    }
    return;
  }

  // Register via API
  if (DRY_RUN) { registeredSensors[sensorId] = true; return; }
  try {
    var encId = encodeURIComponent(sensorId);
    var resp = await apiRequest("POST", "/api/sensors/" + encId, {
      account: ACCOUNT,
      type: sensorType || "mesh_relay",
      unit: "varies",
      hardware_model: "meshtastic",
      relay_account: ACCOUNT,
    });
    if (resp.status === 201 || resp.status === 200 || resp.status === 409) {
      registeredSensors[sensorId] = true;
    }
  } catch (_) {}
}

// ─── Submit reading to chain ────────────────────────────────────

async function submitReading(sensorId, value, metadata) {
  stats.readingsSubmitted++;

  // Submit via direct registry if available
  if (sensorRegistry) {
    try {
      sensorRegistry.submitReading(sensorId, value, metadata, stats.readingsSubmitted);
    } catch (e) {
      if (!/already/.test(e.message)) warn("submit error: " + e.message);
    }
    if (ledger && typeof ledger.recordSensorReading === "function") {
      try {
        await ledger.recordSensorReading(sensorId, value, metadata, stats.readingsSubmitted);
      } catch (_) {}
    }
    return;
  }

  // Submit via API
  if (DRY_RUN) {
    log("DRY RUN reading: " + sensorId + " = " + value);
    return;
  }

  try {
    var encId = encodeURIComponent(sensorId);
    var resp = await apiRequest("POST", "/api/sensors/" + encId + "/readings", {
      account: sensorId.split("/")[0],
      value: value,
      metadata: metadata,
    });
    if (resp.status !== 201 && resp.status !== 200) {
      warn("reading submission failed for " + sensorId + ": HTTP " + resp.status);
    }
  } catch (e) {
    warn("reading error: " + e.message);
  }
}

// ─── Parse HONE mesh packet ────────────────────────────────────

function parseHonePacket(text) {
  // HONE packets are JSON with a "hone" field:
  // {"hone":1,"sensor":"josh/flipper-subghz","value":-92,"meta":{"freq":"433MHz"},"sig":"abc123"}
  try {
    var pkt = JSON.parse(text);
    if (pkt && pkt.hone === 1) return pkt;
  } catch (_) {}
  return null;
}

// ─── Process incoming mesh message ──────────────────────────────

async function processMessage(text, fromNode) {
  stats.packetsReceived++;
  stats.lastPacket = Date.now();

  var pkt = parseHonePacket(text);
  if (!pkt) {
    // Not a HONE packet — could be regular Meshtastic chat
    return;
  }

  var sensorId = pkt.sensor || (ACCOUNT + "/mesh-" + (fromNode || "unknown"));
  var value = typeof pkt.value === "number" ? pkt.value : 0;
  var metadata = Object.assign({}, pkt.meta || {}, {
    relay_account: ACCOUNT,
    relay_device: "meshtastic",
    mesh_node: fromNode || "unknown",
    mesh_channel: CHANNEL,
    signature: pkt.sig || null,
  });

  log("HONE packet: sensor=" + sensorId + " value=" + value +
      " from=" + (fromNode || "unknown"));

  await ensureSensorRegistered(sensorId, pkt.meta && pkt.meta.type || "mesh_relay");
  await submitReading(sensorId, value, metadata);

  // Track relay fee
  stats.relayFeesEarned++;
}

// ─── Meshtastic listener (via CLI --listen) ─────────────────────

var meshtasticProc = null;
var reconnecting = false;

function startListener(port) {
  var portArg = port === "auto" ? "auto" : port;
  stats.devicePort = portArg;
  stats.deviceConnected = false;

  log("starting Meshtastic listener on port " + portArg + "...");

  meshtasticProc = spawn("meshtastic", [
    "--port", portArg,
    "--listen",
  ], {
    stdio: ["ignore", "pipe", "pipe"],
  });

  var buffer = "";

  meshtasticProc.stdout.on("data", function (chunk) {
    stats.deviceConnected = true;
    buffer += chunk.toString();

    // Process complete lines
    var lines = buffer.split("\n");
    buffer = lines.pop(); // keep incomplete line in buffer

    for (var i = 0; i < lines.length; i++) {
      var line = lines[i].trim();
      if (!line) continue;
      parseMeshtasticLine(line);
    }
  });

  meshtasticProc.stderr.on("data", function (chunk) {
    var msg = chunk.toString().trim();
    if (msg) {
      // Filter out noise
      if (/connected|listening|channel/i.test(msg)) {
        log(msg);
        stats.deviceConnected = true;
      } else if (/error|fail|disconnect/i.test(msg)) {
        warn(msg);
      }
    }
  });

  meshtasticProc.on("close", function (code) {
    stats.deviceConnected = false;
    if (code !== 0 && code !== null) {
      warn("meshtastic process exited with code " + code);
    } else {
      log("meshtastic process exited");
    }

    // Auto-reconnect
    if (!reconnecting) {
      reconnecting = true;
      log("reconnecting in " + (RECONNECT_DELAY / 1000) + "s...");
      setTimeout(function () {
        reconnecting = false;
        startListener(port);
      }, RECONNECT_DELAY);
    }
  });

  meshtasticProc.on("error", function (err) {
    stats.deviceConnected = false;
    warn("failed to start meshtastic CLI: " + err.message);
    log("install with: pip3 install meshtastic");
    log("reconnecting in " + (RECONNECT_DELAY / 1000) + "s...");
    if (!reconnecting) {
      reconnecting = true;
      setTimeout(function () {
        reconnecting = false;
        startListener(port);
      }, RECONNECT_DELAY);
    }
  });
}

// ─── Parse Meshtastic CLI output lines ──────────────────────────

function parseMeshtasticLine(line) {
  // Meshtastic --listen output looks like:
  //   From <nodeId>: <message text>
  //   or position/telemetry data
  //   or channel info

  // Text message from a node
  var textMatch = line.match(/^(?:From\s+)?([!\w]+)(?:\s*\(.*?\))?:\s*(.+)$/i);
  if (textMatch) {
    var fromNode = textMatch[1];
    var text = textMatch[2].trim();
    processMessage(text, fromNode).catch(function (e) {
      warn("process error: " + e.message);
    });
    return;
  }

  // Position update — extract GPS data for device tracking
  var posMatch = line.match(/position.*?lat[itude]*[=:]\s*([-\d.]+).*?lo?ng?[itude]*[=:]\s*([-\d.]+)/i);
  if (posMatch) {
    stats.deviceGps = {
      latitude: parseFloat(posMatch[1]),
      longitude: parseFloat(posMatch[2]),
    };
    return;
  }

  // Battery telemetry
  var batMatch = line.match(/batter[y]?[=:]\s*([\d.]+)/i);
  if (batMatch) {
    stats.deviceBattery = parseFloat(batMatch[1]);
    return;
  }

  // Signal/SNR
  var snrMatch = line.match(/snr[=:]\s*([-\d.]+)/i);
  if (snrMatch) {
    stats.deviceSignal = parseFloat(snrMatch[1]);
    return;
  }
}

// ─── Own device sensor reporting ────────────────────────────────

var ownReadingCount = 0;

async function reportOwnSensors() {
  if (!ACCOUNT) return;

  ownReadingCount++;
  var base = ACCOUNT + "/meshtastic-";

  // Report GPS if available
  if (stats.deviceGps) {
    await ensureSensorRegistered(base + "gps", "gps");
    await submitReading(base + "gps", stats.deviceGps.latitude, {
      type: "gps",
      unit: "degrees",
      longitude: stats.deviceGps.longitude,
      source: "meshtastic",
      reading_number: ownReadingCount,
    });
  }

  // Report battery if available
  if (stats.deviceBattery !== null) {
    await ensureSensorRegistered(base + "battery", "power");
    await submitReading(base + "battery", stats.deviceBattery, {
      type: "power",
      unit: "percent",
      source: "meshtastic",
      reading_number: ownReadingCount,
    });
  }

  // Report signal strength if available
  if (stats.deviceSignal !== null) {
    await ensureSensorRegistered(base + "signal", "power");
    await submitReading(base + "signal", stats.deviceSignal, {
      type: "power",
      unit: "dB_snr",
      source: "meshtastic",
      reading_number: ownReadingCount,
    });
  }

  // Report relay stats as a meta-sensor
  await ensureSensorRegistered(base + "relay-stats", "custom");
  await submitReading(base + "relay-stats", stats.packetsReceived, {
    type: "custom",
    unit: "packets",
    source: "meshtastic",
    readings_submitted: stats.readingsSubmitted,
    relay_fees_earned: stats.relayFeesEarned,
    errors: stats.errors,
    uptime_seconds: Math.round((Date.now() - stats.started) / 1000),
    connected: stats.deviceConnected,
    reading_number: ownReadingCount,
  });
}

// ─── Stats logging ──────────────────────────────────────────────

function logStats() {
  var uptime = Math.round((Date.now() - stats.started) / 1000);
  var uptimeStr = Math.floor(uptime / 3600) + "h " +
                  Math.floor((uptime % 3600) / 60) + "m " +
                  (uptime % 60) + "s";

  log("--- stats ---");
  log("  uptime: " + uptimeStr);
  log("  connected: " + (stats.deviceConnected ? "yes" : "no") +
      " (port: " + (stats.devicePort || "none") + ")");
  log("  packets received: " + stats.packetsReceived);
  log("  readings submitted: " + stats.readingsSubmitted);
  log("  relay fees earned: " + stats.relayFeesEarned);
  log("  errors: " + stats.errors);
  if (stats.deviceBattery !== null) log("  battery: " + stats.deviceBattery + "%");
  if (stats.deviceGps) log("  gps: " + stats.deviceGps.latitude + ", " + stats.deviceGps.longitude);
  if (stats.deviceSignal !== null) log("  signal snr: " + stats.deviceSignal + " dB");
  if (stats.lastPacket) log("  last packet: " + new Date(stats.lastPacket).toISOString());
  log("-------------");
}

// ─── Main ───────────────────────────────────────────────────────

async function main() {
  log("HONE Meshtastic Bridge");
  log("  account: " + (ACCOUNT || "(not set)"));
  log("  channel: " + CHANNEL);
  log("  node: " + NODE_URL);
  log("  dry-run: " + (DRY_RUN ? "yes" : "no"));
  log("");

  if (!ACCOUNT) {
    console.error("[meshtastic] ERROR: --account <hone-username> is required");
    console.error("[meshtastic] Run: node bin/hone-meshtastic --account <name>");
    console.error("[meshtastic] Or set HONE_MINER in your .env file");
    process.exit(1);
  }

  // Auto-detect serial port
  var port = SERIAL_PORT;
  if (port === "auto") {
    var detected = detectSerialPort();
    if (detected) {
      port = detected;
    } else {
      log("no Meshtastic device detected on USB — will let CLI auto-detect");
      port = "auto";
    }
  }

  // Set up the HONE channel on the device
  await ensureChannel(port);

  // Register the relay gateway sensor
  var relaySensorId = ACCOUNT + "/meshtastic-relay-stats";
  await ensureSensorRegistered(relaySensorId, "gateway");

  // Start listening for mesh packets
  startListener(port);

  // Periodic stats logging + own sensor reporting
  setInterval(function () {
    logStats();
    reportOwnSensors().catch(function (e) {
      warn("own sensor report error: " + e.message);
    });
  }, STATS_INTERVAL);
}

// Graceful shutdown
process.on("SIGINT", function () {
  log("shutting down...");
  if (meshtasticProc) meshtasticProc.kill("SIGTERM");
  process.exit(0);
});
process.on("SIGTERM", function () {
  log("shutting down...");
  if (meshtasticProc) meshtasticProc.kill("SIGTERM");
  process.exit(0);
});

main().catch(function (e) {
  console.error("[meshtastic] fatal: " + e.message);
  process.exit(1);
});
