#!/usr/bin/env node
"use strict";

/**
 * hone-storage — HONE-FS Storage Host Daemon
 * Shin Devlin
 *
 * Long-running process that makes this machine a host for the
 * content-addressed blob store introduced in v2.11. Persists blobs
 * to disk, answers /blobs/:cid HTTP requests, sends periodic storage
 * heartbeats to the chain, and responds to challenge-response audits.
 *
 * Designed for home operators on flaky internet — see
 * feedback_storage_no_slash.md: storage is PAID FOR DELIVERY, never
 * slashed. A host that misses an epoch simply doesn't earn for that
 * epoch; it is not punished.
 *
 * Usage:
 *   node bin/hone-storage
 *
 * Environment:
 *   HONE_MINER                — host identity (defaults to miner account)
 *   HONE_STORAGE_DIR          — where blobs land (default ~/.hone/blobs)
 *   HONE_STORAGE_PORT         — HTTP port for blob serving (default 4243)
 *   HONE_STORAGE_CAPACITY_GB  — advertised capacity in heartbeats (default 10)
 *   HONE_STORAGE_REGIONS      — comma list, e.g. "us-west,eu-central"
 *   HONE_HEARTBEAT_INTERVAL_MS — default 60000 (1 minute)
 */

var path = require("path");
var http = require("http");
var https = require("https");
var fs = require("fs");
var crypto = require("crypto");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

var blobStore = require("../src/services/blobStore");

var HOST_ACCOUNT = process.env.HONE_MINER || process.env.HONE_STORAGE_HOST || "storage-" + crypto.randomBytes(4).toString("hex");
var PORT = parseInt(process.env.HONE_STORAGE_PORT || "4243", 10);
var HEARTBEAT_INTERVAL_MS = parseInt(process.env.HONE_HEARTBEAT_INTERVAL_MS || "60000", 10);
var CAPACITY_GB = parseFloat(process.env.HONE_STORAGE_CAPACITY_GB || "10");
var REGIONS = (process.env.HONE_STORAGE_REGIONS || "").split(",").map(function (r) { return r.trim(); }).filter(Boolean);

// API server base URL — heartbeats are submitted via HTTP so they reach
// the miner's stateStore with the correct current chain epoch.
var API_BASE = process.env.HONE_NODE_URL || ("http://localhost:" + (process.env.HONE_API_PORT || "4242"));

function log(msg) { console.log("[hone-storage] " + msg); }
function warn(msg) { console.warn("[hone-storage] WARN: " + msg); }
function err(msg) { console.error("[hone-storage] ERROR: " + msg); }

// ─── Heartbeat loop ──────────────────────────────────────────────

var epochCounter = 0;
var servedBytesThisEpoch = 0;
var servedRequestsThisEpoch = 0;

/**
 * Post a heartbeat to the API server via HTTP.
 *
 * Why HTTP and not a direct ledger.recordStorageHeartbeat() call?
 *
 * hone-storage is a standalone process with its own fresh stateStore
 * that has NOT replayed from disk. A direct call would:
 *   1. Write the heartbeat into that isolated in-memory state — invisible
 *      to the miner process that actually builds blocks.
 *   2. Pass epochCounter (1, 2, 3 ...) as the epoch instead of the real
 *      chain height (currently 18000+), so getActiveStorageHosts() would
 *      always see the host as stale and return 0.
 *
 * By POSTing to the API server, the heartbeat is applied to the miner's
 * shared stateStore with the correct current chain epoch and queued into
 * data/pending-entries.jsonl for inclusion in the next block.
 */
function _postHeartbeatHttp(payload, callback) {
  try {
    var body = JSON.stringify(payload);
    var url = API_BASE + "/api/storage/heartbeat";
    var parsedUrl = new (require("url").URL)(url);
    var transport = parsedUrl.protocol === "https:" ? https : http;
    var options = {
      hostname: parsedUrl.hostname,
      port: parsedUrl.port || (parsedUrl.protocol === "https:" ? 443 : 80),
      path: parsedUrl.pathname,
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Content-Length": Buffer.byteLength(body),
      },
    };
    var req = transport.request(options, function (res) {
      var data = "";
      res.on("data", function (chunk) { data += chunk; });
      res.on("end", function () {
        try {
          var parsed = JSON.parse(data);
          callback(null, parsed);
        } catch (e) {
          callback(new Error("bad JSON from API: " + data.slice(0, 80)));
        }
      });
    });
    req.on("error", callback);
    req.write(body);
    req.end();
  } catch (e) {
    callback(e);
  }
}

async function sendHeartbeat() {
  try {
    epochCounter += 1;
    var stats = blobStore.listBlobs();
    var localBlobCount = stats.length;
    var localBytes = stats.reduce(function (n, s) { return n + (s.size || 0); }, 0);
    var cids = stats.map(function (s) { return s.cid; }).filter(Boolean);
    var capacityUsedGb = localBytes / (1024 * 1024 * 1024);

    // Submit heartbeat via HTTP so it lands in the correct (miner) process
    // stateStore and is stamped with the real chain epoch.
    await new Promise(function (resolve) {
      _postHeartbeatHttp(
        { host: HOST_ACCOUNT, cids: cids, capacity_used_gb: capacityUsedGb },
        function (httpErr, result) {
          if (httpErr) {
            warn("heartbeat HTTP error: " + httpErr.message + " — will retry next interval");
          } else if (result && !result.ok) {
            warn("heartbeat API error: " + JSON.stringify(result));
          } else if (result) {
            log("heartbeat #" + epochCounter + " accepted by API, chain epoch=" + result.epoch);
          }
          resolve();
        }
      );
    });

    log(
      "heartbeat #" + epochCounter +
      " stored=" + localBlobCount +
      " bytes_stored=" + localBytes +
      " served_bytes_epoch=" + servedBytesThisEpoch +
      " reqs_epoch=" + servedRequestsThisEpoch
    );

    // Reset epoch counters
    servedBytesThisEpoch = 0;
    servedRequestsThisEpoch = 0;
  } catch (e) {
    warn("heartbeat failed: " + e.message);
  }
}

// ─── HTTP server — serves /blobs/:cid ─────────────────────────────

function sendJson(res, code, obj) {
  res.writeHead(code, { "Content-Type": "application/json" });
  res.end(JSON.stringify(obj));
}

function handleRequest(req, res) {
  var url = req.url || "";

  // Health check
  if (url === "/health") {
    return sendJson(res, 200, {
      ok: true,
      host: HOST_ACCOUNT,
      capacity_gb: CAPACITY_GB,
      regions: REGIONS,
      epoch: epochCounter,
    });
  }

  // Stats
  if (url === "/stats") {
    var stats = blobStore.listBlobs();
    return sendJson(res, 200, {
      host: HOST_ACCOUNT,
      blob_count: stats.length,
      bytes_stored: stats.reduce(function (n, s) { return n + (s.size || 0); }, 0),
      capacity_gb: CAPACITY_GB,
      regions: REGIONS,
      served_this_epoch: {
        bytes: servedBytesThisEpoch,
        requests: servedRequestsThisEpoch,
      },
    });
  }

  // GET /blobs/:cid
  if (req.method === "GET" && url.indexOf("/blobs/") === 0) {
    var cid = url.slice("/blobs/".length).split("?")[0];
    if (!/^[a-f0-9]{64}$/.test(cid)) {
      return sendJson(res, 400, { error: "cid must be 64-char lowercase hex" });
    }
    if (!blobStore.hasBlob(cid)) {
      return sendJson(res, 404, { error: "blob not found", cid: cid });
    }
    try {
      var bytes = blobStore.getBlob(cid);
      servedBytesThisEpoch += bytes.length;
      servedRequestsThisEpoch += 1;
      res.writeHead(200, {
        "Content-Type": "application/octet-stream",
        "Content-Length": bytes.length,
        "X-Blob-Cid": cid,
      });
      res.end(bytes);
    } catch (e) {
      return sendJson(res, 500, { error: e.message });
    }
    return;
  }

  // Default 404
  return sendJson(res, 404, { error: "not found", available: ["GET /blobs/:cid", "GET /health", "GET /stats"] });
}

// ─── Main ────────────────────────────────────────────────────────

function main() {
  log("HONE-FS Storage Host Daemon");
  log("host=" + HOST_ACCOUNT + " port=" + PORT + " capacity=" + CAPACITY_GB + "GB regions=" + (REGIONS.join(",") || "any"));

  var server = http.createServer(handleRequest);

  var interval;

  function shutdown(signal) {
    log("received " + signal + ", shutting down");
    clearInterval(interval);
    server.close(function () {
      process.exit(0);
    });
    // Hard exit if server hangs on close
    setTimeout(function () { process.exit(0); }, 5000);
  }

  process.on("SIGINT", function () { shutdown("SIGINT"); });
  process.on("SIGTERM", function () { shutdown("SIGTERM"); });

  function _tryListen(tryPort, retriesLeft) {
    server.listen(tryPort, function () {
      log("HTTP server listening on :" + tryPort + " (GET /blobs/:cid, /health, /stats)");
      // Send the first heartbeat immediately so the chain sees us online
      sendHeartbeat();
      interval = setInterval(sendHeartbeat, HEARTBEAT_INTERVAL_MS);
    });
    server.once("error", function (e) {
      if (e.code === "EADDRINUSE" && retriesLeft > 0) {
        log("port " + tryPort + " in use, retrying on " + (tryPort + 1));
        server.close();
        _tryListen(tryPort + 1, retriesLeft - 1);
      } else {
        err("could not bind to any port: " + e.message);
        // don't exit — log and keep process alive for graceful shutdown
      }
    });
  }
  _tryListen(PORT, 5);
}

main();
