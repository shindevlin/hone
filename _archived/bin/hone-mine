#!/usr/bin/env node
/**
 * HONE Mining Daemon
 *
 * Connects to Ollama for inference-based mining. MongoDB is optional
 * (Phase F) — chain state lives in stateStore; Mongo is only used for
 * inference job tracking when available.
 *
 * Usage:
 *   node bin/hone-mine
 *   ./bin/hone-mine
 *
 * Environment:
 *   MONGODB_URI          - MongoDB connection string (optional, Phase F)
 *   HONE_MONGO_MODE     - Set to "disabled" to skip Mongo entirely
 *   OLLAMA_URL           - Ollama API endpoint (default: http://100.122.145.60:11434)
 *   HONE_MODEL          - Model to use for inference (default: qwen3.5:27b)
 *   HONE_WORK_PER_EPOCH - Number of inference tasks per epoch (default: 3)
 */

"use strict";

const path = require('path');

// Load environment variables from project root
require('dotenv').config({ path: path.resolve(__dirname, '..', '.env') });

// Force WebSocket P2P so INFERENCE_REVEAL broadcasts reach the clock via relay
process.env.HONE_USE_RUST_P2P = 'false';

const mongoose = require('mongoose');
const { startMiner, stopMiner } = require('../src/mining/miner');

const MONGODB_URI = process.env.MONGODB_URI || '';

// Phase F: mongoEnabled flag — downstream inference job tracking checks this
let mongoEnabled = false;

async function connectMongo() {
  const mongoMode = (process.env.HONE_MONGO_MODE || '').toLowerCase();
  if (mongoMode !== 'enabled') {
    // Not explicitly enabled — disable Mongoose buffering so any accidental
    // model calls fail immediately instead of hanging for 10s then crashing.
    mongoose.set('bufferCommands', false);
    if (mongoMode === 'disabled') {
      console.log('[HONE] MongoDB: DISABLED via HONE_MONGO_MODE=disabled');
    } else {
      console.log('[HONE] MongoDB: not enabled (set HONE_MONGO_MODE=enabled to use)');
    }
    return;
  }
  if (!MONGODB_URI) {
    mongoose.set('bufferCommands', false);
    console.warn('[HONE] MongoDB: HONE_MONGO_MODE=enabled but MONGODB_URI not set — falling back to stateStore');
    return;
  }
  try {
    await mongoose.connect(MONGODB_URI, { serverSelectionTimeoutMS: 3000 });
    mongoEnabled = true;
    console.log('[HONE] MongoDB: enabled and connected');
  } catch (err) {
    mongoose.set('bufferCommands', false);
    console.warn(`[HONE] MongoDB: unreachable — falling back to stateStore (${err.message})`);
  }
}

async function main() {
  const ts = new Date().toISOString();
  console.log(`[HONE] ${ts} -- HONE Mining Daemon`);

  await connectMongo();

  // Graceful shutdown
  const shutdown = async (signal) => {
    console.log(`\n[HONE] Received ${signal}, shutting down...`);
    stopMiner();
    if (mongoEnabled) {
      await mongoose.connection.close();
    }
    console.log('[HONE] Shutdown complete');
    process.exit(0);
  };

  process.on('SIGINT', () => shutdown('SIGINT'));
  process.on('SIGTERM', () => shutdown('SIGTERM'));

  // Start mining
  await startMiner();

  // Keep the process alive — inference jobs run in the background
  // and complete in future epochs. Without this, Node exits after
  // startMiner() returns because no timers/sockets hold the event loop.
  setInterval(() => {}, 60000);
}

main().catch(err => {
  console.error(`[HONE] Fatal error: ${err.message}`);
  console.error(err.stack);
  process.exit(1);
});
