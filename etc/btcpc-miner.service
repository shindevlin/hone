[Unit]
Description=BTCPC Inference Miner
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntclaw/repos/btcpc
ExecStart=/usr/bin/node bin/btcpc-mine
Restart=on-failure
RestartSec=30
Environment=NODE_ENV=production
Environment=P2P_PORT=6942
EnvironmentFile=/home/ubuntclaw/repos/btcpc/.env

[Install]
WantedBy=default.target
