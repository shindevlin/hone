[Unit]
Description=BTCPC HTTP API + Inference Server
After=network-online.target btcpc-miner.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntclaw/repos/btcpc
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=10
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntclaw/repos/btcpc/.env
Environment=PORT=4242
Environment=P2P_PORT=6944
Environment=BTCPC_EPOCH_ENABLED=false

[Install]
WantedBy=default.target
