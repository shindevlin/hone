App(
    appid="btcpc_relay",
    name="BTCPC Relay",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="btcpc_relay_app",
    requires=["gui", "storage"],
    sources=["btcpc_relay.c", "sha256.c"],
    stack_size=2 * 1024,
    fap_category="BTCPC",
    fap_description="Announces BLE MAC over USB CDC for auto-pairing with the BTCPC Android app",
    fap_author="Shin Devlin / btcpc.network",
    fap_version="1.2",
)
