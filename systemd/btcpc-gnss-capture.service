[Unit]
Description=BTCPC GNSS Capture — Rust RTCM3 interceptor + chain recorder
After=network-online.target btcpc-api.service
Wants=network-online.target
Before=btcpc-miner.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntclaw/repos/btcpc
ExecStart=/usr/local/bin/btcpc-gnss-capture
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/ubuntclaw/repos/btcpc/.env
# Real-time priority — GC pauses no longer a concern (Rust), but still keep it elevated
Nice=-10
LimitRTPRIO=10

[Install]
WantedBy=multi-user.target
