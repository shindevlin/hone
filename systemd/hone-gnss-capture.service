[Unit]
Description=HONE GNSS Capture — Rust RTCM3 interceptor + chain recorder
After=network-online.target hone-api.service
Wants=network-online.target
Before=hone-miner.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntclaw/repos/hone
ExecStart=/usr/local/bin/hone-gnss-capture
# License gate: HONE will not start until its license (UFL 3.8, Operational
# Scope: Decentralized) is accepted, and exits with status 3 until then.
# Either run `hone-license accept` once as this service's user with the same
# HONE_DATA_DIR, or uncomment the next line. Uncommenting it is the act of
# accepting the license. See docs/LICENSE_ACCEPTANCE.md.
# Environment="HONE_ACCEPT_LICENSE=UFL-3.8-D"
RestartPreventExitStatus=3
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/ubuntclaw/repos/hone/.env
# Real-time priority — GC pauses no longer a concern (Rust), but still keep it elevated
Nice=-10
LimitRTPRIO=10

[Install]
WantedBy=multi-user.target
