[Unit]
Description=BTCPC Clock Node — Epoch Timing (Rust node, clock role)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/repos/btcpc/rust/btcpc-node
ExecStart=%h/repos/btcpc/rust/btcpc-node/target/release/btcpc-node
Restart=always
RestartSec=5

Environment=BTCPC_MINER=false
Environment=BTCPC_CLOCK=true
Environment=BTCPC_DATA_DIR=%h/.btcpc
Environment=BTCPC_API_PORT=4242
Environment=BTCPC_P2P_PORT=6942
Environment=BTCPC_GENESIS_FILE=%h/repos/btcpc/rust/btcpc-node/genesis.json
Environment=BTCPC_LOG_LEVEL=btcpc_node=info
EnvironmentFile=-%h/repos/btcpc/.env

[Install]
WantedBy=default.target
