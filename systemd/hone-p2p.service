[Unit]
Description=HONE P2P Sidecar — rust-libp2p with Kademlia DHT
After=network-online.target
Wants=network-online.target
Before=hone-miner.service hone-api.service

[Service]
Type=simple
User=ubuntclaw
WorkingDirectory=/home/ubuntclaw/repos/hone
ExecStart=/home/ubuntclaw/repos/hone-p2p/target/release/hone-p2p
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/ubuntclaw/repos/hone/.env
# Dual-stack port: sidecar uses 6945 while Node.js P2P still owns 6942.
# Remove this line after HONE_USE_RUST_P2P=true is permanent.
Environment=HONE_P2P_SIDECAR_PORT=6945

[Install]
WantedBy=multi-user.target
