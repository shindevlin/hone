[Unit]
Description=BetChu Bot — HONE-native P2P sports betting (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/repos/betchu_bot
ExecStart=%h/repos/hone/rust/betchu-bot/target/release/betchu-bot
# License gate: HONE will not start until its license (UFL 3.4, Operational
# Scope: Decentralized) is accepted, and exits with status 3 until then.
# Either run `hone-license accept` once as this service's user with the same
# HONE_DATA_DIR, or uncomment the next line. Uncommenting it is the act of
# accepting the license. See docs/LICENSE_ACCEPTANCE.md.
# Environment="HONE_ACCEPT_LICENSE=UFL-3.4-D"
RestartPreventExitStatus=3
Restart=always
RestartSec=10

# Load HONE inference credentials first, then betchu-specific env
EnvironmentFile=-%h/repos/betchu_bot/.envhone
EnvironmentFile=-%h/repos/betchu_bot/.env

# Service health port (HONE compliance)
Environment=SERVICE_PORT=8765

[Install]
WantedBy=default.target
