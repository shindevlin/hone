[Unit]
Description=HONE Miner — Proof of Compute (Rust node, miner role)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/repos/hone/rust/hone-node
ExecStart=%h/repos/hone/rust/hone-node/target/release/hone-node
# License gate: HONE will not start until its license (UFL 3.4, Operational
# Scope: Decentralized) is accepted, and exits with status 3 until then.
# Either run `hone-license accept` once as this service's user with the same
# HONE_DATA_DIR, or uncomment the next line. Uncommenting it is the act of
# accepting the license. See docs/LICENSE_ACCEPTANCE.md.
# Environment="HONE_ACCEPT_LICENSE=UFL-3.4-D"
RestartPreventExitStatus=3
Restart=always
RestartSec=10

Environment=HONE_MINER=true
Environment=HONE_CLOCK=false
Environment=HONE_DATA_DIR=%h/.hone
Environment=HONE_API_PORT=4242
Environment=HONE_P2P_PORT=6942
Environment=HONE_GENESIS_FILE=%h/repos/hone/rust/hone-node/genesis.json
Environment=HONE_LOG_LEVEL=hone_node=info
EnvironmentFile=-%h/repos/hone/.env

CPUQuota=80%
MemoryMax=80%

[Install]
WantedBy=default.target
