[Unit]
Description=BTCPC P2P Sidecar — rust-libp2p with Kademlia DHT
After=network-online.target
Wants=network-online.target
Before=btcpc-miner.service btcpc-api.service

[Service]
Type=simple
User=ubuntclaw
WorkingDirectory=/home/ubuntclaw/repos/btcpc
ExecStart=/home/ubuntclaw/repos/btcpc-p2p/target/release/btcpc-p2p
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/ubuntclaw/repos/btcpc/.env
# Dual-stack port: sidecar uses 6945 while Node.js P2P still owns 6942.
# Remove this line after BTCPC_USE_RUST_P2P=true is permanent.
Environment=BTCPC_P2P_SIDECAR_PORT=6945

[Install]
WantedBy=multi-user.target
