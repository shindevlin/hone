#!/usr/bin/env node
"use strict";

/**
 * btcpc-gnss-bridge — Hyfix GNSS Base Station → BTCPC Chain Bridge
 * Shin Devlin
 *
 * Polls a Hyfix MobileCM device on the local network and submits
 * GNSS correction data as sensor readings to the BTCPC chain.
 * The device earns IoT rewards for every epoch it reports data.
 *
 * Usage:
 *   node bin/btcpc-gnss-bridge
 *
 * Environment:
 *   BTCPC_GNSS_HOST      — IP of the Hyfix device (default: auto-discover)
 *   BTCPC_GNSS_MINER_KEY — the miner key set during Hyfix setup
 *   BTCPC_GNSS_INTERVAL  — poll interval in ms (default: 30000)
 *   BTCPC_MINER          — BTCPC account to earn rewards
 */

var path = require("path");
var http = require("http");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

var GNSS_HOST = process.env.BTCPC_GNSS_HOST || "192.168.68.54";
var GNSS_PORT = 80;
var MINER_KEY = process.env.BTCPC_GNSS_MINER_KEY || "btcpcshin2026";
var POLL_INTERVAL = parseInt(process.env.BTCPC_GNSS_INTERVAL) || 30000;
var MINER_ACCOUNT = process.env.BTCPC_MINER || "shindevlin";

var ledger, stateStore, sensorRegistry;
try {
  ledger = require("../src/services/ledger");
  stateStore = require("../src/chain/stateStore");
  sensorRegistry = require("../src/services/sensorRegistry");
} catch (e) {
  // Running standalone without full BTCPC — just log data
}

var loginCookie = null;
var sensorRegistered = false;
var readingCount = 0;
var sensorId = MINER_ACCOUNT + "/gnss-base";

function log(msg) { console.log("[gnss-bridge] " + msg); }
function warn(msg) { console.warn("[gnss-bridge] WARN: " + msg); }

// ─── HTTP helpers ────────────────────────────────────────────────

function httpGet(host, port, path, cookie) {
  return new Promise(function (resolve, reject) {
    var opts = {
      hostname: host, port: port, path: path,
      method: "GET", timeout: 5000,
      headers: cookie ? { Cookie: "USER=" + cookie } : {}
    };
    var req = http.request(opts, function (res) {
      var data = "";
      res.on("data", function (chunk) { data += chunk; });
      res.on("end", function () { resolve({ status: res.statusCode, body: data }); });
    });
    req.on("error", reject);
    req.on("timeout", function () { req.destroy(); reject(new Error("timeout")); });
    req.end();
  });
}

function httpPost(host, port, path, body, contentType) {
  return new Promise(function (resolve, reject) {
    var opts = {
      hostname: host, port: port, path: path,
      method: "POST", timeout: 5000,
      headers: {
        "Content-Type": contentType || "application/x-www-form-urlencoded",
        "Content-Length": Buffer.byteLength(body)
      }
    };
    var req = http.request(opts, function (res) {
      var data = "";
      res.on("data", function (chunk) { data += chunk; });
      res.on("end", function () { resolve({ status: res.statusCode, body: data }); });
    });
    req.on("error", reject);
    req.on("timeout", function () { req.destroy(); reject(new Error("timeout")); });
    req.write(body);
    req.end();
  });
}

// ─── Hyfix authentication ────────────────────────────────────────

async function login() {
  try {
    var res = await httpPost(GNSS_HOST, GNSS_PORT, "/login", "mkey=" + MINER_KEY);
    if (res.status === 200 && res.body) {
      loginCookie = res.body.trim();
      log("authenticated with Hyfix");
      return true;
    }
    warn("login failed: " + res.status + " " + res.body);
    return false;
  } catch (e) {
    warn("login error: " + e.message);
    return false;
  }
}

// ─── Register sensor on BTCPC chain ─────────────────────────────

async function ensureSensorRegistered() {
  if (sensorRegistered) return;
  if (!sensorRegistry) return;

  try {
    var existing = sensorRegistry.getSensor(sensorId);
    if (existing) {
      sensorRegistered = true;
      log("sensor already registered: " + sensorId);
      return;
    }

    sensorRegistry.registerSensor(MINER_ACCOUNT, sensorId, {
      type: "gps",
      unit: "gnss_correction",
      decimals: 8,
      region: "sv-san-salvador",
      hardware_model: "Hyfix MobileCM MCMv3",
      firmware_version: "MCMv3-2.2.1",
    });

    // Also record on chain via ledger if available
    if (ledger && typeof ledger.recordSensorRegister === "function") {
      await ledger.recordSensorRegister(MINER_ACCOUNT, sensorId, {
        type: "gps",
        unit: "gnss_correction",
        decimals: 8,
        region: "sv-san-salvador",
        hardware_model: "Hyfix MobileCM MCMv3",
      }, 0);
    }

    sensorRegistered = true;
    log("sensor registered on chain: " + sensorId);
  } catch (e) {
    warn("sensor registration failed: " + e.message);
  }
}

// ─── Poll device status ──────────────────────────────────────────

async function pollStatus() {
  try {
    if (!loginCookie) {
      var ok = await login();
      if (!ok) return null;
    }

    var res = await httpGet(GNSS_HOST, GNSS_PORT, "/devStatus", loginCookie);

    if (res.status === 401 || res.status === 403) {
      log("session expired, re-authenticating...");
      loginCookie = null;
      var ok2 = await login();
      if (!ok2) return null;
      res = await httpGet(GNSS_HOST, GNSS_PORT, "/devStatus", loginCookie);
    }

    if (res.status !== 200) {
      warn("devStatus returned " + res.status);
      return null;
    }

    try {
      return JSON.parse(res.body);
    } catch (e) {
      warn("invalid JSON from devStatus: " + res.body.slice(0, 100));
      return null;
    }
  } catch (e) {
    warn("poll error: " + e.message);
    return null;
  }
}

// ─── Submit reading to BTCPC chain ──────────────────────────────

async function submitReading(status) {
  readingCount++;

  var value = status.upDateRate ? parseFloat(status.upDateRate) : 0;

  log(
    "#" + readingCount +
    " status=" + status.nsStatus +
    " updateRate=" + status.upDateRate +
    " gnssRate=" + status.gnssDataRate +
    " wifi=" + status.wifiStrength + "dBm" +
    " uptime=" + status.uptime
  );

  // Submit to sensor registry
  if (sensorRegistry) {
    try {
      sensorRegistry.submitReading(sensorId, value, {
        ns_status: status.nsStatus,
        update_rate: parseFloat(status.upDateRate) || 0,
        gnss_data_rate: parseFloat(status.gnssDataRate) || 0,
        wifi_strength: parseInt(status.wifiStrength) || 0,
        uptime: status.uptime,
        gnss_type: status.gnss,
        firmware: status.fwVer,
        timestamp: status.ts,
      }, readingCount);
    } catch (e) {
      // Duplicate reading for same epoch — that's fine
      if (!/already/.test(e.message)) warn("submit error: " + e.message);
    }
  }

  // Also record via ledger for chain persistence
  if (ledger && typeof ledger.recordSensorReading === "function") {
    try {
      await ledger.recordSensorReading(sensorId, value, {
        ns_status: status.nsStatus,
        update_rate: parseFloat(status.upDateRate) || 0,
        gnss_data_rate: parseFloat(status.gnssDataRate) || 0,
        wifi_strength: parseInt(status.wifiStrength) || 0,
      }, readingCount);
    } catch (_) {}
  }
}

// ─── Main loop ──────────────────────────────────────────────────

async function main() {
  log("BTCPC GNSS Bridge — Hyfix MobileCM");
  log("device: " + GNSS_HOST + ":" + GNSS_PORT);
  log("account: " + MINER_ACCOUNT);
  log("sensor: " + sensorId);
  log("poll interval: " + (POLL_INTERVAL / 1000) + "s");
  log("");

  await ensureSensorRegistered();

  // Initial poll
  var status = await pollStatus();
  if (status) await submitReading(status);

  // Polling loop
  setInterval(async function () {
    var s = await pollStatus();
    if (s) await submitReading(s);
  }, POLL_INTERVAL);
}

// Graceful shutdown
process.on("SIGINT", function () { log("shutdown"); process.exit(0); });
process.on("SIGTERM", function () { log("shutdown"); process.exit(0); });

main().catch(function (e) {
  console.error("[gnss-bridge] fatal: " + e.message);
  process.exit(1);
});
