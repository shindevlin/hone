    { name: "gemma3:4b",      size: "3.3GB", params: "4B",   vram: "4GB",  ram: "8GB",  earning: "1x",   speed: "fast",   desc: "Google — strong for size" },
    { name: "mistral:7b",     size: "4.1GB", params: "7B",   vram: "6GB",  ram: "12GB", earning: "1.75x", speed: "medium", desc: "Mistral — higher quality, needs more RAM" },
  ],
  // 8-12GB VRAM (medium, balanced)
  medium: [
    { name: "qwen3.5:9b",     size: "6.5GB",  params: "9.7B",  vram: "8GB",  ram: "16GB", earning: "2.4x", speed: "medium", desc: "Alibaba — best balance of speed/quality" },
