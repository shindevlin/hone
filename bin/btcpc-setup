#!/usr/bin/env node
"use strict";

/**
 * btcpc-setup — Auto-detect hardware, configure, and start the right nodes
 * Shin Devlin
 *
 * Detects: GPU (VRAM), CPU cores, RAM, OS, disk space
 * Decides: miner (needs GPU), clock (anything), explorer (optional)
 * Creates: .env.local with proper config
 * Starts: the appropriate processes
 *
 * Usage: node bin/btcpc-setup
 */

var os = require("os");
var fs = require("fs");
var path = require("path");
var { execSync, spawnSync } = require("child_process");
var crypto = require("crypto");
var readline = require("readline");

var REPO_DIR = path.resolve(__dirname, "..");

function log(msg) { console.log("[setup] " + msg); }
function warn(msg) { console.log("[setup] WARNING: " + msg); }

function ask(question) {
  return new Promise(function (resolve) {
    var rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question("[setup] " + question + " ", function (answer) {
      rl.close();
      resolve(answer.trim().toLowerCase());
    });
  });
}

// ─── Hardware Detection ──────────────────────────────────────────

function detectCPU() {
  var cpus = os.cpus();
  return {
    cores: cpus.length,
    model: cpus[0] ? cpus[0].model.trim() : "unknown",
    speed: cpus[0] ? cpus[0].speed : 0
  };
}

function detectRAM() {
  return {
    totalGB: Math.round(os.totalmem() / (1024 * 1024 * 1024) * 10) / 10,
    freeGB: Math.round(os.freemem() / (1024 * 1024 * 1024) * 10) / 10
  };
}

function detectGPU() {
  // Try nvidia-smi first
  try {
    var nv = execSync("nvidia-smi --query-gpu=name,memory.total --format=csv,noheader,nounits", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    }).trim();
    if (nv) {
      var parts = nv.split(",").map(function (s) { return s.trim(); });
      return {
        available: true,
        name: parts[0] || "NVIDIA GPU",
        vramMB: parseInt(parts[1]) || 0,
        vramGB: Math.round((parseInt(parts[1]) || 0) / 1024 * 10) / 10,
        type: "nvidia"
      };
    }
  } catch (_) {}

  // Try rocm-smi (AMD)
  try {
    var amd = execSync("rocm-smi --showmeminfo vram --csv", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    }).trim();
    if (amd && !amd.includes("ERROR")) {
      return {
        available: true,
        name: "AMD GPU",
        vramMB: 0,
        vramGB: 0,
        type: "amd"
      };
    }
  } catch (_) {}

  // Try macOS metal
  if (os.platform() === "darwin") {
    try {
      var metal = execSync("system_profiler SPDisplaysDataType", {
        encoding: "utf8", timeout: 5000
      });
      if (metal.includes("Metal")) {
        var vramMatch = metal.match(/VRAM.*?(\d+)\s*(MB|GB)/i);
        var vram = 0;
        if (vramMatch) {
          vram = parseInt(vramMatch[1]);
          if (vramMatch[2].toUpperCase() === "GB") vram *= 1024;
        }
        return {
          available: true,
          name: "Apple Metal GPU",
          vramMB: vram,
          vramGB: Math.round(vram / 1024 * 10) / 10,
          type: "metal"
        };
      }
    } catch (_) {}
  }

  return { available: false, name: "none", vramMB: 0, vramGB: 0, type: "none" };
}

function detectOllama() {
  try {
    var tags = execSync("curl -s http://localhost:11434/api/tags", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    });
    var data = JSON.parse(tags);
    return {
      running: true,
      models: (data.models || []).map(function (m) { return m.name; })
    };
  } catch (_) {
    return { running: false, models: [] };
  }
}

function detectDisk() {
  try {
    if (os.platform() === "win32") {
      var win = execSync("wmic logicaldisk get size,freespace /format:csv", {
        encoding: "utf8", timeout: 5000, windowsHide: true
      });
      // Parse first disk
      var lines = win.trim().split("\n").filter(function (l) { return l.includes(","); });
      if (lines.length > 1) {
        var cols = lines[1].split(",");
        return {
          freeGB: Math.round(parseInt(cols[1] || 0) / (1024 * 1024 * 1024)),
          totalGB: Math.round(parseInt(cols[2] || 0) / (1024 * 1024 * 1024))
        };
      }
    } else {
      var df = execSync("df -BG " + REPO_DIR + " | tail -1", {
        encoding: "utf8", timeout: 5000
      });
      var parts = df.trim().split(/\s+/);
      return {
        totalGB: parseInt(parts[1]) || 0,
        freeGB: parseInt(parts[3]) || 0
      };
    }
  } catch (_) {}
  return { totalGB: 0, freeGB: 0 };
}

// ─── Ollama Installation ─────────────────────────────────────────

function canRunOllama(hw) {
  // Needs at least 4GB RAM for smallest model
  if (hw.ram.totalGB < 4) return { can: false, reason: "Need at least 4GB RAM (have " + hw.ram.totalGB + "GB)" };
  // Supported OS
  if (hw.platform !== "linux" && hw.platform !== "darwin" && hw.platform !== "win32") {
    return { can: false, reason: "Ollama supports Linux, macOS, and Windows only" };
  }
  return { can: true, reason: null };
}

async function installOllama() {
  var platform = os.platform();
  log("Installing Ollama...");

  try {
    if (platform === "linux") {
      log("Running: curl -fsSL https://ollama.com/install.sh | sh");
      execSync("curl -fsSL https://ollama.com/install.sh | sh", {
        stdio: "inherit", timeout: 300000
      });
    } else if (platform === "darwin") {
      log("Download Ollama from https://ollama.com/download");
      log("Or install via: brew install ollama");
      try {
        execSync("brew install ollama", { stdio: "inherit", timeout: 300000 });
      } catch (_) {
        log("Please install manually from https://ollama.com/download");
        return false;
      }
    } else if (platform === "win32") {
      log("Download Ollama from https://ollama.com/download");
      log("Run the installer, then re-run btcpc-setup.");
      return false;
    }

    // Verify installation
    try {
      execSync("ollama --version", { encoding: "utf8", timeout: 5000 });
      log("Ollama installed successfully");
      return true;
    } catch (_) {
      warn("Ollama installed but not in PATH. You may need to restart your terminal.");
      return false;
    }
  } catch (err) {
    warn("Ollama installation failed: " + err.message);
    return false;
  }
}

async function startOllamaIfNeeded() {
  // Check if already running
  try {
    execSync("curl -s http://localhost:11434/api/tags", { timeout: 3000, windowsHide: true });
    return true; // already running
  } catch (_) {}

  // Try to start it
  log("Starting Ollama service...");
  try {
    if (os.platform() === "linux") {
      execSync("systemctl start ollama 2>/dev/null || ollama serve &", {
        timeout: 10000, windowsHide: true, stdio: "ignore"
      });
    } else {
      execSync("ollama serve &", { timeout: 10000, stdio: "ignore" });
    }

    // Wait for it to start
    for (var i = 0; i < 10; i++) {
      try {
        execSync("curl -s http://localhost:11434/api/tags", { timeout: 2000, windowsHide: true });
        log("Ollama is running");
        return true;
      } catch (_) {}
      spawnSync("sleep", ["1"]);
    }
  } catch (_) {}

  warn("Could not start Ollama. Start it manually: ollama serve");
  return false;
}

async function pullModel(model) {
  log("Pulling model " + model + " (this may take a few minutes)...");
  try {
    execSync("ollama pull " + model, { stdio: "inherit", timeout: 600000 });
    log("Model " + model + " ready");
    return true;
  } catch (err) {
    warn("Failed to pull " + model + ": " + err.message);
    return false;
  }
}

// Model catalog — organized by VRAM/RAM tier
// earning: relative earning multiplier based on parameter count
//   work_value = tokens_generated * parameter_count
//   bigger model = higher work_value per token = more BTCPC per inference
var MODEL_TIERS = {
  // 4GB VRAM or 8GB+ RAM (small, fast)
  small: [
    { name: "qwen3:4b",       size: "2.5GB", params: "4B",   vram: "4GB",  ram: "8GB",  earning: "1x",   speed: "fast",   desc: "Alibaba — fast general-purpose" },
    { name: "llama3.2:3b",    size: "2.0GB", params: "3B",   vram: "4GB",  ram: "8GB",  earning: "0.75x", speed: "fastest", desc: "Meta — compact, quick responses" },
    { name: "phi4-mini:3.8b", size: "2.3GB", params: "3.8B", vram: "4GB",  ram: "8GB",  earning: "0.95x", speed: "fast",   desc: "Microsoft — efficient reasoning" },
    { name: "gemma3:4b",      size: "3.3GB", params: "4B",   vram: "4GB",  ram: "8GB",  earning: "1x",   speed: "fast",   desc: "Google — strong for size" },
    { name: "mistral:7b",     size: "4.1GB", params: "7B",   vram: "6GB",  ram: "12GB", earning: "1.75x", speed: "medium", desc: "Mistral — higher quality, needs more RAM" },
  ],
  // 8-12GB VRAM (medium, balanced)
  medium: [
    { name: "qwen3.5:9b",     size: "6.5GB",  params: "9.7B",  vram: "8GB",  ram: "16GB", earning: "2.4x", speed: "medium", desc: "Alibaba — best balance of speed/quality" },
    { name: "llama3.1:8b",    size: "4.7GB",  params: "8B",    vram: "8GB",  ram: "16GB", earning: "2x",   speed: "medium", desc: "Meta — reliable workhorse" },
    { name: "gemma3:12b",     size: "8.1GB",  params: "12B",   vram: "10GB", ram: "20GB", earning: "3x",   speed: "medium", desc: "Google — strong mid-range" },
    { name: "deepseek-r1:8b", size: "4.9GB",  params: "8B",    vram: "8GB",  ram: "16GB", earning: "2x",   speed: "medium", desc: "DeepSeek — specialized reasoning" },
    { name: "mistral-nemo:12b", size: "7.1GB", params: "12B",  vram: "10GB", ram: "20GB", earning: "3x",   speed: "slower", desc: "Mistral — latest architecture" },
  ],
  // 16-24GB+ VRAM (large, high quality)
  large: [
    { name: "qwen3.5:27b",    size: "17GB",  params: "27B",  vram: "20GB", ram: "32GB", earning: "6.75x", speed: "slower", desc: "Alibaba — top-tier quality" },
    { name: "llama3.3:70b",   size: "40GB",  params: "70B",  vram: "48GB", ram: "64GB", earning: "17.5x", speed: "slow",   desc: "Meta — highest quality, needs serious hardware" },
    { name: "deepseek-r1:32b", size: "19GB", params: "32B",  vram: "24GB", ram: "40GB", earning: "8x",    speed: "slower", desc: "DeepSeek — advanced reasoning" },
    { name: "gemma3:27b",     size: "17GB",  params: "27B",  vram: "20GB", ram: "32GB", earning: "6.75x", speed: "slower", desc: "Google — largest open model" },
    { name: "command-r:35b",  size: "20GB",  params: "35B",  vram: "24GB", ram: "40GB", earning: "8.75x", speed: "slow",   desc: "Cohere — optimized for RAG/search" },
  ]
};

function getModelTier(hw) {
  if (hw.gpu.available) {
    if (hw.gpu.vramGB >= 20) return "large";
    if (hw.gpu.vramGB >= 8) return "medium";
    return "small";
  }
  // CPU-only: use RAM as guide
  if (hw.ram.totalGB >= 32) return "medium";
  return "small";
}

async function pickModels(hw) {
  var tier = getModelTier(hw);
  var models = MODEL_TIERS[tier];

  console.log("");
  log("Recommended models for your hardware (" + tier + " tier):");
  log("Larger models earn more per inference but run slower.");
  console.log("");
  console.log("  #  Model                Download  Params   VRAM    RAM     Earning  Speed    Description");
  console.log("  —  ————————————————————  ————————  ———————  ——————  ——————  ———————  ———————  ———————————————————————————————");
  for (var i = 0; i < models.length; i++) {
    var m = models[i];
    var num = String(i + 1) + ".";
    console.log("  " +
      num.padEnd(3) +
      m.name.padEnd(22) +
      m.size.padEnd(10) +
      m.params.padEnd(9) +
      m.vram.padEnd(8) +
      m.ram.padEnd(8) +
      m.earning.padEnd(9) +
      m.speed.padEnd(9) +
      m.desc
    );
  }
  console.log("");
  console.log("  A. Install all " + tier + " tier models");
  console.log("  S. Skip — I'll install models manually later (clock node only)");
  console.log("");
  log("Earning = relative reward multiplier. 1x base, 6.75x = ~7x more BTCPC per inference.");

  var answer = await ask("Which models to install? (1-" + models.length + ", A for all, S to skip):");

  if (answer === "s" || answer === "skip") return [];
  if (answer === "a" || answer === "all") return models.map(function (m) { return m.name; });

  // Parse selection — support "1,3,5" or "1 3 5" or just "1"
  var selections = answer.split(/[,\s]+/).map(function (s) { return parseInt(s); }).filter(function (n) { return n >= 1 && n <= models.length; });

  if (selections.length === 0) {
    // Default to first model
    log("Defaulting to " + models[0].name);
    return [models[0].name];
  }

  return selections.map(function (n) { return models[n - 1].name; });
}

// ─── Decision Engine ─────────────────────────────────────────────

function decideNodes(hw) {
  var nodes = [];
  var reasons = [];

  // Clock node — always. Runs on anything.
  nodes.push("clock");
  reasons.push("Clock node: runs on any hardware");

  // Miner — needs Ollama running with models. GPU preferred but CPU works too.
  if (hw.ollama.running && hw.ollama.models.length > 0) {
    nodes.push("miner");
    if (hw.gpu.available) {
      reasons.push("Miner: " + hw.gpu.name + " (" + hw.gpu.vramGB + "GB VRAM) + Ollama (" + hw.ollama.models.length + " models)");
    } else {
      reasons.push("Miner: Ollama running (" + hw.ollama.models.length + " models, CPU mode). GPU recommended for better performance.");
    }
  } else if (hw.ollama.running && hw.ollama.models.length === 0) {
    reasons.push("Miner: Ollama running but no models installed. Run: ollama pull qwen3:4b");
  } else {
    reasons.push("Miner: Ollama not running. Install from https://ollama.com to mine.");
  }

  // Explorer — if disk space allows
  if (hw.disk.freeGB >= 1) {
    nodes.push("explorer");
    reasons.push("Explorer: " + hw.disk.freeGB + "GB free disk");
  }

  // Pick the best installed model, or recommend one
  var model = null;
  if (hw.ollama.models && hw.ollama.models.length > 0) {
    // Use the largest installed model
    var preferOrder = ["qwen3.5:27b", "llama3.3:70b", "deepseek-r1:32b", "gemma3:27b",
      "qwen3.5:9b", "llama3.1:8b", "gemma3:12b", "mistral-nemo:12b",
      "qwen3:4b", "llama3.2:3b", "phi4-mini:3.8b", "gemma3:4b", "mistral:7b"];
    for (var p = 0; p < preferOrder.length; p++) {
      if (hw.ollama.models.indexOf(preferOrder[p]) !== -1) {
        model = preferOrder[p];
        break;
      }
    }
    if (!model) model = hw.ollama.models[0]; // fallback to first installed
  }

  // CPU/GPU caps based on RAM and cores
  var cpuCap = 100;
  var gpuCap = 100;
  if (hw.cpu.cores <= 4) cpuCap = 50; // leave room on small machines
  if (hw.ram.totalGB <= 8) cpuCap = Math.min(cpuCap, 60);

  return { nodes: nodes, reasons: reasons, model: model, cpuCap: cpuCap, gpuCap: gpuCap };
}

// ─── Config Generation ───────────────────────────────────────────

function generateConfig(hw, decision) {
  var nodeId = crypto.randomBytes(16).toString("hex");
  var account = process.env.BTCPC_MINER || process.env.BTCPC_CLOCK_ACCOUNT || "miner-" + nodeId.slice(0, 8);

  var lines = [
    "# BTCPC Node Configuration",
    "# Auto-generated by btcpc-setup on " + new Date().toISOString(),
    "# Hardware: " + hw.cpu.cores + " cores, " + hw.ram.totalGB + "GB RAM" + (hw.gpu.available ? ", " + hw.gpu.name + " " + hw.gpu.vramGB + "GB" : ", no GPU"),
    "",
    "BTCPC_NODE_ID=" + nodeId,
    "BTCPC_MINER=" + account,
    "BTCPC_CLOCK_ACCOUNT=" + account,
    "P2P_PORT=6942",
    "BTCPC_SEED_PEERS=ws://100.122.145.60:6942",
    "BTCPC_RELAY_URL=wss://btcpc-relay.shindevlin.workers.dev/ws",
    "BTCPC_MAX_CPU=" + decision.cpuCap,
    "BTCPC_MAX_GPU=" + decision.gpuCap,
  ];

  if (decision.model) {
    lines.push("BTCPC_MODEL=" + decision.model);
  }

  if (hw.ollama.running) {
    lines.push("OLLAMA_URL=http://localhost:11434");
  }

  return lines.join("\n") + "\n";
}

// ─── Startup ─────────────────────────────────────────────────────

function startNodes(decision) {
  var spawn = require("child_process").spawn;
  var pids = [];

  for (var i = 0; i < decision.nodes.length; i++) {
    var node = decision.nodes[i];
    var cmd, args, logFile;

    switch (node) {
      case "clock":
        cmd = process.execPath;
        args = [path.join(REPO_DIR, "bin/btcpc-clock")];
        logFile = "/tmp/btcpc-clock.log";
        break;
      case "miner":
        cmd = process.execPath;
        args = [path.join(REPO_DIR, "bin/btcpc-mine")];
        logFile = "/tmp/btcpc-miner.log";
        break;
      case "explorer":
        cmd = process.execPath;
        args = [path.join(REPO_DIR, "src/explorer/server.js")];
        logFile = "/tmp/btcpc-explorer.log";
        break;
      default:
        continue;
    }

    var out = fs.openSync(logFile, "a");
    var child = spawn(cmd, args, {
      cwd: REPO_DIR,
      detached: true,
      stdio: ["ignore", out, out],
      env: Object.assign({}, process.env)
    });
    child.unref();
    pids.push({ node: node, pid: child.pid, log: logFile });
    log("Started " + node + " (pid " + child.pid + ") → " + logFile);
  }

  return pids;
}

// ─── Main ────────────────────────────────────────────────────────

async function main() {
  console.log("");
  console.log("  ============================================");
  console.log("    btcpc-setup — Auto-configure BTCPC Node");
  console.log("  ============================================");
  console.log("");

  // Detect hardware
  log("Detecting hardware...");
  var hw = {
    platform: os.platform(),
    cpu: detectCPU(),
    ram: detectRAM(),
    gpu: detectGPU(),
    ollama: detectOllama(),
    disk: detectDisk()
  };

  console.log("");
  log("Hardware detected:");
  log("  OS:     " + hw.platform + " " + os.release());
  log("  CPU:    " + hw.cpu.cores + " cores (" + hw.cpu.model + ")");
  log("  RAM:    " + hw.ram.totalGB + "GB total, " + hw.ram.freeGB + "GB free");
  log("  GPU:    " + (hw.gpu.available ? hw.gpu.name + " (" + hw.gpu.vramGB + "GB VRAM)" : "none detected"));
  log("  Ollama: " + (hw.ollama.running ? "running (" + hw.ollama.models.length + " models)" : "not installed or not running"));
  log("  Disk:   " + hw.disk.freeGB + "GB free of " + hw.disk.totalGB + "GB");

  // ── Ollama setup (interactive) ──
  if (!hw.ollama.running) {
    var ollamaCheck = canRunOllama(hw);
    if (ollamaCheck.can) {
      console.log("");
      log("Ollama is not installed or not running.");
      log("Ollama is required for mining (earning 98% of block rewards).");
      log("Without it, this machine runs as a clock node only (2% rewards).");
      console.log("");

      var answer = await ask("Install Ollama to enable mining? (y/n)");
      if (answer === "y" || answer === "yes") {
        var installed = await installOllama();
        if (installed) {
          var started = await startOllamaIfNeeded();
          if (started) {
            // Let user pick from recommended models
            var selectedModels = await pickModels(hw);
            for (var m = 0; m < selectedModels.length; m++) {
              await pullModel(selectedModels[m]);
            }
            // Re-detect Ollama
            hw.ollama = detectOllama();
          }
        }
      }
    } else {
      log("Cannot run Ollama: " + ollamaCheck.reason);
      log("This machine will run as a clock node only.");
    }
  } else if (hw.ollama.models.length === 0) {
    // Ollama running but no models
    console.log("");
    log("Ollama is running but has no models installed.");
    var selectedModels = await pickModels(hw);
    for (var m = 0; m < selectedModels.length; m++) {
      await pullModel(selectedModels[m]);
    }
    hw.ollama = detectOllama();
  }

  // ── Ask for account name ──
  console.log("");
  var accountName = process.env.BTCPC_MINER || process.env.BTCPC_CLOCK_ACCOUNT;
  if (!accountName) {
    accountName = await ask("Choose a username for this node (3-20 chars, lowercase):");
    if (!accountName || accountName.length < 3) {
      accountName = "miner-" + crypto.randomBytes(4).toString("hex");
      log("Using auto-generated name: " + accountName);
    }
  } else {
    log("Using account: " + accountName);
  }

  // Decide what to run
  console.log("");
  var decision = decideNodes(hw);
  log("Node selection:");
  for (var i = 0; i < decision.reasons.length; i++) {
    log("  " + decision.reasons[i]);
  }
  if (decision.model) {
    log("  Model: " + decision.model);
  }

  // Generate config
  var configPath = path.join(REPO_DIR, ".env.node");
  var config = generateConfig(hw, decision);
  // Override account name
  config = config.replace(/BTCPC_MINER=.*/, "BTCPC_MINER=" + accountName);
  config = config.replace(/BTCPC_CLOCK_ACCOUNT=.*/, "BTCPC_CLOCK_ACCOUNT=" + accountName);
  fs.writeFileSync(configPath, config);
  log("Config written to " + configPath);

  // Load the config
  process.env.BTCPC_MINER = accountName;
  process.env.BTCPC_CLOCK_ACCOUNT = accountName;
  require("dotenv").config({ path: configPath, override: true });

  // Start nodes
  console.log("");
  log("Starting " + decision.nodes.length + " node(s)...");
  var pids = startNodes(decision);

  console.log("");
  console.log("  ============================================");
  console.log("    BTCPC is running!");
  console.log("  ============================================");
  console.log("");
  for (var j = 0; j < pids.length; j++) {
    console.log("  " + pids[j].node + ": pid " + pids[j].pid + " (log: " + pids[j].log + ")");
  }
  console.log("");

  if (decision.nodes.indexOf("miner") === -1) {
    console.log("  Running as clock node only (2% of block rewards).");
    console.log("  Install Ollama + a model to mine (98% of block rewards).");
    console.log("");
  } else {
    console.log("  Mining + clock node active. Earning full rewards.");
    console.log("");
  }

  if (decision.nodes.indexOf("explorer") !== -1) {
    console.log("  Explorer: http://localhost:4242");
    console.log("  Settings: http://localhost:4242/settings");
    console.log("");
  }

  console.log("  Logs: tail -f /tmp/btcpc-*.log");
  console.log("");
}

main().catch(function (err) { console.error("Setup failed: " + err.message); process.exit(1); });
