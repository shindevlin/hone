#!/usr/bin/env node
"use strict";

/**
 * btcpc-setup — Auto-detect hardware, configure, and start the right nodes
 * Shin Devlin
 *
 * Detects: GPU (VRAM), CPU cores, RAM, OS, disk space, network peers
 * Decides: miner (needs GPU), clock (anything), storage, verifier, gateway, sensor
 * Creates: .env with proper config
 * Starts: the appropriate processes via btcpc-all
 *
 * Usage: node bin/btcpc-setup
 */

var os = require("os");
var fs = require("fs");
var path = require("path");
var { execSync, spawnSync } = require("child_process");
var crypto = require("crypto");
var readline = require("readline");

var REPO_DIR = path.resolve(__dirname, "..");
var argv = process.argv.slice(2);
var SETUP_OPTIONS = {
  assumeYes: argv.indexOf("--yes") !== -1,
  skipOllama: argv.indexOf("--skip-ollama") !== -1,
  noStart: argv.indexOf("--no-start") !== -1,
  username: null
};

for (var argIndex = 0; argIndex < argv.length; argIndex++) {
  if (argv[argIndex] === "--username" && argv[argIndex + 1]) {
    SETUP_OPTIONS.username = String(argv[argIndex + 1]).trim().toLowerCase();
    argIndex++;
  }
}

function log(msg) { console.log("[setup] " + msg); }
function warn(msg) { console.log("[setup] WARNING: " + msg); }

function ask(question, defaultAnswer) {
  if (SETUP_OPTIONS.assumeYes) {
    var answer = defaultAnswer === undefined || defaultAnswer === null ? "" : String(defaultAnswer);
    log(question + " " + (answer ? "[" + answer + "]" : "[auto]"));
    return Promise.resolve(answer);
  }
  return new Promise(function (resolve) {
    var rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    rl.question("[setup] " + question + " ", function (answer) {
      rl.close();
      resolve(answer.trim().toLowerCase());
    });
  });
}

// ─── Hardware Detection ──────────────────────────────────────────

function detectCPU() {
  var cpus = os.cpus();
  return {
    cores: cpus.length,
    model: cpus[0] ? cpus[0].model.trim() : "unknown",
    speed: cpus[0] ? cpus[0].speed : 0
  };
}

function detectRAM() {
  return {
    totalGB: Math.round(os.totalmem() / (1024 * 1024 * 1024) * 10) / 10,
    freeGB: Math.round(os.freemem() / (1024 * 1024 * 1024) * 10) / 10
  };
}

function detectGPU() {
  // Try nvidia-smi first
  try {
    var nv = execSync("nvidia-smi --query-gpu=name,memory.total --format=csv,noheader,nounits", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    }).trim();
    if (nv) {
      var parts = nv.split(",").map(function (s) { return s.trim(); });
      return {
        available: true,
        name: parts[0] || "NVIDIA GPU",
        vramMB: parseInt(parts[1]) || 0,
        vramGB: Math.round((parseInt(parts[1]) || 0) / 1024 * 10) / 10,
        type: "nvidia"
      };
    }
  } catch (_) {}

  // Try rocm-smi (AMD)
  try {
    var amd = execSync("rocm-smi --showmeminfo vram --csv", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    }).trim();
    if (amd && !amd.includes("ERROR")) {
      return {
        available: true,
        name: "AMD GPU",
        vramMB: 0,
        vramGB: 0,
        type: "amd"
      };
    }
  } catch (_) {}

  // Try macOS metal
  if (os.platform() === "darwin") {
    try {
      var metal = execSync("system_profiler SPDisplaysDataType", {
        encoding: "utf8", timeout: 5000
      });
      if (metal.includes("Metal")) {
        var vramMatch = metal.match(/VRAM.*?(\d+)\s*(MB|GB)/i);
        var vram = 0;
        if (vramMatch) {
          vram = parseInt(vramMatch[1]);
          if (vramMatch[2].toUpperCase() === "GB") vram *= 1024;
        }
        return {
          available: true,
          name: "Apple Metal GPU",
          vramMB: vram,
          vramGB: Math.round(vram / 1024 * 10) / 10,
          type: "metal"
        };
      }
    } catch (_) {}
  }

  return { available: false, name: "none", vramMB: 0, vramGB: 0, type: "none" };
}

function detectOllama() {
  try {
    var tags = execSync("curl -s http://localhost:11434/api/tags", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    });
    var data = JSON.parse(tags);
    return {
      running: true,
      models: (data.models || []).map(function (m) { return m.name; })
    };
  } catch (_) {
    return { running: false, models: [] };
  }
}

function detectDisk() {
  try {
    if (os.platform() === "win32") {
      var win = execSync("wmic logicaldisk get size,freespace /format:csv", {
        encoding: "utf8", timeout: 5000, windowsHide: true
      });
      // Parse first disk
      var lines = win.trim().split("\n").filter(function (l) { return l.includes(","); });
      if (lines.length > 1) {
        var cols = lines[1].split(",");
        return {
          freeGB: Math.round(parseInt(cols[1] || 0) / (1024 * 1024 * 1024)),
          totalGB: Math.round(parseInt(cols[2] || 0) / (1024 * 1024 * 1024))
        };
      }
    } else {
      var df = execSync("df -BG " + REPO_DIR + " | tail -1", {
        encoding: "utf8", timeout: 5000
      });
      var parts = df.trim().split(/\s+/);
      return {
        totalGB: parseInt(parts[1]) || 0,
        freeGB: parseInt(parts[3]) || 0
      };
    }
  } catch (_) {}
  return { totalGB: 0, freeGB: 0 };
}

function detectOS() {
  var platform = os.platform();
  var release = os.release();
  var name = platform;

  // Friendly OS name
  if (platform === "linux") {
    try {
      var osRelease = fs.readFileSync("/etc/os-release", "utf8");
      var pretty = osRelease.match(/PRETTY_NAME="([^"]+)"/);
      if (pretty) name = pretty[1];
    } catch (_) {
      name = "Linux " + release;
    }
  } else if (platform === "darwin") {
    try {
      var ver = execSync("sw_vers -productVersion", { encoding: "utf8", timeout: 3000 }).trim();
      name = "macOS " + ver;
    } catch (_) {
      name = "macOS";
    }
  } else if (platform === "win32") {
    name = "Windows " + release;
  }

  // WSL detection
  var isWSL = false;
  if (platform === "linux") {
    try {
      var uname = execSync("uname -r", { encoding: "utf8", timeout: 3000 }).trim().toLowerCase();
      if (uname.includes("microsoft") || uname.includes("wsl")) isWSL = true;
    } catch (_) {}
    if (!isWSL) {
      try {
        if (fs.existsSync("/proc/sys/fs/binfmt_misc/WSLInterop")) isWSL = true;
      } catch (_) {}
    }
  }

  return { name: name, platform: platform, release: release, isWSL: isWSL };
}

function detectNetwork() {
  var interfaces = os.networkInterfaces();
  var localIP = null;
  var subnet = null;

  // Find primary local IP
  var ifNames = Object.keys(interfaces);
  for (var i = 0; i < ifNames.length; i++) {
    var addrs = interfaces[ifNames[i]];
    for (var j = 0; j < addrs.length; j++) {
      var addr = addrs[j];
      if (addr.family === "IPv4" && !addr.internal) {
        localIP = addr.address;
        // Derive /24 subnet
        var octets = localIP.split(".");
        subnet = octets[0] + "." + octets[1] + "." + octets[2];
        break;
      }
    }
    if (localIP) break;
  }

  // Count known BTCPC peers via seed
  var peerCount = 0;
  try {
    var peersRaw = execSync("curl -s --connect-timeout 2 http://localhost:3000/api/peers 2>/dev/null || echo '[]'", {
      encoding: "utf8", timeout: 5000, windowsHide: true
    });
    var peers = JSON.parse(peersRaw);
    if (Array.isArray(peers)) peerCount = peers.length;
  } catch (_) {}

  return { localIP: localIP || "unknown", subnet: subnet, peerCount: peerCount };
}

function detectLoRaHardware() {
  // Check for LoRa/sensor hardware indicators
  try {
    // Check for common LoRa USB devices
    if (os.platform() !== "win32") {
      var usb = execSync("ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || true", {
        encoding: "utf8", timeout: 3000
      }).trim();
      if (usb) return true;
    }
  } catch (_) {}
  return false;
}

function detectGPIOSensors() {
  // Check for GPIO/sensor availability (Raspberry Pi, etc.)
  try {
    if (fs.existsSync("/sys/class/gpio")) return true;
    if (fs.existsSync("/dev/i2c-1")) return true;
  } catch (_) {}
  return false;
}

// ─── Hardware Summary Display ───────────────────────────────────

function displayHardwareSummary(hw) {
  console.log("");
  console.log("  === Your Hardware ===");
  console.log("  CPU:     " + hw.cpu.model + " (" + hw.cpu.cores + " cores)");
  console.log("  RAM:     " + hw.ram.totalGB + " GB (" + hw.ram.freeGB + " GB available)");
  if (hw.gpu.available) {
    console.log("  GPU:     " + hw.gpu.name + " (" + hw.gpu.vramGB + " GB VRAM)");
  } else {
    console.log("  GPU:     none detected");
  }
  console.log("  Disk:    " + hw.disk.freeGB + " GB available");
  console.log("  Network: " + hw.network.localIP + " (" + hw.network.peerCount + " peers visible)");
  console.log("  OS:      " + hw.osInfo.name + " (WSL: " + (hw.osInfo.isWSL ? "yes" : "no") + ")");
  console.log("  Ollama:  " + (hw.ollama.running ? "running (" + hw.ollama.models.length + " models)" : "not running"));
  console.log("");
}

// ─── Role Selection ─────────────────────────────────────────────

var ROLES = [
  {
    id: "clock",
    name: "Clock Node",
    ram: "~50 MB RAM, minimal CPU",
    desc: "Keeps network time alive. Lightest role. Every device should run this.",
    alwaysOn: true,
    recommend: function () { return true; }
  },
  {
    id: "miner",
    name: "Miner",
    ram: "~2-8 GB RAM/VRAM, heavy CPU/GPU",
    desc: "AI inference for the network. Requires Ollama. Bigger models = more earnings.",
    alwaysOn: false,
    recommend: function (hw) { return hw.gpu.available || hw.ram.totalGB >= 8; }
  },
  {
    id: "storage",
    name: "Storage Host",
    ram: "~100 MB RAM, uses disk space",
    desc: "Host files for the network. Set max disk allocation below.",
    alwaysOn: false,
    recommend: function (hw) { return hw.disk.freeGB > 50; }
  },
  {
    id: "verifier",
    name: "Verifier",
    ram: "~200 MB RAM, moderate CPU",
    desc: "Verify other miners' work. Earn 10% pool.",
    alwaysOn: false,
    recommend: function (hw) { return hw.cpu.cores >= 4; }
  },
  {
    id: "gateway",
    name: "Gateway",
    ram: "~100 MB RAM, needs LoRa/sensors",
    desc: "Relay IoT sensor data. Requires hardware sensors.",
    alwaysOn: false,
    recommend: function (hw) { return hw.hasLoRa; }
  },
  {
    id: "sensor",
    name: "Sensor Node",
    ram: "~50 MB RAM, needs GPIO/USB sensors",
    desc: "Report environmental data. Earns from IoT pool.",
    alwaysOn: false,
    recommend: function (hw) { return hw.hasGPIO; }
  }
];

async function selectRoles(hw) {
  console.log("  === What do you want this node to do? ===");
  console.log("");
  console.log("  Each role earns BTCPC. You can run multiple roles.");
  console.log("  Resource usage shown per role.");
  console.log("");

  for (var i = 0; i < ROLES.length; i++) {
    var role = ROLES[i];
    var recommended = role.alwaysOn || role.recommend(hw);
    var marker = recommended ? "+" : " ";
    var num = i + 1;
    console.log("  [" + num + "] " + marker + " " + role.name.padEnd(18) + "(" + role.ram + ")");
    console.log("      " + role.desc);
    console.log("");
  }

  console.log("  + = recommended for your hardware. Clock is always on.");
  console.log("");

  // Build default selection: clock always, plus recommended roles
  var defaults = [];
  for (var r = 0; r < ROLES.length; r++) {
    if (ROLES[r].alwaysOn || ROLES[r].recommend(hw)) {
      defaults.push(r + 1);
    }
  }
  var defaultStr = defaults.join(",");

  var answer = await ask("Enter selections (e.g., 1,2,3 or \"all\") [" + defaultStr + "]:", defaultStr);

  if (answer === "all") {
    return ROLES.map(function (r) { return r.id; });
  }

  // Parse comma/space separated numbers
  var selections = answer.split(/[,\s]+/).map(function (s) { return parseInt(s); }).filter(function (n) { return n >= 1 && n <= ROLES.length; });

  if (selections.length === 0) {
    selections = defaults;
  }

  // Always include clock
  var roleIds = selections.map(function (n) { return ROLES[n - 1].id; });
  if (roleIds.indexOf("clock") === -1) roleIds.unshift("clock");

  return roleIds;
}

// ─── Resource Limits ────────────────────────────────────────────

async function configureResourceLimits(hw, selectedRoles) {
  console.log("  === Resource Limits ===");
  console.log("");
  console.log("  Set maximum resources this node can use.");
  console.log("");

  var limits = {
    maxRamGB: null,
    maxVramGB: null,
    maxStorageGB: null,
    maxCpuPct: null
  };

  // General CPU limit
  var cpuDefault = hw.cpu.cores <= 4 ? "50" : "75";
  var cpuAnswer = await ask("Max total CPU usage [25/50/75/100] (" + cpuDefault + "%):", cpuDefault);
  var cpuVal = parseInt(cpuAnswer);
  if (cpuVal && cpuVal >= 10 && cpuVal <= 100) {
    limits.maxCpuPct = cpuVal;
  } else {
    limits.maxCpuPct = parseInt(cpuDefault);
  }

  // Miner limits
  if (selectedRoles.indexOf("miner") !== -1) {
    console.log("");
    log("Miner resource limits:");

    // RAM for inference
    var ramDefault = "auto";
    if (hw.ram.totalGB >= 32) ramDefault = "16";
    else if (hw.ram.totalGB >= 16) ramDefault = "8";
    else ramDefault = "4";

    var ramAnswer = await ask("Max RAM for inference [auto/" + ramDefault + "GB]: (" + ramDefault + "):", ramDefault);
    if (ramAnswer === "auto") {
      limits.maxRamGB = Math.floor(hw.ram.totalGB * 0.6);
    } else {
      var ramVal = parseInt(ramAnswer);
      if (ramVal && ramVal >= 2) {
        limits.maxRamGB = ramVal;
      } else {
        limits.maxRamGB = parseInt(ramDefault);
      }
    }

    // VRAM limit (only if GPU present)
    if (hw.gpu.available) {
      var vramDefault = String(Math.floor(hw.gpu.vramGB));
      var vramAnswer = await ask("Max VRAM [auto/" + vramDefault + "GB]: (" + vramDefault + "):", vramDefault);
      if (vramAnswer === "auto") {
        limits.maxVramGB = Math.floor(hw.gpu.vramGB);
      } else {
        var vramVal = parseInt(vramAnswer);
        if (vramVal && vramVal >= 2) {
          limits.maxVramGB = vramVal;
        } else {
          limits.maxVramGB = Math.floor(hw.gpu.vramGB);
        }
      }
    }
  }

  // Storage limits
  if (selectedRoles.indexOf("storage") !== -1) {
    console.log("");
    log("Storage host limits:");

    var storDefault = "50";
    if (hw.disk.freeGB >= 200) storDefault = "100";
    else if (hw.disk.freeGB >= 100) storDefault = "50";
    else storDefault = "10";

    var storAnswer = await ask("Max disk space for BTCPC files [10/50/100/unlimited] (" + storDefault + "GB):", storDefault);
    if (storAnswer === "unlimited") {
      limits.maxStorageGB = 0; // 0 = unlimited
    } else {
      var storVal = parseInt(storAnswer);
      if (storVal && storVal >= 1) {
        limits.maxStorageGB = storVal;
      } else {
        limits.maxStorageGB = parseInt(storDefault);
      }
    }
  }

  console.log("");
  log("Resource limits set:");
  log("  CPU:     " + limits.maxCpuPct + "%");
  if (limits.maxRamGB) log("  RAM:     " + limits.maxRamGB + " GB");
  if (limits.maxVramGB) log("  VRAM:    " + limits.maxVramGB + " GB");
  if (limits.maxStorageGB !== null && limits.maxStorageGB !== undefined) {
    log("  Storage: " + (limits.maxStorageGB === 0 ? "unlimited" : limits.maxStorageGB + " GB"));
  }

  return limits;
}

// ─── Network Scan ───────────────────────────────────────────────

async function networkScan(hw, selectedRoles) {
  console.log("");
  console.log("  === Network Discovery ===");
  console.log("");

  var answer = await ask("Scan local network for BTCPC-compatible devices? (y/n):", "y");
  if (answer !== "y" && answer !== "yes") {
    log("Skipping network scan.");
    return [];
  }

  if (!hw.network.subnet) {
    log("Could not determine local subnet. Skipping scan.");
    return [];
  }

  log("Scanning " + hw.network.subnet + ".0/24 ...");

  var found = [];
  var subnet = hw.network.subnet;

  // Quick ping sweep — scan a subset for speed, check common device IPs
  // We scan in parallel using a background fping or sequential fast pings
  var aliveHosts = [];
  try {
    // Try fping first (fast parallel ping)
    var fpingResult = execSync(
      "fping -a -q -g " + subnet + ".1 " + subnet + ".254 2>/dev/null || true",
      { encoding: "utf8", timeout: 15000, windowsHide: true }
    ).trim();
    if (fpingResult) {
      aliveHosts = fpingResult.split("\n").filter(function (l) { return l.trim(); });
    }
  } catch (_) {
    // Fallback: quick sequential ping of common ranges
    try {
      var pingResult = execSync(
        "for i in $(seq 1 254); do (ping -c 1 -W 1 " + subnet + ".$i >/dev/null 2>&1 && echo " + subnet + ".$i) & done; wait",
        { encoding: "utf8", timeout: 20000, windowsHide: true, shell: "/bin/bash" }
      ).trim();
      if (pingResult) {
        aliveHosts = pingResult.split("\n").filter(function (l) { return l.trim(); });
      }
    } catch (_) {}
  }

  // Skip our own IP
  aliveHosts = aliveHosts.filter(function (ip) { return ip !== hw.network.localIP; });

  log("Found " + aliveHosts.length + " device(s) on local network.");

  // Probe each alive host for BTCPC node (port 3000 or 6942) and known devices
  for (var i = 0; i < aliveHosts.length; i++) {
    var ip = aliveHosts[i].trim();
    var device = { ip: ip, type: "Unknown device", btcpc: null };

    // Check for BTCPC node on port 3000
    try {
      var nodeInfo = execSync(
        "curl -s --connect-timeout 1 http://" + ip + ":3000/api/node-info 2>/dev/null || true",
        { encoding: "utf8", timeout: 3000, windowsHide: true }
      ).trim();
      if (nodeInfo && nodeInfo.startsWith("{")) {
        var info = JSON.parse(nodeInfo);
        device.btcpc = {
          account: info.account || info.miner || "unknown",
          roles: info.roles || []
        };
        device.type = "BTCPC node";
      }
    } catch (_) {}

    // Check for BTCPC node on port 6942 (P2P)
    if (!device.btcpc) {
      try {
        var p2pCheck = execSync(
          "curl -s --connect-timeout 1 http://" + ip + ":6942/ 2>/dev/null || true",
          { encoding: "utf8", timeout: 3000, windowsHide: true }
        ).trim();
        if (p2pCheck && p2pCheck.length > 0) {
          device.type = "BTCPC P2P node (possible)";
        }
      } catch (_) {}
    }

    // Check for Hyfix GNSS base station (port 80)
    try {
      var httpCheck = execSync(
        "curl -s --connect-timeout 1 http://" + ip + "/ 2>/dev/null | head -c 500 || true",
        { encoding: "utf8", timeout: 3000, windowsHide: true }
      ).trim();
      if (httpCheck) {
        if (/hyfix/i.test(httpCheck) || /gnss/i.test(httpCheck) || /ntrip/i.test(httpCheck)) {
          device.type = "Hyfix GNSS base station (sensor data available)";
        } else if (/raspberry/i.test(httpCheck) || /raspberrypi/i.test(httpCheck)) {
          device.type = "Raspberry Pi";
        }
      }
    } catch (_) {}

    // Identify Raspberry Pi via mDNS/hostname heuristics
    if (device.type === "Unknown device") {
      try {
        var arpLine = execSync(
          "arp -a " + ip + " 2>/dev/null || true",
          { encoding: "utf8", timeout: 2000, windowsHide: true }
        ).trim();
        // Raspberry Pi MACs start with b8:27:eb, dc:a6:32, e4:5f:01, or d8:3a:dd
        if (/b8:27:eb|dc:a6:32|e4:5f:01|d8:3a:dd/i.test(arpLine)) {
          device.type = "Raspberry Pi";
        }
      } catch (_) {}
    }

    found.push(device);
  }

  // Display results
  if (found.length > 0) {
    console.log("");
    console.log("  Found:");
    for (var f = 0; f < found.length; f++) {
      var d = found[f];
      var label = "  " + d.ip + " -- " + d.type;
      if (d.btcpc) {
        label += " (" + d.btcpc.account;
        if (d.btcpc.roles.length > 0) label += ", " + d.btcpc.roles.join("+");
        label += ")";
      } else {
        label += " (no BTCPC)";
      }
      console.log(label);
    }

    // Recommendations
    console.log("");
    console.log("  Recommendations:");
    var hasHyfix = found.some(function (d) { return d.type.includes("Hyfix"); });
    var hasPi = found.some(function (d) { return d.type.includes("Raspberry Pi"); });

    if (hasHyfix) {
      var hyfixDev = found.find(function (d) { return d.type.includes("Hyfix"); });
      console.log("  - The Hyfix at " + hyfixDev.ip + " can provide GNSS correction data to the network");
    }
    if (hasPi && selectedRoles.indexOf("miner") !== -1) {
      console.log("  - Raspberry Pis on your network can run as clock+storage nodes");
    }
    if (hw.gpu.available && selectedRoles.indexOf("miner") !== -1) {
      var tier = getModelTier(hw);
      if (tier === "medium" || tier === "small") {
        console.log("  - Your GPU could earn more with a larger model (qwen3.5:27b recommended)");
      }
    }
    if (found.length > 0 && !found.some(function (d) { return d.btcpc; })) {
      console.log("  - No other BTCPC nodes found — you'll be the first on this network!");
    }
  } else {
    log("No other devices found on local network.");
  }
  console.log("");

  return found;
}

// ─── Ollama Installation ─────────────────────────────────────────

function canRunOllama(hw) {
  // Needs at least 4GB RAM for smallest model
  if (hw.ram.totalGB < 4) return { can: false, reason: "Need at least 4GB RAM (have " + hw.ram.totalGB + "GB)" };
  // Supported OS
  if (hw.osInfo.platform !== "linux" && hw.osInfo.platform !== "darwin" && hw.osInfo.platform !== "win32") {
    return { can: false, reason: "Ollama supports Linux, macOS, and Windows only" };
  }
  return { can: true, reason: null };
}

async function installOllama() {
  var platform = os.platform();
  log("Installing Ollama...");

  try {
    if (platform === "linux") {
      log("Running: curl -fsSL https://ollama.com/install.sh | sh");
      execSync("curl -fsSL https://ollama.com/install.sh | sh", {
        stdio: "inherit", timeout: 300000
      });
    } else if (platform === "darwin") {
      log("Download Ollama from https://ollama.com/download");
      log("Or install via: brew install ollama");
      try {
        execSync("brew install ollama", { stdio: "inherit", timeout: 300000 });
      } catch (_) {
        log("Please install manually from https://ollama.com/download");
        return false;
      }
    } else if (platform === "win32") {
      log("Download Ollama from https://ollama.com/download");
      log("Run the installer, then re-run btcpc-setup.");
      return false;
    }

    // Verify installation
    try {
      execSync("ollama --version", { encoding: "utf8", timeout: 5000 });
      log("Ollama installed successfully");
      return true;
    } catch (_) {
      warn("Ollama installed but not in PATH. You may need to restart your terminal.");
      return false;
    }
  } catch (err) {
    warn("Ollama installation failed: " + err.message);
    return false;
  }
}

async function startOllamaIfNeeded() {
  // Check if already running
  try {
    execSync("curl -s http://localhost:11434/api/tags", { timeout: 3000, windowsHide: true });
    return true; // already running
  } catch (_) {}

  // Try to start it
  log("Starting Ollama service...");
  try {
    if (os.platform() === "linux") {
      execSync("systemctl start ollama 2>/dev/null || ollama serve &", {
        timeout: 10000, windowsHide: true, stdio: "ignore"
      });
    } else {
      execSync("ollama serve &", { timeout: 10000, stdio: "ignore" });
    }

    // Wait for it to start
    for (var i = 0; i < 10; i++) {
      try {
        execSync("curl -s http://localhost:11434/api/tags", { timeout: 2000, windowsHide: true });
        log("Ollama is running");
        return true;
      } catch (_) {}
      spawnSync("sleep", ["1"]);
    }
  } catch (_) {}

  warn("Could not start Ollama. Start it manually: ollama serve");
  return false;
}

async function pullModel(model) {
  log("Pulling model " + model + " (this may take a few minutes)...");
  try {
    execSync("ollama pull " + model, { stdio: "inherit", timeout: 600000 });
    log("Model " + model + " ready");
    return true;
  } catch (err) {
    warn("Failed to pull " + model + ": " + err.message);
    return false;
  }
}

// Model catalog — organized by VRAM/RAM tier
// earning: relative earning multiplier based on parameter count
//   work_value = tokens_generated * parameter_count
//   bigger model = higher work_value per token = more BTCPC per inference
var MODEL_TIERS = {
  // 4GB VRAM or 8GB+ RAM (small, fast)
  small: [
