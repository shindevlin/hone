  // 16-24GB+ VRAM (large, high quality)
  large: [
    { name: "qwen3.5:27b",    size: "17GB",  params: "27B",  vram: "20GB", ram: "32GB", earning: "6.75x", speed: "slower", desc: "Alibaba — top-tier quality" },
    { name: "llama3.3:70b",   size: "40GB",  params: "70B",  vram: "48GB", ram: "64GB", earning: "17.5x", speed: "slow",   desc: "Meta — highest quality, needs serious hardware" },
    { name: "deepseek-r1:32b", size: "19GB", params: "32B",  vram: "24GB", ram: "40GB", earning: "8x",    speed: "slower", desc: "DeepSeek — advanced reasoning" },
    { name: "gemma3:27b",     size: "17GB",  params: "27B",  vram: "20GB", ram: "32GB", earning: "6.75x", speed: "slower", desc: "Google — largest open model" },
    { name: "command-r:35b",  size: "20GB",  params: "35B",  vram: "24GB", ram: "40GB", earning: "8.75x", speed: "slow",   desc: "Cohere — optimized for RAG/search" },
  ]
};

function getModelTier(hw) {
  if (hw.gpu.available) {
    if (hw.gpu.vramGB >= 20) return "large";
    if (hw.gpu.vramGB >= 8) return "medium";
    return "small";
  }
  // CPU-only: use RAM as guide
  if (hw.ram.totalGB >= 32) return "medium";
  return "small";
}

async function pickModels(hw) {
  var tier = getModelTier(hw);
  var models = MODEL_TIERS[tier];

  console.log("");
  log("Recommended models for your hardware (" + tier + " tier):");
  log("Larger models earn more per inference but run slower.");
  console.log("");
  console.log("  #  Model                Download  Params   VRAM    RAM     Earning  Speed    Description");
  console.log("  —  ————————————————————  ————————  ———————  ——————  ——————  ———————  ———————  ———————————————————————————————");
  for (var i = 0; i < models.length; i++) {
    var m = models[i];
    var num = String(i + 1) + ".";
    console.log("  " +
      num.padEnd(3) +
      m.name.padEnd(22) +
      m.size.padEnd(10) +
      m.params.padEnd(9) +
      m.vram.padEnd(8) +
      m.ram.padEnd(8) +
      m.earning.padEnd(9) +
      m.speed.padEnd(9) +
      m.desc
    );
  }
  console.log("");
  console.log("  A. Install all " + tier + " tier models");
  console.log("  S. Skip — I'll install models manually later (clock node only)");
  console.log("");
  log("Earning = relative reward multiplier. 1x base, 6.75x = ~7x more BTCPC per inference.");

  var answer = await ask("Which models to install? (1-" + models.length + ", A for all, S to skip):", "1");

  if (answer === "s" || answer === "skip") return [];
  if (answer === "a" || answer === "all") return models.map(function (m) { return m.name; });

  // Parse selection — support "1,3,5" or "1 3 5" or just "1"
  var selections = answer.split(/[,\s]+/).map(function (s) { return parseInt(s); }).filter(function (n) { return n >= 1 && n <= models.length; });

  if (selections.length === 0) {
    // Default to first model
    log("Defaulting to " + models[0].name);
    return [models[0].name];
  }

  return selections.map(function (n) { return models[n - 1].name; });
}

// ─── Config Generation ───────────────────────────────────────────

function generateConfig(hw, selectedRoles, limits, accountName, bestModel, postingKey) {
  var nodeId = crypto.randomBytes(16).toString("hex");
  var account = accountName || process.env.BTCPC_MINER || process.env.BTCPC_CLOCK_ACCOUNT || "miner-" + nodeId.slice(0, 8);

  var lines = [
    "# BTCPC Node Configuration",
    "# Auto-generated by btcpc-setup on " + new Date().toISOString(),
    "# Hardware: " + hw.cpu.cores + " cores, " + hw.ram.totalGB + "GB RAM" + (hw.gpu.available ? ", " + hw.gpu.name + " " + hw.gpu.vramGB + "GB" : ", no GPU"),
    "",
    "BTCPC_NODE_ID=" + nodeId,
    "BTCPC_MINER=" + account,
    "BTCPC_CLOCK_ACCOUNT=" + account,
    "BTCPC_ROLES=" + selectedRoles.join(","),
    "P2P_PORT=6942",
    "BTCPC_SEED_PEERS=ws://100.122.145.60:6942",
    "BTCPC_RELAY_URL=wss://btcpc-relay.shindevlin.workers.dev/ws",
    "BTCPC_MONGO_MODE=disabled",
  ];

  if (postingKey) {
    lines.push("BTCPC_POSTING_KEY=" + postingKey);
  }

  // Resource limits
  if (limits.maxCpuPct) {
    lines.push("BTCPC_MAX_CPU_PCT=" + limits.maxCpuPct);
  }
  if (limits.maxRamGB) {
    lines.push("BTCPC_MAX_RAM_GB=" + limits.maxRamGB);
  }
  if (limits.maxVramGB) {
    lines.push("BTCPC_MAX_VRAM_GB=" + limits.maxVramGB);
  }
  if (limits.maxStorageGB !== null && limits.maxStorageGB !== undefined) {
    lines.push("BTCPC_MAX_STORAGE_GB=" + (limits.maxStorageGB === 0 ? "unlimited" : limits.maxStorageGB));
  }

  if (bestModel) {
    lines.push("BTCPC_MODEL=" + bestModel);
  }

  if (hw.ollama.running) {
    lines.push("OLLAMA_URL=http://localhost:11434");
  }

  return lines.join("\n") + "\n";
}

// ─── Best Model Selection ────────────────────────────────────────

function pickBestModel(hw) {
  if (!hw.ollama.models || hw.ollama.models.length === 0) return null;

  var preferOrder = ["qwen3.5:27b", "llama3.3:70b", "deepseek-r1:32b", "gemma3:27b",
    "qwen3.5:9b", "llama3.1:8b", "gemma3:12b", "mistral-nemo:12b",
    "qwen3:4b", "llama3.2:3b", "phi4-mini:3.8b", "gemma3:4b", "mistral:7b"];
  for (var p = 0; p < preferOrder.length; p++) {
    if (hw.ollama.models.indexOf(preferOrder[p]) !== -1) {
      return preferOrder[p];
    }
  }
  return hw.ollama.models[0]; // fallback to first installed
}

// ─── Startup ─────────────────────────────────────────────────────

function startNodes(selectedRoles) {
  var spawn = require("child_process").spawn;

  // Use btcpc-all if it exists, otherwise start individually
  var allScript = path.join(REPO_DIR, "bin/btcpc-all");
  if (fs.existsSync(allScript)) {
    log("Starting via btcpc-all...");
    var out = fs.openSync("/tmp/btcpc-all.log", "a");
    var child = spawn(process.execPath, [allScript], {
      cwd: REPO_DIR,
      detached: true,
      stdio: ["ignore", out, out],
      env: Object.assign({}, process.env)
    });
    child.unref();
    return [{ node: "all (" + selectedRoles.join(", ") + ")", pid: child.pid, log: "/tmp/btcpc-all.log" }];
  }

  // Fallback: start individually
  var pids = [];

  for (var i = 0; i < selectedRoles.length; i++) {
    var role = selectedRoles[i];
    var cmd, args, logFile;

    switch (role) {
      case "clock":
        cmd = process.execPath;
        args = [path.join(REPO_DIR, "bin/btcpc-clock")];
        logFile = "/tmp/btcpc-clock.log";
        break;
      case "miner":
        cmd = process.execPath;
        args = [path.join(REPO_DIR, "bin/btcpc-mine")];
        logFile = "/tmp/btcpc-miner.log";
        break;
      case "storage":
        // Storage host — if bin exists
        var storBin = path.join(REPO_DIR, "bin/btcpc-storage");
        if (!fs.existsSync(storBin)) continue;
        cmd = process.execPath;
        args = [storBin];
        logFile = "/tmp/btcpc-storage.log";
        break;
      case "verifier":
        var verBin = path.join(REPO_DIR, "bin/btcpc-verifier");
        if (!fs.existsSync(verBin)) continue;
        cmd = process.execPath;
        args = [verBin];
        logFile = "/tmp/btcpc-verifier.log";
        break;
      case "gateway":
        var gwBin = path.join(REPO_DIR, "bin/btcpc-gateway");
        if (!fs.existsSync(gwBin)) continue;
        cmd = process.execPath;
        args = [gwBin];
        logFile = "/tmp/btcpc-gateway.log";
        break;
      case "sensor":
        var senBin = path.join(REPO_DIR, "bin/btcpc-sensor");
        if (!fs.existsSync(senBin)) continue;
        cmd = process.execPath;
        args = [senBin];
        logFile = "/tmp/btcpc-sensor.log";
        break;
      default:
        continue;
    }

    var out = fs.openSync(logFile, "a");
    var child = spawn(cmd, args, {
      cwd: REPO_DIR,
      detached: true,
      stdio: ["ignore", out, out],
      env: Object.assign({}, process.env)
    });
    child.unref();
    pids.push({ node: role, pid: child.pid, log: logFile });
    log("Started " + role + " (pid " + child.pid + ") -> " + logFile);
  }

  return pids;
}

// ─── Main ────────────────────────────────────────────────────────

async function main() {
  console.log("");
  console.log("  ============================================");
  console.log("    btcpc-setup — Auto-configure BTCPC Node");
  console.log("  ============================================");
  console.log("");

  // ── Step 1: Hardware Scan ──
  log("Detecting hardware...");
  var hw = {
    platform: os.platform(),
    cpu: detectCPU(),
    ram: detectRAM(),
    gpu: detectGPU(),
    ollama: detectOllama(),
    disk: detectDisk(),
    osInfo: detectOS(),
    network: detectNetwork(),
    hasLoRa: detectLoRaHardware(),
    hasGPIO: detectGPIOSensors()
  };

  displayHardwareSummary(hw);

  // ── Step 2: Role Selection ──
  console.log("");
  var selectedRoles = await selectRoles(hw);
  console.log("");
  log("Selected roles: " + selectedRoles.join(", "));

  // ── Step 3: Resource Limits ──
  console.log("");
  var limits = await configureResourceLimits(hw, selectedRoles);

  // ── Step 4: Network Scan ──
  await networkScan(hw, selectedRoles);

  // ── Step 5: Account Setup ──
  console.log("");
  var accountName = process.env.BTCPC_MINER || process.env.BTCPC_CLOCK_ACCOUNT;
  var postingKey = process.env.BTCPC_POSTING_KEY || "";
  if (!accountName) {
    var accountMode = (await ask("Do you already have a BTCPC account? [y/N]", "n")).trim().toLowerCase();
    var hasAccount = accountMode === "y" || accountMode === "yes";
    accountName = SETUP_OPTIONS.username || await ask("BTCPC username for this node (3-20 chars, lowercase):");
    if (!accountName || accountName.length < 3) {
      accountName = "miner-" + crypto.randomBytes(4).toString("hex");
      log("Using auto-generated name: " + accountName);
    }

    if (hasAccount) {
      if (selectedRoles.indexOf("miner") !== -1 || selectedRoles.indexOf("both") !== -1) {
        postingKey = await ask("Paste the BTCPC posting private key for mining (64 hex chars). Leave blank to configure later:", "");
        if (postingKey && !/^[0-9a-fA-F]{64}$/.test(postingKey)) {
          warn("Posting key was not 64 hex chars; leaving BTCPC_POSTING_KEY unset.");
          postingKey = "";
        }
      }
      log("Using existing account: " + accountName);
    } else {
      console.log("");
      log("Creating BTCPC account: " + accountName);
      try {
        var { createAccountForUser } = require(path.join(REPO_DIR, "src/services/accountCreation"));
        var password = await ask("Create an account password (8+ chars):", accountName + "-setup");
        var account = await createAccountForUser({
          username: accountName,
          password: password,
          requirePassword: true,
          claimFaucet: true,
        });

        console.log("");
        console.log("  ============================================");
        console.log("  SAVE THIS NOW - WE DO NOT STORE YOUR KEYS");
        console.log("  ============================================");
        console.log("");
        console.log(account.wallet_export);
        console.log("");
        console.log("  ============================================");
        console.log("");

        postingKey = account.role_private_keys.posting;
        log("Write down the full wallet export. If you lose it, your account is gone forever.");
        await ask("Press Enter when you've saved your wallet export...", "");
      } catch (err) {
        if (err.message && err.message.includes("already exists")) {
          log("Account '" + accountName + "' already exists — using it");
        } else {
          warn("Account creation failed: " + err.message);
          log("You can create an account later on the website or via the bot.");
        }
      }
    }
  } else {
    log("Using existing account: " + accountName);
  }

  // ── Step 6: Ollama + Model Selection (if miner role selected) ──
  if (selectedRoles.indexOf("miner") !== -1) {
    if (!hw.ollama.running) {
      var ollamaCheck = canRunOllama(hw);
      if (SETUP_OPTIONS.skipOllama) {
        log("Skipping Ollama install by request.");
        log("Miner role selected but Ollama not available. Will run other roles.");
      } else if (ollamaCheck.can) {
        console.log("");
        log("Ollama is not installed or not running.");
        log("Ollama is required for mining (earning 98% of block rewards).");
        console.log("");

        var answer = await ask("Install Ollama to enable mining? (y/n)", SETUP_OPTIONS.assumeYes ? "y" : null);
        if (answer === "y" || answer === "yes") {
          var installed = await installOllama();
          if (installed) {
            var started = await startOllamaIfNeeded();
            if (started) {
              var selectedModels = await pickModels(hw);
              for (var m = 0; m < selectedModels.length; m++) {
                await pullModel(selectedModels[m]);
              }
              hw.ollama = detectOllama();
            }
          }
        }
      } else {
        log("Cannot run Ollama: " + ollamaCheck.reason);
        log("Miner role selected but hardware insufficient. Will run other roles.");
      }
    } else if (hw.ollama.models.length === 0) {
      // Ollama running but no models
      console.log("");
      log("Ollama is running but has no models installed.");
      var selectedModels = await pickModels(hw);
      for (var m = 0; m < selectedModels.length; m++) {
        await pullModel(selectedModels[m]);
      }
      hw.ollama = detectOllama();
    }
  }

  // Pick best model from what's installed
  var bestModel = pickBestModel(hw);

  // ── Step 7: Save Config and Start ──
  console.log("");
  console.log("  === Save Config and Start ===");
  console.log("");

  var configPath = path.join(REPO_DIR, ".env");
  var config = generateConfig(hw, selectedRoles, limits, accountName, bestModel, postingKey);
  fs.writeFileSync(configPath, config);
  log("Config written to " + configPath);

  // Also write .env.node for backwards compat
  var envNodePath = path.join(REPO_DIR, ".env.node");
  fs.writeFileSync(envNodePath, config);

  // Load the config into current process
  process.env.BTCPC_MINER = accountName;
  process.env.BTCPC_CLOCK_ACCOUNT = accountName;
  if (postingKey) process.env.BTCPC_POSTING_KEY = postingKey;
  process.env.BTCPC_ROLES = selectedRoles.join(",");
  if (limits.maxCpuPct) process.env.BTCPC_MAX_CPU_PCT = String(limits.maxCpuPct);
  if (limits.maxRamGB) process.env.BTCPC_MAX_RAM_GB = String(limits.maxRamGB);
  if (limits.maxVramGB) process.env.BTCPC_MAX_VRAM_GB = String(limits.maxVramGB);
  if (limits.maxStorageGB !== null && limits.maxStorageGB !== undefined) {
    process.env.BTCPC_MAX_STORAGE_GB = String(limits.maxStorageGB === 0 ? "unlimited" : limits.maxStorageGB);
  }
  require("dotenv").config({ path: configPath, override: true });

  // Display final config summary
  console.log("");
  console.log("  ============================================");
  console.log("    BTCPC Node Configuration Summary");
  console.log("  ============================================");
  console.log("");
  console.log("  Account:  " + accountName);
  console.log("  Roles:    " + selectedRoles.join(", "));
  console.log("  CPU:      " + (limits.maxCpuPct || 100) + "%");
  if (limits.maxRamGB) console.log("  RAM:      " + limits.maxRamGB + " GB");
  if (limits.maxVramGB) console.log("  VRAM:     " + limits.maxVramGB + " GB");
  if (limits.maxStorageGB !== null && limits.maxStorageGB !== undefined) {
    console.log("  Storage:  " + (limits.maxStorageGB === 0 ? "unlimited" : limits.maxStorageGB + " GB"));
  }
  if (bestModel) console.log("  Model:    " + bestModel);
  console.log("  Config:   " + configPath);
  console.log("");

  // Start nodes
  if (SETUP_OPTIONS.noStart) {
    log("Setup complete. Node startup skipped (--no-start).");
    return;
  }

  log("Starting " + selectedRoles.length + " role(s)...");
  var pids = startNodes(selectedRoles);

  console.log("");
  console.log("  ============================================");
  console.log("    BTCPC is running!");
  console.log("  ============================================");
  console.log("");
  for (var j = 0; j < pids.length; j++) {
    console.log("  " + pids[j].node + ": pid " + pids[j].pid + " (log: " + pids[j].log + ")");
  }
  console.log("");

  if (selectedRoles.indexOf("miner") === -1) {
    console.log("  Running as: " + selectedRoles.join(" + ") + " (no miner).");
    console.log("  Install Ollama + a model to enable mining (98% of block rewards).");
    console.log("");
  } else {
    console.log("  Mining active. Earning full rewards.");
    console.log("  Roles: " + selectedRoles.join(" + "));
    console.log("");
  }

  console.log("  Logs: tail -f /tmp/btcpc-*.log");
  console.log("");
}

main().catch(function (err) { console.error("Setup failed: " + err.message); process.exit(1); });
