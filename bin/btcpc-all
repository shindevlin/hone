#!/usr/bin/env node
"use strict";

/**
 * btcpc-all — Multi-role BTCPC supervisor
 * Shin Devlin
 *
 * One entrypoint for containers (and bare-metal setups) that want the
 * full BTCPC node experience: miner + clock + storage host + HTTP API +
 * service host runner + oracle verifier. Each role runs in its own
 * child process so a crash in one doesn't take down the whole node.
 *
 * Usage:
 *   node bin/btcpc-all
 *   BTCPC_ROLES=miner,clock node bin/btcpc-all
 *   BTCPC_ROLES=all node bin/btcpc-all  (default)
 *
 * Roles recognised (comma-separated in BTCPC_ROLES):
 *   api        HTTP API server (routes, epoch loop, gateway)
 *   miner      bin/btcpc-mine — Ollama inference, mining rewards
 *   clock      bin/btcpc-clock — epoch timing, clock rewards
 *   storage    bin/btcpc-storage — BTCPC-FS blob host + heartbeats
 *   all        shorthand for every known role (default)
 *
 * Children are auto-restarted with a short back-off if they crash,
 * but once this supervisor receives SIGTERM/SIGINT it stops restarts
 * and forwards the signal to every child for a graceful shutdown.
 *
 * Output from every child is prefixed with "[role] " so a single
 * `docker logs` stream shows what came from where.
 */

var path = require("path");
var fs   = require("fs");
var { spawn } = require("child_process");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

var KNOWN_ROLES = ["api", "miner", "clock", "storage", "monitor", "updater", "gnss", "gateway"];

function wanted() {
  var raw = (process.env.BTCPC_ROLES || "all").toLowerCase();
  var parts = raw.split(",").map(function (s) { return s.trim(); }).filter(Boolean);
  if (parts.indexOf("all") !== -1 || parts.length === 0) return KNOWN_ROLES.slice();
  return parts.filter(function (p) { return KNOWN_ROLES.indexOf(p) !== -1; });
}

var BACKOFF_MS    = 5000;
var REPO_ROOT     = path.resolve(__dirname, "..");
var PENDING_FILE  = path.join(REPO_ROOT, ".btcpc-update-pending");
var children      = {};
var shuttingDown  = false;
var startedAt     = Date.now();

function roleEnv(role) {
  var env = Object.assign({}, process.env, { BTCPC_ROLE: role });

  // In the all-in-one desktop node, each long-lived role must own a distinct
  // socket. Otherwise API and miner race for 6942 and one silently loses its
  // P2P listener while the UI still thinks "all nodes" are running.
  if (role === "clock") env.P2P_PORT = process.env.BTCPC_CLOCK_P2P_PORT || "6943";
  else if (role === "api") env.P2P_PORT = process.env.BTCPC_API_P2P_PORT || "6944";
  else if (role === "miner") env.P2P_PORT = process.env.BTCPC_MINER_P2P_PORT || "6942";

  // The API should serve HTTP and relay P2P messages in btcpc-all. Epoch
  // production/finality belongs to miner+clock, otherwise the API's wall-clock
  // loop can drift from disk height and emit misleading idle/finality records.
  if (role === "api" && process.env.BTCPC_EPOCH_ENABLED === undefined) {
    env.BTCPC_EPOCH_ENABLED = "false";
  }

  return env;
}

function prefix(role, line) {
  return "[" + role + "] " + line;
}

function logLines(role, stream) {
  var buffer = "";
  stream.setEncoding("utf8");
  stream.on("data", function (chunk) {
    buffer += chunk;
    var idx;
    while ((idx = buffer.indexOf("\n")) >= 0) {
      var line = buffer.slice(0, idx);
      buffer = buffer.slice(idx + 1);
      if (line.length > 0) process.stdout.write(prefix(role, line) + "\n");
    }
  });
  stream.on("end", function () {
    if (buffer.length > 0) process.stdout.write(prefix(role, buffer) + "\n");
  });
}

function launch(role, script) {
  var entry = children[role] || { role: role, script: script, restarts: 0, lastStart: 0 };
  entry.lastStart = Date.now();
  entry.restarts += 1;
  children[role] = entry;

  console.log("[supervisor] starting " + role + " (restart #" + entry.restarts + ")");

  // Gateway role needs --account passed from BTCPC_MINER env
  var args = [script];
  if (role === "gateway" && process.env.BTCPC_MINER) {
    args.push("--account", process.env.BTCPC_MINER);
  }

  var child = spawn("node", args, {
    cwd: REPO_ROOT,
    env: roleEnv(role),
    stdio: ["ignore", "pipe", "pipe"],
  });

  entry.child = child;
  logLines(role, child.stdout);
  logLines(role, child.stderr);

  child.on("exit", function (code, signal) {
    entry.child = null;
    console.log("[supervisor] " + role + " exited (code=" + code + " signal=" + signal + ")");

    if (shuttingDown) return;

    // If a role crashes repeatedly in quick succession, back off longer
    // to avoid thrashing the log stream and hammering the chain.
    var uptime = Date.now() - entry.lastStart;
    var delay = BACKOFF_MS;
    if (uptime < 30000) delay = Math.min(BACKOFF_MS * Math.pow(2, Math.min(entry.restarts, 6)), 60000);
    console.log("[supervisor] restarting " + role + " in " + (delay / 1000) + "s");
    setTimeout(function () { launch(role, script); }, delay);
  });

  child.on("error", function (err) {
    console.error("[supervisor] " + role + " spawn error: " + err.message);
  });
}

function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  console.log("[supervisor] received " + signal + ", stopping children");

  var pending = 0;
  var roles = Object.keys(children);
  for (var i = 0; i < roles.length; i++) {
    var entry = children[roles[i]];
    if (entry && entry.child) {
      pending++;
      try { entry.child.kill("SIGTERM"); } catch (_) {}
    }
  }

  if (pending === 0) process.exit(0);

  // Hard-kill anything that didn't exit within 10s
  setTimeout(function () {
    for (var j = 0; j < roles.length; j++) {
      var e = children[roles[j]];
      if (e && e.child) {
        try { e.child.kill("SIGKILL"); } catch (_) {}
      }
    }
    setTimeout(function () { process.exit(0); }, 1000);
  }, 10000);
}

process.on("SIGINT", function () { shutdown("SIGINT"); });
process.on("SIGTERM", function () { shutdown("SIGTERM"); });

// ─── Update-pending check ────────────────────────────────────────────────────
// Checked every 60 s. When bin/btcpc-auto-update writes .btcpc-update-pending
// we gracefully restart all running children so they load the new image code.

function restartAllChildren() {
  if (shuttingDown) return;
  var roles = Object.keys(children);
  console.log("[supervisor] Update detected — restarting children");

  // SIGTERM every live child. The existing exit handler will respawn each one.
  for (var i = 0; i < roles.length; i++) {
    var entry = children[roles[i]];
    if (entry && entry.child) {
      try { entry.child.kill("SIGTERM"); } catch (_) {}
    }
  }
}

setInterval(function () {
  if (shuttingDown) return;
  try {
    if (fs.existsSync(PENDING_FILE)) {
      // Delete the flag first so we don't loop
      try { fs.unlinkSync(PENDING_FILE); } catch (_) {}
      restartAllChildren();
    }
  } catch (e) {
    console.error("[supervisor] update-check error: " + e.message);
  }
}, 60000);

// Periodic status line so `docker logs` shows the supervisor is alive
setInterval(function () {
  var uptimeS = Math.floor((Date.now() - startedAt) / 1000);
  var alive = Object.keys(children).filter(function (r) { return children[r] && children[r].child; });
  console.log("[supervisor] uptime=" + uptimeS + "s alive=[" + alive.join(",") + "]");
}, 300000);

// ─── Self-heal watchdog ─────────────────────────────────────────────────────
// Check every 5 minutes: if the latest block file is older than 10 minutes,
// the node is stalled. Restart all children to reconnect to the network.
var WATCHDOG_INTERVAL_MS = 5 * 60 * 1000;
var WATCHDOG_STALE_MS = 10 * 60 * 1000;
var lastWatchdogRestart = 0;

setInterval(function () {
  if (shuttingDown) return;
  try {
    var blocksDir = require("path").join(REPO_ROOT, "data", "blocks");
    var _fs = require("fs");
    if (!_fs.existsSync(blocksDir)) return;

    var files = _fs.readdirSync(blocksDir).filter(function (f) { return f.endsWith(".bin"); });
    if (files.length === 0) return; // no blocks yet (pre-genesis)

    // Find the most recently modified block file
    var latestMtime = 0;
    for (var i = 0; i < files.length; i++) {
      var st = _fs.statSync(require("path").join(blocksDir, files[i]));
      if (st.mtimeMs > latestMtime) latestMtime = st.mtimeMs;
    }

    var age = Date.now() - latestMtime;
    if (age > WATCHDOG_STALE_MS && Date.now() - lastWatchdogRestart > WATCHDOG_STALE_MS) {
      console.log("[supervisor] WATCHDOG: latest block is " + Math.round(age / 60000) + "m old — restarting children to reconnect");
      lastWatchdogRestart = Date.now();
      restartAllChildren();
    }
  } catch (e) {
    console.error("[supervisor] watchdog error: " + e.message);
  }
}, WATCHDOG_INTERVAL_MS);

// ─── Launch requested roles ──────────────────────────────────────

var roles = wanted();
console.log("[supervisor] BTCPC multi-role entrypoint");
console.log("[supervisor] BTCPC_ROLES=" + (process.env.BTCPC_ROLES || "all"));
console.log("[supervisor] Launching: " + roles.join(", "));

var roleMap = {
  api:     "src/index.js",
  miner:   "bin/btcpc-mine",
  clock:   "bin/btcpc-clock",
  storage: "bin/btcpc-storage",
  monitor: "bin/btcpc-chain-monitor",
  updater: "bin/btcpc-update-source",
  gnss:    "bin/btcpc-gnss-bridge",
  gateway: "bin/btcpc-nebra",
};

roles.forEach(function (role) {
  var script = roleMap[role];
  if (!script) {
    console.error("[supervisor] unknown role: " + role);
    return;
  }
  launch(role, script);
});

if (Object.keys(children).length === 0) {
  console.error("[supervisor] no roles to run — exiting");
  process.exit(1);
}

// Always launch the auto-update background watcher regardless of BTCPC_ROLES.
// It writes .btcpc-update-pending when a new image is available; the interval
// above catches that flag and restarts children.
launch("auto-update", "bin/btcpc-auto-update");
