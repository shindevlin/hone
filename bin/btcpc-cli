      const wallet = await Wallet.findOne({ userId: user._id, chain: "btcpc" });

      console.log("");
      console.log("BTCPC Keys: " + username);
      console.log("=".repeat(16 + username.length));
      console.log("");
      if (wallet) {
        console.log("  Address:          " + wallet.address);
      }
      console.log("  Owner (public):   " + (user.ownerPublicKey || "not set"));
      console.log("  Active (public):  " + (user.activePublicKey || "not set"));
      console.log("  Posting (public): " + (user.postingPublicKey || "not set"));
      console.log("  Memo (public):    " + (user.memoPublicKey || "not set"));
      console.log("");
      console.log("  Auth Profile:     " + (user.authProfile || "none"));
      console.log("  2FA Enabled:      " + (user.twoFactorEnabled ? "yes" : "no"));
      console.log("  2FA Public Key:   " + (user.twoFactorPublicKey || "none"));
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet export ---------------------------------------------------------

walletCmd
  .command("export <username>")
  .description("Export encrypted wallet file for a BTCPC account")
  .action(async (username) => {
    try {
      await connect();

      const user = await User.findOne({ username: username });
      if (!user) {
        console.error("error: account '" + username + "' not found");
        await disconnect();
        process.exit(1);
      }

      const wallet = await Wallet.findOne({ userId: user._id, chain: "btcpc" });

      console.log("");
      const password = await prompt("  Enter encryption password: ", true);
      if (!password || password.length < 8) {
        console.error("error: password must be at least 8 characters");
        await disconnect();
        process.exit(1);
      }

      // Build wallet export payload (public keys only — private keys are NEVER stored)
      const exportData = {
        version: 1,
        chain: "btcpc",
        username: username,
        address: wallet ? wallet.address : null,
        publicKeys: {
          owner: user.ownerPublicKey,
          active: user.activePublicKey,
          posting: user.postingPublicKey,
          memo: user.memoPublicKey
        },
        authProfile: user.authProfile || "none",
        twoFactorPublicKey: user.twoFactorPublicKey || null,
        exportedAt: new Date().toISOString()
      };

      // Encrypt the export payload
      const plaintext = JSON.stringify(exportData);
      const encrypted = await keyManager.encryptKey(
        Buffer.from(plaintext).toString("hex"),
        password
      );

      const filename = username + "-btcpc-wallet.enc";
      const filepath = path.resolve(process.cwd(), filename);
      fs.writeFileSync(filepath, encrypted, "utf8");

      console.log("");
      console.log("  Wallet exported to: " + filepath);
      console.log("  Encrypted with AES-256-GCM (PBKDF2 key derivation)");
      console.log("  Keep this file and your password safe.");
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet send -----------------------------------------------------------

walletCmd
  .command("send <to> <amount>")
  .description("Send BTCPC to another account (requires active key)")
  .action(async (to, amount) => {
    try {
      amount = parseFloat(amount);
      if (isNaN(amount) || amount <= 0) {
        console.error("error: amount must be a positive number");
        process.exit(1);
      }

      // Get sender from env or prompt
      const senderName = process.env.BTCPC_MINER || process.env.BTCPC_USERNAME;
      if (!senderName) {
        console.error("error: set BTCPC_MINER or BTCPC_USERNAME env var");
        process.exit(1);
      }

      const activeKey = process.env.BTCPC_ACTIVE_KEY;
      if (!activeKey) {
        console.error("error: set BTCPC_ACTIVE_KEY env var (64-char hex private key)");
        process.exit(1);
      }

      await connect();

      // Verify sender
      const sender = await User().findOne({ username: senderName });
      if (!sender) {
        console.error("error: sender account '" + senderName + "' not found");
        await disconnect();
        process.exit(1);
      }

      // Verify active key matches
      const secp256k1 = require("secp256k1");
      const activePub = Buffer.from(secp256k1.publicKeyCreate(Buffer.from(activeKey, "hex"), true)).toString("hex");
      if (sender.activePublicKey && activePub !== sender.activePublicKey) {
        console.error("error: active key does not match this account");
        await disconnect();
        process.exit(1);
      }

      // Find sender wallet
      const Wallet = require("../src/models/Wallet");
      const senderWallet = await Wallet.findOne({ userId: sender._id, chain: "btcpc" });
      if (!senderWallet) {
        console.error("error: no BTCPC wallet found for " + senderName);
        await disconnect();
        process.exit(1);
      }

      const balance = senderWallet.balance.get("BTCPC") || 0;
      if (balance < amount) {
        console.error("error: insufficient balance. Have " + balance.toFixed(10) + ", need " + amount.toFixed(10));
        await disconnect();
        process.exit(1);
      }

      // Find recipient — or send to unclaimed username
      // Tokens sit at the username. When someone registers that name, they own them.
      const recipient = await User().findOne({ username: to });
      let recipientWallet;

      if (recipient) {
        recipientWallet = await Wallet.findOne({ userId: recipient._id, chain: "btcpc" });
        if (!recipientWallet) {
          console.error("error: no BTCPC wallet found for " + to);
          await disconnect();
          process.exit(1);
        }
      } else {
        // Username doesn't exist yet — create a placeholder wallet
        // Tokens sit here until someone registers this username and claims them
        console.log("  '" + to + "' is not registered. Tokens will be held at this username.");
        console.log("  When '" + to + "' registers, they will own these tokens.");

        // Use a deterministic address from the username
        const addrHash = require("crypto").createHash("sha256").update("btcpc-username:" + to).digest("hex");
        const address = "BTCPC" + addrHash.slice(0, 40);

        // Check if we already have an unclaimed wallet for this username
        recipientWallet = await Wallet.findOne({ address: address, chain: "btcpc" });
        if (!recipientWallet) {
          recipientWallet = new Wallet({
            userId: null, // unclaimed — no user yet
            chain: "btcpc",
            address: address,
            publicKey: null,
            balance: new Map([["BTCPC", 0]])
          });
        }
      }

      // Sign the transaction with active key
      const txTimestamp = Date.now();
      const txData = {
        from: senderName,
        to: to,
        amount: amount,
        type: "transfer",
        timestamp: txTimestamp
      };
      const sig = keyManager.signTransaction(txData, activeKey);

      // Submit to mempool — validates balance, prevents double-spend
      const mempool = require("../src/p2p/mempool");
      const ledger = require("../src/services/ledger");
      const epoch = await ledger.getCurrentEpoch();

      const mempoolTx = {
        type: "TRANSFER",
        from: senderName,
        to: to,
        amount: amount,
        token: "BTCPC",
        epoch: epoch,
        nonce: txTimestamp,
        timestamp: txTimestamp,
        memo: null,
        signature: sig.signature
      };

      const mResult = mempool.submit(mempoolTx);
      if (!mResult.accepted) {
        console.error("error: transaction rejected by mempool: " + mResult.reason);
        await disconnect();
        process.exit(1);
      }

      // Record on permanent ledger — source of truth
      await ledger.recordTransfer(senderName, to, amount, "BTCPC", sig.signature, epoch, null);

      // Update wallet caches
      senderWallet.balance.set("BTCPC", balance - amount);
      await senderWallet.save();

      const recipBalance = recipientWallet.balance.get("BTCPC") || 0;
      recipientWallet.balance.set("BTCPC", recipBalance + amount);
      await recipientWallet.save();

      // Broadcast to P2P if network is available
      try {
        const p2p = require("../src/p2p/network");
        const { createTransactionMessage } = require("../src/p2p/protocol");
        if (p2p.NODE_ID) {
          const txMsg = createTransactionMessage(mempoolTx, p2p.NODE_ID);
          p2p.broadcast(txMsg);
          console.log("  Broadcast to P2P network.");
        }
      } catch (_) {
        console.log("  P2P not available — will propagate at next epoch finalization.");
      }

      console.log("");
      console.log("  Transfer complete.");
      console.log("");
      console.log("  From:    " + senderName);
      console.log("  To:      " + to);
      console.log("  Amount:  " + amount.toFixed(10) + " BTCPC");
      console.log("  TxHash:  " + mResult.txHash);
      console.log("  Sig:     " + sig.signature.slice(0, 20) + "...");
      console.log("  Epoch:   " + epoch);
      console.log("");
      console.log("  " + senderName + " balance: " + (balance - amount).toFixed(10) + " BTCPC");
      console.log("  " + to + " balance: " + (recipBalance + amount).toFixed(10) + " BTCPC");
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

