// --- network ---------------------------------------------------------------

program
  .command("network")
  .description("Show P2P network stats (peers, chain height, sync status)")
  .action(async () => {
    try {
      await connect();

      const currentEpochNum = await calcCurrentEpochNumber();

      // Count finalized epochs
      const finalizedCount = await Epoch.countDocuments({ status: "finalized" });
      const activeCount = await Epoch.countDocuments({ status: "active" });

      // Latest finalized epoch
      const latestFinalized = await Epoch.findOne({ status: "finalized" }).sort({ epoch_number: -1 });
      const latestFinalizedNum = latestFinalized ? latestFinalized.epoch_number : -1;

      // P2P config
      const p2pPort = process.env.P2P_PORT || 6942;
      const seedPeers = process.env.BTCPC_SEED_PEERS || "";
      const seedCount = seedPeers ? seedPeers.split(",").filter(Boolean).length : 0;
      const nodeId = process.env.BTCPC_NODE_ID || "(auto-generated)";

      // Sync status
      const isSynced = latestFinalizedNum >= currentEpochNum - 1;
      const syncStatus = isSynced ? "synced" : "behind (" + (currentEpochNum - latestFinalizedNum - 1) + " epochs)";

      console.log("");
      console.log("BTCPC Network");
      console.log("=============");
      console.log("");
      console.log("  Node ID:             " + nodeId);
      console.log("  P2P Port:            " + p2pPort);
      console.log("  Seed Peers:          " + seedCount);
      console.log("");
      console.log("  Chain Height:        " + formatNumber(latestFinalizedNum));
      console.log("  Current Epoch:       " + formatNumber(currentEpochNum));
      console.log("  Finalized Epochs:    " + formatNumber(finalizedCount));
      console.log("  Active Epochs:       " + formatNumber(activeCount));
      console.log("  Sync Status:         " + syncStatus);
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- inference -------------------------------------------------------------

program
  .command("inference <prompt>")
  .description("Run inference through any supported provider (42% rule for external)")
  .option("--provider <name>", "inference provider", "btcpc")
  .option("--model <model>", "model name (provider-specific)")
  .option("--temperature <n>", "sampling temperature", parseFloat)
  .option("--max-tokens <n>", "max tokens to generate", parseInt)
  .action(async (prompt, opts) => {
    try {
      const providerName = opts.provider;
      const provider = getProvider(providerName);
      const model = opts.model || (providerName === "btcpc" ? DEFAULT_MODEL : undefined);
      const isExternal = providerName !== "btcpc";

      const options = {
        temperature: opts.temperature,
        maxTokens: opts.maxTokens
      };

      const headers = provider.getHeaders();
      const body = provider.formatRequest(prompt, model, options);

      console.log("");
      console.log("BTCPC Inference");
      console.log("===============");
      console.log("");
      console.log("  Provider:  " + providerName);
      console.log("  Model:     " + (model || body.model || "(provider default)"));
      console.log("  Prompt:    " + (prompt.length > 60 ? prompt.substring(0, 57) + "..." : prompt));
      console.log("");
      console.log("  Sending request...");

      const startTime = Date.now();

      const response = await axios.post(provider.baseUrl, body, {
        headers: headers,
        timeout: 180000
      });

      const elapsed = Date.now() - startTime;
      const parsed = provider.parseResponse(response.data);

      // -- Compute BTCPC reward (42% rule for external providers) -----------
      const userRate = isExternal ? 0.42 : 1.0;
      const btcpcEarned = (parsed.completion_tokens / 100 * 0.001 * userRate);

      // -- Build provider receipt for on-chain logging ----------------------
      const promptHash = crypto
        .createHash("sha256")
        .update(prompt)
        .digest("hex");
      const resultHash = crypto
        .createHash("sha256")
        .update(parsed.content)
        .digest("hex");

      // -- Log WorkProof on-chain (best-effort) -----------------------------
      let proofId = null;
      let onChain = false;
      try {
        await connect();
        const WorkProof = require("../src/models/WorkProof");
        const { getCurrentEpoch } = require("../src/services/epochManager");
        const { getModelWeight } = require("../src/mining/workGenerator");

        const epochNumber = await getCurrentEpoch();
        const weightFactor = getModelWeight(parsed.model);
        const workValue = parsed.completion_tokens * weightFactor;

        const proof = new WorkProof({
          epoch_number: epochNumber,
          node_id: isExternal
            ? "external-" + providerName
            : "inference-cli",
          prompt_hash: promptHash,
          result_hash: resultHash,
          model: parsed.model,
          tokens_generated: parsed.completion_tokens,
          model_weight_factor: weightFactor,
          work_value: workValue
        });
        const saved = await proof.save();
        proofId = saved._id.toString();
        onChain = true;
        await disconnect();
      } catch (_dbErr) {
        // Chain may not be running -- still show the result
        proofId = crypto
          .createHash("sha256")
          .update(promptHash + resultHash + Date.now().toString())
          .digest("hex");
      }

      // -- Display results --------------------------------------------------
      console.log("");
      console.log("  Response");
      console.log("  --------");
      console.log("");

      // Word-wrap the content at ~78 cols, indented 4 spaces
      const lines = parsed.content.split("\n");
      for (const line of lines) {
        if (line.length <= 74) {
          console.log("    " + line);
        } else {
          const words = line.split(" ");
          let cur = "";
          for (const w of words) {
            if (cur.length + w.length + 1 > 74) {
              console.log("    " + cur);
              cur = w;
            } else {
              cur = cur ? cur + " " + w : w;
            }
          }
          if (cur) console.log("    " + cur);
        }
      }

      console.log("");
      console.log("  Receipt");
      console.log("  -------");
      console.log("  Provider:            " + providerName);
      console.log("  Model:               " + parsed.model);
      console.log("  Request ID:          " + (parsed.request_id || "(none)"));
      console.log("  Tokens used:         " + formatNumber(parsed.tokens_used));
      console.log("    Prompt tokens:     " + formatNumber(parsed.prompt_tokens));
      console.log("    Completion tokens: " + formatNumber(parsed.completion_tokens));
      console.log("  Elapsed:             " + elapsed + "ms");
      console.log("");
      console.log("  On-Chain");
      console.log("  --------");
      console.log("  Proof ID:            " + (proofId || "-"));
      console.log("  Logged on-chain:     " + (onChain ? "yes" : "no (chain unavailable)"));
      console.log("  Reward rate:         " + (isExternal ? "42% (external provider)" : "100% (native compute)"));
      console.log("  BTCPC earned:        " + btcpcEarned.toFixed(8) + " BTCPC");
      console.log("");
    } catch (err) {
      if (err.response && err.response.data) {
        const errData = err.response.data;
        const msg = errData.error
          ? (errData.error.message || JSON.stringify(errData.error))
          : JSON.stringify(errData);
        console.error("error: " + opts.provider + " API returned: " + msg);
      } else {
        console.error("error: " + err.message);
      }
      process.exit(1);
    }
  });

// --- delegate --------------------------------------------------------------

program
  .command("delegate <amount>")
  .description("Delegate BTCPC to a miner")
  .requiredOption("--to <miner>", "Miner username to delegate to")
  .action(async (amount, opts) => {
    try {
      await connect();

      const delegateAmount = parseFloat(amount);
      if (isNaN(delegateAmount) || delegateAmount <= 0) {
        console.error("error: invalid amount");
        await disconnect();
        process.exit(1);
      }

      const minerUsername = opts.to;
      const minerUser = await User.findOne({ username: minerUsername });
      if (!minerUser) {
        console.error("error: miner '" + minerUsername + "' not found");
        await disconnect();
        process.exit(1);
      }

      // Verify miner has a registered node
      const minerNode = await Node.findOne({
        account: minerUser._id,
        status: { $in: ["registered", "active"] }
      });
      if (!minerNode) {
        console.error("error: '" + minerUsername + "' is not a registered miner");
        await disconnect();
        process.exit(1);
      }

      // Use default account (shindevlin) for CLI delegation
      const defaultUser = await User.findOne({ username: "shindevlin" });
      if (!defaultUser) {
        console.error("error: default account 'shindevlin' not found");
        await disconnect();
        process.exit(1);
      }

      if (String(defaultUser._id) === String(minerUser._id)) {
        console.error("error: cannot delegate to yourself");
        await disconnect();
        process.exit(1);
      }

      const wallet = await Wallet.findOne({ userId: defaultUser._id });
      if (!wallet) {
        console.error("error: wallet not found");
        await disconnect();
        process.exit(1);
      }

      const btcpcBalance = wallet.balance.get("BTCPC") || 0;
      if (btcpcBalance < delegateAmount) {
        console.error("error: insufficient BTCPC balance (" + formatBTCPC(btcpcBalance) + " available)");
        await disconnect();
        process.exit(1);
      }

      // Check for existing active delegation
      let delegation = await Delegation.findOne({
        delegator: defaultUser._id,
        miner: minerUser._id,
        status: "active"
      });

      if (delegation) {
        delegation.amount += delegateAmount;
        delegation.delegated_at = new Date();
      } else {
        delegation = new Delegation({
          delegator: defaultUser._id,
          miner: minerUser._id,
          amount: delegateAmount,
          delegated_at: new Date(),
          status: "active"
        });
      }

      wallet.balance.set("BTCPC", btcpcBalance - delegateAmount);
      await wallet.save();
      await delegation.save();

      const tx = new Transaction({
        from: wallet.address,
        to: "delegation_pool",
        amount: delegateAmount,
        type: "delegation",
        memo: "BTCPC delegation to miner " + minerUsername
      });
      await tx.save();

      console.log("");
      console.log("Delegation Successful");
      console.log("=====================");
      console.log("");
      console.log("  Delegated:           " + formatBTCPC(delegateAmount) + " BTCPC");
      console.log("  To miner:            " + minerUsername);
      console.log("  Total delegated:     " + formatBTCPC(delegation.amount) + " BTCPC");
      console.log("  Wallet balance:      " + formatBTCPC(wallet.balance.get("BTCPC")) + " BTCPC");
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- undelegate ------------------------------------------------------------

program
  .command("undelegate <amount>")
  .description("Start undelegation (7-day unlock period)")
  .requiredOption("--from <miner>", "Miner username to undelegate from")
  .action(async (amount, opts) => {
    try {
      await connect();

      const undelegateAmount = parseFloat(amount);
      if (isNaN(undelegateAmount) || undelegateAmount <= 0) {
        console.error("error: invalid amount");
        await disconnect();
        process.exit(1);
      }

      const minerUsername = opts.from;
      const minerUser = await User.findOne({ username: minerUsername });
      if (!minerUser) {
        console.error("error: miner '" + minerUsername + "' not found");
        await disconnect();
        process.exit(1);
      }

      const defaultUser = await User.findOne({ username: "shindevlin" });
      if (!defaultUser) {
        console.error("error: default account 'shindevlin' not found");
        await disconnect();
        process.exit(1);
      }

      const delegation = await Delegation.findOne({
        delegator: defaultUser._id,
        miner: minerUser._id,
        status: "active"
      });

      if (!delegation) {
        console.error("error: no active delegation to '" + minerUsername + "'");
        await disconnect();
        process.exit(1);
      }

      if (undelegateAmount > delegation.amount) {
        console.error("error: amount exceeds delegated balance (" + formatBTCPC(delegation.amount) + " BTCPC)");
        await disconnect();
        process.exit(1);
      }

      const now = new Date();
      const unlockDate = new Date(now);
      unlockDate.setDate(unlockDate.getDate() + 7);

      if (undelegateAmount < delegation.amount) {
        // Partial undelegation
        const remaining = delegation.amount - undelegateAmount;
        delegation.amount = remaining;
        await delegation.save();

        const undelegation = new Delegation({
          delegator: defaultUser._id,
          miner: minerUser._id,
          amount: undelegateAmount,
          delegated_at: delegation.delegated_at,
          status: "undelegating",
          undelegate_requested_at: now,
          undelegate_available_at: unlockDate
        });
        await undelegation.save();
      } else {
        delegation.status = "undelegating";
        delegation.undelegate_requested_at = now;
        delegation.undelegate_available_at = unlockDate;
        await delegation.save();
      }

      console.log("");
      console.log("Undelegation Started");
      console.log("====================");
      console.log("");
      console.log("  Amount:              " + formatBTCPC(undelegateAmount) + " BTCPC");
      console.log("  From miner:          " + minerUsername);
      console.log("  Unlock requested:    " + ts(now));
      console.log("  Available at:        " + ts(unlockDate));
      console.log("  Unlock period:       7 days");
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- delegations -----------------------------------------------------------

program
  .command("delegations [account]")
  .description("List delegations for an account")
  .action(async (account) => {
    try {
      await connect();

      const username = account || "shindevlin";
      const user = await User.findOne({ username });
      if (!user) {
        console.error("error: account '" + username + "' not found");
        await disconnect();
        process.exit(1);
      }

      // Delegations made by this account
      const outgoing = await Delegation.find({
        delegator: user._id,
        status: { $in: ["active", "undelegating"] }
      }).populate("miner", "username");

      // Delegations received by this account (if they are a miner)
      const incoming = await Delegation.find({
        miner: user._id,
        status: "active"
      }).populate("delegator", "username");

      const totalOutgoing = outgoing
        .filter(function (d) { return d.status === "active"; })
        .reduce(function (sum, d) { return sum + d.amount; }, 0);
      const totalIncoming = incoming.reduce(function (sum, d) { return sum + d.amount; }, 0);

      console.log("");
      console.log("Delegations: " + username);
      console.log("=".repeat(17 + username.length));
      console.log("");

      if (outgoing.length > 0) {
        console.log("  Outgoing Delegations (delegated to miners)");
        console.log("  ------------------------------------------");
        var hdr = ["Miner", "Amount", "Status", "Delegated"];
        var w = [16, 24, 14, 24];
        var a = [false, true, false, false];
        printRow(hdr, w, a);
        printSep(w);
        for (var i = 0; i < outgoing.length; i++) {
          var d = outgoing[i];
          var minerName = d.miner ? d.miner.username : String(d.miner);
          var statusStr = d.status;
          if (d.status === "undelegating" && d.undelegate_available_at) {
            var remaining = Math.ceil((d.undelegate_available_at - new Date()) / (1000 * 60 * 60 * 24));
            statusStr = "unlock " + remaining + "d";
          }
          printRow([minerName, formatBTCPC(d.amount) + " BTCPC", statusStr, ts(d.delegated_at)], w, a);
        }
        console.log("");
        console.log("  Total delegated:     " + formatBTCPC(totalOutgoing) + " BTCPC");
        console.log("");
      } else {
        console.log("  No outgoing delegations.");
        console.log("");
      }

      if (incoming.length > 0) {
        console.log("  Incoming Delegations (received from delegators)");
        console.log("  -----------------------------------------------");
        var hdr2 = ["Delegator", "Amount", "Delegated"];
        var w2 = [16, 24, 24];
        var a2 = [false, true, false];
        printRow(hdr2, w2, a2);
        printSep(w2);
        for (var j = 0; j < incoming.length; j++) {
          var del = incoming[j];
          var delegatorName = del.delegator ? del.delegator.username : String(del.delegator);
          printRow([delegatorName, formatBTCPC(del.amount) + " BTCPC", ts(del.delegated_at)], w2, a2);
        }
        console.log("");
        console.log("  Total received:      " + formatBTCPC(totalIncoming) + " BTCPC");
        console.log("");
      } else {
        console.log("  No incoming delegations.");
        console.log("");
      }

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- claims ----------------------------------------------------------------

const CrossChainClaim = require("../src/models/CrossChainClaim");
const { generateClaimProof, getCrossChainRatio } = require("../src/claims/claimProofGenerator");

program
  .command("claims [account]")
  .description("Show pending and submitted cross-chain claims")
  .action(async (account) => {
    try {
      await connect();

      const username = account || "shindevlin";
      const claims = await CrossChainClaim.find({ miner: username }).sort({ epoch: -1 });

      if (claims.length === 0) {
        console.log("\n  No cross-chain claims found for " + username + ".\n");
        await disconnect();
        return;
      }

      // Separate by status
      const generated = claims.filter(function (c) { return c.status === "generated"; });
      const submitted = claims.filter(function (c) { return c.status === "submitted" || c.status === "confirmed"; });
      const failed = claims.filter(function (c) { return c.status === "failed"; });

      console.log("");
      console.log("Cross-Chain Claims: " + username);
      console.log("=".repeat(25 + username.length));
      console.log("");
      console.log("  Total claims:    " + formatNumber(claims.length));
      console.log("  Pending:         " + formatNumber(generated.length));
      console.log("  Submitted:       " + formatNumber(submitted.length));
      console.log("  Failed:          " + formatNumber(failed.length));
      console.log("");

      // Show pending claims grouped by chain
      if (generated.length > 0) {
        console.log("  Pending Claims");
        console.log("  --------------");

        var hdr = ["Epoch", "Chain", "Amount", "Period", "Ratio", "Created"];
        var w = [8, 8, 22, 7, 10, 24];
        var a = [true, false, true, true, true, false];
        printRow(hdr, w, a);
        printSep(w);

        var display = generated.slice(0, 20);
        for (var ci = 0; ci < display.length; ci++) {
          var c = display[ci];
          printRow([
            String(c.epoch),
            c.chain,
            c.claim_amount + " wBTCPC",
            String(c.period),
            c.cross_chain_ratio,
            ts(c.created_at)
          ], w, a);
        }

        if (generated.length > 20) {
          console.log("  ... and " + (generated.length - 20) + " more");
        }
        console.log("");
      }

      // Show submitted claims
      if (submitted.length > 0) {
        console.log("  Submitted Claims");
        console.log("  ----------------");

        var hdr2 = ["Epoch", "Chain", "Amount", "TX Hash", "Submitted"];
        var w2 = [8, 8, 22, 20, 24];
        var a2 = [true, false, true, false, false];
        printRow(hdr2, w2, a2);
        printSep(w2);

        var display2 = submitted.slice(0, 20);
        for (var si = 0; si < display2.length; si++) {
          var s = display2[si];
          var txDisplay = s.tx_hash ? s.tx_hash.slice(0, 18) + ".." : "-";
          printRow([
            String(s.epoch),
            s.chain,
            s.claim_amount + " wBTCPC",
            txDisplay,
            ts(s.submitted_at)
          ], w2, a2);
        }
        console.log("");
      }

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- claim -----------------------------------------------------------------

program
  .command("claim")
  .description("Submit a cross-chain claim for a specific epoch")
  .requiredOption("--chain <chain>", "Target chain (base, hive)")
  .requiredOption("--epoch <epoch>", "Epoch number to claim")
  .action(async (opts) => {
    try {
      await connect();

      var chain = opts.chain.toLowerCase();
      var epochNum = parseInt(opts.epoch);

      if (isNaN(epochNum) || epochNum < 0) {
        console.error("error: invalid epoch number");
        await disconnect();
        process.exit(1);
      }

      var supportedChains = ["base", "hive"];
      if (supportedChains.indexOf(chain) === -1) {
        console.error("error: unsupported chain '" + chain + "'. Supported: " + supportedChains.join(", "));
        await disconnect();
        process.exit(1);
      }

      // Find the claim proof
      var claim = await CrossChainClaim.findOne({
        epoch: epochNum,
        chain: chain
      });

      if (!claim) {
        // Check if the epoch exists and was finalized
        var epoch = await Epoch.findOne({ epoch_number: epochNum });
        if (!epoch) {
          console.error("error: epoch " + epochNum + " not found");
        } else if (epoch.status !== "finalized") {
          console.error("error: epoch " + epochNum + " not yet finalized (status: " + epoch.status + ")");
        } else {
          console.error("error: no cross-chain claim proof found for epoch " + epochNum + " on " + chain);
          console.error("       ensure a wallet is linked for this chain on the mining node");
        }
        await disconnect();
        process.exit(1);
      }

      if (claim.status === "submitted" || claim.status === "confirmed") {
        console.log("");
        console.log("  Claim already submitted for epoch " + epochNum + " on " + chain);
        console.log("  TX: " + (claim.tx_hash || "-"));
        console.log("  Status: " + claim.status);
        console.log("");
        await disconnect();
        return;
      }

      console.log("");
      console.log("Cross-Chain Claim");
      console.log("=================");
      console.log("");
      console.log("  Chain:           " + chain);
      console.log("  Epoch:           " + epochNum);
      console.log("  Amount:          " + claim.claim_amount + " wBTCPC");
      console.log("  Period:          " + claim.period);
      console.log("  Ratio:           " + claim.cross_chain_ratio);
      console.log("  Target wallet:   " + claim.target_wallet);
      console.log("  Proof signature: " + claim.proof_signature.slice(0, 32) + "...");
      console.log("");

      if (chain === "hive") {
        var hiveKey = process.env.HIVE_POSTING_KEY;
        var hiveAccount = process.env.HIVE_ACCOUNT;
        if (!hiveKey || !hiveAccount) {
          console.error("  error: HIVE_POSTING_KEY and HIVE_ACCOUNT must be set in .env");
          console.log("  Claim proof is ready. Set env vars and re-run to submit.");
          console.log("");
          await disconnect();
          process.exit(1);
        }

        var hiveClaimManager = require("../src/claims/hiveClaimManager");
        console.log("  Submitting to Hive...");
        var result = await hiveClaimManager.postClaimToHive(
          {
            miner: claim.miner,
            epoch: claim.epoch,
            amount: claim.claim_amount,
            period: claim.period,
            cross_chain_ratio: claim.cross_chain_ratio,
            proof_signature: claim.proof_signature,
            timestamp: claim.created_at.toISOString()
          },
          hiveAccount,
          hiveKey
        );

        if (result.status === "broadcast") {
          claim.status = "submitted";
          claim.tx_hash = result.tx_id;
          claim.submitted_at = new Date();
          await claim.save();
          console.log("  Hive TX: " + result.tx_id);
          console.log("  Status: submitted");
        } else {
          console.error("  Submission failed: " + (result.error || "unknown error"));
        }
      } else if (chain === "base") {
        console.log("  EVM claim submission requires a web3 wallet.");
        console.log("  Use the proof data below with the wBTCPC contract:");
        console.log("");
        console.log("  Contract call: claim(" + epochNum + ", " + claim.claim_amount + ", miner, signature)");
        console.log("  Proof signature: " + claim.proof_signature);
        console.log("");
        console.log("  To submit via CLI, set BASE_RPC_URL and BASE_PRIVATE_KEY in .env");
      }

      console.log("");
      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- recover ---------------------------------------------------------------

program
  .command("recover <account>")
  .description("Submit an account recovery request using the Owner key (bypasses 2FA, 72h time-lock)")
  .option("--new-2fa-key <key>", "New 2FA public key to set after recovery completes")
  .action(async (account, opts) => {
    try {
      var baseUrl = process.env.API_URL || ("http://localhost:" + (process.env.PORT || 3000));
      var body = {
        account: account,
        owner_signature: "cli-owner-sig-" + Date.now()
      };
      if (opts.new2faKey) {
        body.new_2fa_public_key = opts.new2faKey;
      }

      var resp = await axios.post(baseUrl + "/api/recovery/request", body);
      var data = resp.data;

      console.log("");
      console.log("  BTCPC Account Recovery");
      console.log("  =====================");
      console.log("");
      console.log("  Account:       " + data.account);
      console.log("  Status:        " + data.status);
      console.log("  Requested:     " + ts(data.requested_at));
      console.log("  Expires:       " + ts(data.expires_at));
      console.log("  Recovery ID:   " + data.recovery_id);
      console.log("");
      console.log("  " + data.message);
      console.log("");
    } catch (err) {
      if (err.response && err.response.data) {
        console.error("error:", err.response.data.error || err.response.data);
      } else {
        console.error("error:", err.message);
      }
      process.exit(1);
    }
  });

