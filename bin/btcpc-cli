// --- wallet rotate-keys ----------------------------------------------------

walletCmd
  .command("rotate-keys <username>")
  .description("Rotate active, posting, and memo keys — authenticated by password")
  .action(async (username) => {
    try {
      console.log("");
      console.log("Key Rotation for '" + username + "'");
      console.log("=".repeat(20 + username.length));
      console.log("");
      console.log("  This will replace your active, posting, and memo keys with newly");
      console.log("  generated random keys. Your owner key is NOT touched.");
      console.log("  You must save the new private keys shown below — they are shown ONCE.");
      console.log("");

      const password = await prompt("  Enter password: ", true);
      if (!password) {
        console.error("  error: password required");
        process.exit(1);
      }

      const secretStoreLocal = require("../src/services/secretStore");
      await secretStoreLocal.load();

      // Verify password locally
      const valid = await secretStoreLocal.verifyPassword(username, password);
      if (!valid) {
        console.error("  error: invalid password");
        process.exit(1);
      }

      // Verify account exists on chain
      const onChainAccount = stateStore.getAccount ? stateStore.getAccount(username) : null;
      if (!onChainAccount) {
        console.error("  error: account '" + username + "' not found on chain");
        process.exit(1);
      }

      console.log("");
      console.log("  Generating new active, posting, and memo keys...");
      console.log("");

      // Generate 3 new random secp256k1 keypairs
      const secp256k1 = require("secp256k1");
      function generateRandomKeypair() {
        let privKey;
        do { privKey = crypto.randomBytes(32); } while (!secp256k1.privateKeyVerify(privKey));
        const pubKey = Buffer.from(secp256k1.publicKeyCreate(privKey, true));
        return { privateKey: privKey.toString("hex"), publicKey: pubKey.toString("hex") };
      }

      const activeKp  = generateRandomKeypair();
      const postingKp = generateRandomKeypair();
      const memoKp    = generateRandomKeypair();

      const newPublicKeys = {
        active:  activeKp.publicKey,
        posting: postingKp.publicKey,
        memo:    memoKp.publicKey,
      };

      // Record on chain
      const epoch = stateStore.getChainHeight ? stateStore.getChainHeight() : 0;
      await ledger.recordKeyRotate(username, newPublicKeys, "password", epoch);

      console.log("  New Private Keys (SAVE THESE NOW — shown only once):");
      console.log("");
      console.log("    Active:  " + activeKp.privateKey);
      console.log("    Posting: " + postingKp.privateKey);
      console.log("    Memo:    " + memoKp.privateKey);
      console.log("");
      console.log("  New Public Keys (recorded on chain):");
      console.log("");
      console.log("    Active:  " + activeKp.publicKey);
      console.log("    Posting: " + postingKp.publicKey);
      console.log("    Memo:    " + memoKp.publicKey);
      console.log("");
      console.log("  Rotation recorded on chain. Old keys are now invalid.");
      console.log("");

      const keep = await prompt("  Keep old keys in Telegram chat history? (yes to keep, no to warn): ");
      if (!keep || keep.trim().toLowerCase().startsWith("n")) {
        console.log("");
        console.log("  WARNING: If you stored old keys in Telegram or any cloud chat,");
        console.log("  those messages still exist on Telegram's servers even if deleted");
        console.log("  from your view. Consider this when assessing risk.");
        console.log("");
      }
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet rotate-owner ---------------------------------------------------

walletCmd
  .command("rotate-owner <username>")
  .description("Rotate the owner key — requires current owner private key (signs locally)")
  .action(async (username) => {
    try {
      console.log("");
      console.log("OWNER KEY ROTATION for '" + username + "'");
      console.log("=".repeat(24 + username.length));
      console.log("");
      console.log("  WARNING: This is the nuclear option. The owner key controls");
      console.log("  everything. If you lose the new owner key, account recovery");
      console.log("  is extremely difficult.");
      console.log("");
      console.log("  Your current owner PRIVATE key is used to sign the rotation");
      console.log("  locally. It never leaves this machine.");
      console.log("");

      const ownerPrivHex = await prompt("  Enter your CURRENT owner private key (hex): ", true);
      if (!ownerPrivHex || ownerPrivHex.trim().length < 64) {
        console.error("  error: owner private key required (64+ hex chars)");
        process.exit(1);
      }

      // Derive the public key from the entered private key
      const secp256k1 = require("secp256k1");
      let currentOwnerPrivBuf;
      try {
        currentOwnerPrivBuf = Buffer.from(ownerPrivHex.trim(), "hex");
        if (!secp256k1.privateKeyVerify(currentOwnerPrivBuf)) {
          throw new Error("invalid secp256k1 private key");
        }
      } catch (e) {
        console.error("  error: " + e.message);
        process.exit(1);
      }
      const derivedOwnerPub = Buffer.from(secp256k1.publicKeyCreate(currentOwnerPrivBuf, true)).toString("hex");

      // Compare against on-chain owner key
      const onChainAccount = stateStore.getAccount ? stateStore.getAccount(username) : null;
      if (!onChainAccount || !onChainAccount.public_keys || !onChainAccount.public_keys.owner) {
        console.error("  error: account '" + username + "' not found or has no owner key on chain");
        process.exit(1);
      }

      if (onChainAccount.public_keys.owner !== derivedOwnerPub) {
        console.error("  error: entered private key does NOT match on-chain owner key");
        console.error("  On-chain:  " + onChainAccount.public_keys.owner.slice(0, 20) + "...");
        console.error("  Derived:   " + derivedOwnerPub.slice(0, 20) + "...");
        process.exit(1);
      }
      console.log("");
      console.log("  Current owner key verified against on-chain key.");
      console.log("");
      console.log("  Generating new owner keypair...");
      console.log("");

      // Generate new owner keypair
      let newOwnerPrivBuf;
      do { newOwnerPrivBuf = crypto.randomBytes(32); } while (!secp256k1.privateKeyVerify(newOwnerPrivBuf));
      const newOwnerPubHex  = Buffer.from(secp256k1.publicKeyCreate(newOwnerPrivBuf, true)).toString("hex");
      const newOwnerPrivHex = newOwnerPrivBuf.toString("hex");

      // Build challenge and sign with CURRENT owner key
      const timestamp = Date.now().toString();
      const challengeInput = username + newOwnerPubHex + timestamp;
      const challenge = crypto.createHash("sha256").update(challengeInput).digest("hex");
      const challengeHashBuf = crypto.createHash("sha256").update(challenge).digest();

      const sigObj = secp256k1.ecdsaSign(challengeHashBuf, currentOwnerPrivBuf);
      const signature = Buffer.from(sigObj.signature).toString("hex");

      // Record on chain
      const epoch = stateStore.getChainHeight ? stateStore.getChainHeight() : 0;
      await ledger.recordKeyRotate(username, { owner: newOwnerPubHex }, "owner_signature", epoch);

      console.log("  New Owner Private Key (SAVE THIS NOW — shown only once):");
      console.log("");
      console.log("    " + newOwnerPrivHex);
      console.log("");
      console.log("  New Owner Public Key (recorded on chain):");
      console.log("");
      console.log("    " + newOwnerPubHex);
      console.log("");
      console.log("  DONE. Old owner key is now invalid.");
      console.log("  SAVE YOUR NEW OWNER KEY IMMEDIATELY.");
      console.log("");

      // Wipe old private key from memory
      currentOwnerPrivBuf.fill(0);
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet export ---------------------------------------------------------

walletCmd
  .command("export <username>")
  .description("Export encrypted wallet file for a BTCPC account")
  .action(async (username) => {
    try {
      await connect();

      const user = await User.findOne({ username: username });
      if (!user) {
        console.error("error: account '" + username + "' not found");
        await disconnect();
        process.exit(1);
      }

      const exportAccountState = stateStore.getAccount ? stateStore.getAccount(username) : null;
      const exportAddress = exportAccountState?.chain_addresses?.btcpc || null;

      console.log("");
      const password = await prompt("  Enter encryption password: ", true);
      if (!password || password.length < 8) {
        console.error("error: password must be at least 8 characters");
        await disconnect();
        process.exit(1);
      }

      // Build wallet export payload (public keys only — private keys are NEVER stored)
      const exportData = {
        version: 1,
        chain: "btcpc",
        username: username,
        address: exportAddress,
        publicKeys: {
          owner: user.ownerPublicKey,
          active: user.activePublicKey,
          posting: user.postingPublicKey,
          memo: user.memoPublicKey
        },
        authProfile: user.authProfile || "none",
        twoFactorPublicKey: user.twoFactorPublicKey || null,
        exportedAt: new Date().toISOString()
      };

      // Encrypt the export payload
      const plaintext = JSON.stringify(exportData);
      const encrypted = await keyManager.encryptKey(
        Buffer.from(plaintext).toString("hex"),
        password
      );

      const filename = username + "-btcpc-wallet.enc";
      const filepath = path.resolve(process.cwd(), filename);
      fs.writeFileSync(filepath, encrypted, "utf8");

      console.log("");
      console.log("  Wallet exported to: " + filepath);
      console.log("  Encrypted with AES-256-GCM (PBKDF2 key derivation)");
      console.log("  Keep this file and your password safe.");
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet send -----------------------------------------------------------

walletCmd
  .command("send <to> <amount>")
  .description("Send BTCPC to another account (requires active key)")
  .action(async (to, amount) => {
    try {
      amount = parseFloat(amount);
      if (isNaN(amount) || amount <= 0) {
        console.error("error: amount must be a positive number");
        process.exit(1);
      }

      // Get sender from env or prompt
      const senderName = process.env.BTCPC_MINER || process.env.BTCPC_USERNAME;
      if (!senderName) {
        console.error("error: set BTCPC_MINER or BTCPC_USERNAME env var");
        process.exit(1);
      }

      const activeKey = process.env.BTCPC_ACTIVE_KEY;
      if (!activeKey) {
        console.error("error: set BTCPC_ACTIVE_KEY env var (64-char hex private key)");
        process.exit(1);
      }

      // Verify sender exists on chain (stateStore is source of truth — no Mongo)
      await stateStore.replayIfNeeded ? stateStore.replayIfNeeded() : null;
      const senderAcct = stateStore.getAccount ? stateStore.getAccount(senderName) : null;
      if (!senderAcct) {
        console.error("error: sender account '" + senderName + "' not found on chain");
        process.exit(1);
      }

      // Verify active key matches chain-registered key
      const secp256k1 = require("secp256k1");
      const activePub = Buffer.from(secp256k1.publicKeyCreate(Buffer.from(activeKey, "hex"), true)).toString("hex");
      const chainActiveKey = senderAcct.public_keys && senderAcct.public_keys.active;
      if (chainActiveKey && activePub !== chainActiveKey) {
        console.error("error: active key does not match chain-registered key for '" + senderName + "'");
        process.exit(1);
      }

      // Balance from stateStore (chain)
      const balance = stateStore.getBalance(senderName, "BTCPC");
      if (balance < amount) {
        console.error("error: insufficient balance. Have " + balance.toFixed(10) + ", need " + amount.toFixed(10));
        process.exit(1);
      }

      // Recipient existence check from chain — forward-send allowed if unregistered
      const recipientAcct = stateStore.getAccount ? stateStore.getAccount(to) : null;
      if (!recipientAcct) {
        console.log("  '" + to + "' is not yet registered on chain. Tokens will be held at this username.");
        console.log("  When '" + to + "' registers, they will own these tokens.");
      }

      // Sign the transaction with active key
      const txTimestamp = Date.now();
      const txData = {
        from: senderName,
        to: to,
        amount: amount,
        type: "transfer",
        timestamp: txTimestamp
      };
      const sig = keyManager.signTransaction(txData, activeKey);

      // Submit to mempool — validates balance, prevents double-spend
      const mempool = require("../src/p2p/mempool");
      const ledger = require("../src/services/ledger");
      const epoch = await ledger.getCurrentEpoch();

      const mempoolTx = {
        type: "TRANSFER",
        from: senderName,
        to: to,
        amount: amount,
        token: "BTCPC",
        epoch: epoch,
        nonce: txTimestamp,
        timestamp: txTimestamp,
        memo: null,
        signature: sig.signature
      };

      const mResult = mempool.submit(mempoolTx);
      if (!mResult.accepted) {
        console.error("error: transaction rejected by mempool: " + mResult.reason);
        await disconnect();
        process.exit(1);
      }

      // Record on permanent ledger — source of truth
      await ledger.recordTransfer(senderName, to, amount, "BTCPC", sig.signature, epoch, null);

      // Phase E: wallet cache updates removed — ledger is source of truth

      // Broadcast to P2P if network is available
      try {
        const p2p = require("../src/p2p/network");
        const { createTransactionMessage } = require("../src/p2p/protocol");
        if (p2p.NODE_ID) {
          const txMsg = createTransactionMessage(mempoolTx, p2p.NODE_ID);
          p2p.broadcast(txMsg);
          console.log("  Broadcast to P2P network.");
        }
      } catch (_) {
        console.log("  P2P not available — will propagate at next epoch finalization.");
      }

      console.log("");
      console.log("  Transfer complete.");
      console.log("");
      console.log("  From:    " + senderName);
      console.log("  To:      " + to);
      console.log("  Amount:  " + amount.toFixed(10) + " BTCPC");
      console.log("  TxHash:  " + mResult.txHash);
      console.log("  Sig:     " + sig.signature.slice(0, 20) + "...");
      console.log("  Epoch:   " + epoch);
      console.log("");
      console.log("  " + senderName + " balance: " + (balance - amount).toFixed(10) + " BTCPC");
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet balance --------------------------------------------------------

walletCmd
  .command("balance [username]")
  .description("Check BTCPC balance for an account")
  .action(async (username) => {
    try {
      const name = username || process.env.BTCPC_MINER || process.env.BTCPC_USERNAME;
      if (!name) {
        console.error("error: provide username or set BTCPC_MINER env var");
        process.exit(1);
      }

      // Chain is source of truth — no Mongo
      const walletAccountState = stateStore.getAccount ? stateStore.getAccount(name) : null;
      if (!walletAccountState) {
        console.error("error: account '" + name + "' not found on chain");
        process.exit(1);
      }
      const chainAddresses = walletAccountState?.chain_addresses || {};
      const btcpcBal = stateStore.getBalance(name, "BTCPC");

      console.log("");
      console.log("  " + name + " wallets:");
      console.log("");
      for (const [chain, addr] of Object.entries(chainAddresses)) {
        console.log("  " + chain.padEnd(10) + " " + addr);
      }
      if (btcpcBal > 0) console.log("             " + btcpcBal.toFixed(10) + " BTCPC");
      console.log("");
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- sign-challenge --------------------------------------------------------

program
  .command("sign-challenge <challenge>")
  .description("Sign a Telegram verification challenge with your posting key")
  .action(async (challenge) => {
    try {
      if (!challenge.startsWith("BTCPC-VERIFY-")) {
        console.error("error: challenge must start with BTCPC-VERIFY-");
        process.exit(1);
      }

      const postingKey = await prompt("  Enter your posting private key (hex): ");
      if (!postingKey || postingKey.trim().length !== 64) {
        console.error("error: posting key must be a 64-character hex string");
        process.exit(1);
      }

      const { signTransaction } = keyManager;
      const result = signTransaction(challenge, postingKey.trim());

      console.log("");
      console.log("  Challenge signed successfully.");
      console.log("");
      console.log("  Send this to the bot:");
      console.log("  /verify " + result.signature + ":" + result.recovery);
      console.log("");
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- dreams ----------------------------------------------------------------

const {
  getDreams: fetchDreams,
  getDream: fetchDream,
  inscribeDream,
  transferDream
} = require("../src/controllers/dreamController");

program
  .command("dreams [account]")
  .description("List all genesis dreams owned by an account")
  .action(async (account) => {
    try {
      await connect();

      const username = account || "shindevlin";
      const dreams = await fetchDreams(username);

      if (dreams.length === 0) {
        console.log("\n  No genesis dreams found for '" + username + "'.\n");
        await disconnect();
        return;
      }

      console.log("");
      console.log("Genesis Dreams: " + username + " (" + dreams.length + ")");
      console.log("=".repeat(25 + username.length));
      console.log("");

      const hdr = ["Block", "Inscription", "Status", "Original Miner", "Transferred"];
      const w = [7, 36, 12, 16, 12];
      const a = [true, false, false, false, false];

      printRow(hdr, w, a);
      printSep(w);

      for (const d of dreams) {
        const hasInscription = d.inscription && d.inscription.project && d.inscription.tag;
        const inscriptionTag = hasInscription
          ? d.inscription.tag.length > 34
            ? d.inscription.tag.substring(0, 31) + "..."
            : d.inscription.tag
          : "[uninscribed]";
        const status = hasInscription ? "inscribed" : "uninscribed";

        printRow([
          String(d.block_number),
          inscriptionTag,
          status,
          d.original_miner,
          d.transferred ? "yes" : "no"
        ], w, a);
      }
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- dream (single) -------------------------------------------------------

program
  .command("dream <block_number>")
  .description("View details of a specific genesis dream")
  .action(async (blockNumber) => {
    try {
      await connect();

      const num = parseInt(blockNumber);
      if (isNaN(num)) {
        console.error("error: invalid block number");
        await disconnect();
        process.exit(1);
      }

      const dream = await fetchDream(num);
      if (!dream) {
        console.error("error: Genesis Dream #" + num + " not found");
        await disconnect();
        process.exit(1);
      }

      const hasInscription = dream.inscription && dream.inscription.project && dream.inscription.tag;

      console.log("");
      console.log("Genesis Dream #" + dream.block_number);
      console.log("=".repeat(18 + String(dream.block_number).length));
      console.log("");
      console.log("  Block:             " + dream.block_number);
      console.log("  Original miner:    " + dream.original_miner);
      console.log("  Current owner:     " + dream.current_owner);
      console.log("  Transferred:       " + (dream.transferred ? "yes" : "no"));
      console.log("  Inscribed at:      " + ts(dream.inscribed_at));
      console.log("");

      // Proof
      if (dream.proof) {
        console.log("  Proof");
        console.log("  -----");
        console.log("  State hash:        " + (dream.proof.state_hash || "-"));
        console.log("  Work hash:         " + (dream.proof.work_hash || "-"));
        console.log("  Tokens computed:   " + formatNumber(dream.proof.tokens_computed || 0));
        console.log("  Model:             " + (dream.proof.model || "-"));
        console.log("");
      }

      // Inscription
      console.log("  Inscription");
      console.log("  -----------");
      if (hasInscription) {
        console.log("  Project:           " + dream.inscription.project);
        console.log("  Tag:               " + dream.inscription.tag);
        if (dream.inscription.custom_data) {
          console.log("  Custom data:       " + JSON.stringify(dream.inscription.custom_data));
        }
      } else {
        console.log("  [uninscribed]");
      }
      console.log("");

      // Transfer history
      if (dream.transfer_history && dream.transfer_history.length > 0) {
        console.log("  Transfer History");
        console.log("  ----------------");
        const thdr = ["From", "To", "Timestamp"];
        const tw = [16, 16, 26];
        printRow(thdr, tw);
        printSep(tw);
        for (const t of dream.transfer_history) {
          printRow([t.from, t.to, ts(t.timestamp)], tw);
        }
        console.log("");
      }

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

