const path = require("path");
require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

const { program } = require("commander");
const mongoose = require("mongoose");

// Phase E: chain-state models removed — use stateStore/nodeRegistry/ledger
const User = require("../src/models/User");
const stateStore = require("../src/chain/stateStore");
const nodeRegistry = require("../src/chain/nodeRegistry");
const ledger = require("../src/services/ledger");
const {
  getBlockReward,
  getCurrentPeriod,
  getPeriodTable,
  TOTAL_SUPPLY,
  EPOCHS_PER_MONTH
} = require("../src/services/emissionSchedule");
const { EPOCH_DURATION_MS, DIFFICULTY_ADJUSTMENT_INTERVAL } = require("../src/services/epochManager");
const keyManager = require("../src/wallet/keyManager");
const accountManager = require("../src/wallet/accountManager");
const { getProvider, listProviders, DEFAULT_MODEL, CODING_MODEL_PREFERENCE } = require("../src/inference/providers");
const axios = require("axios");
const readline = require("readline");
const fs = require("fs");
const crypto = require("crypto");

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

function formatBTCPC(n) {
  return Number(n).toLocaleString("en-US", {
    minimumFractionDigits: 8,
    maximumFractionDigits: 8
  });
}

function formatNumber(n) {
  return Number(n).toLocaleString("en-US");
}

function pad(str, len, alignRight) {
  str = String(str);
  if (alignRight) return str.padStart(len);
  return str.padEnd(len);
}

function printRow(cols, widths, alignments) {
  const cells = cols.map((c, i) => pad(c, widths[i], alignments && alignments[i]));
  console.log("  " + cells.join("  "));
}

function printSep(widths) {
  console.log("  " + widths.map(w => "-".repeat(w)).join("  "));
}

function ts(date) {
  if (!date) return "-";
  return new Date(date).toISOString().replace("T", " ").replace(/\.\d+Z$/, " UTC");
}

function pct(n, total) {
  if (!total) return "0.00%";
  return (n / total * 100).toFixed(2) + "%";
}

function durationStr(ms) {
  if (ms <= 0) return "-";
  const s = Math.floor(ms / 1000);
  const m = Math.floor(s / 60);
  const h = Math.floor(m / 60);
  const d = Math.floor(h / 24);
  if (d > 0) return d + "d " + (h % 24) + "h " + (m % 60) + "m";
  if (h > 0) return h + "h " + (m % 60) + "m " + (s % 60) + "s";
  return m + "m " + (s % 60) + "s";
}

const blockStore = require("../src/chain/blockStore");

let _stateLoaded = false;
function _loadStateFromDisk() {
  if (_stateLoaded) return;
  _stateLoaded = true;
  try {
    const latestFin = blockStore.getLatestFinalityNumber();
    if (latestFin >= 0) {
      const fin = blockStore.readFinality(latestFin);
      if (fin && fin.snapshot) stateStore.hydrateFromFinality(fin.snapshot);
    }
  } catch (_) {}
}

async function connect() {
  _loadStateFromDisk();
  const uri = process.env.MONGODB_URI;
  if (uri && process.env.BTCPC_MONGO_MODE === "enabled") {
    try { await mongoose.connect(uri); } catch (_) {}
  }
}

async function disconnect() {
  try { await mongoose.disconnect(); } catch (_) {}
}

async function getLatestEpoch() {
  const chainHeight = stateStore.getChainHeight();
  if (chainHeight < 0) return null;
  const ep = stateStore.getEpoch(chainHeight);
  if (ep) return Object.assign({ epoch_number: chainHeight }, ep);
  return null;
}

async function getGenesisTimestamp() {
  if (process.env.BTCPC_GENESIS_TIMESTAMP) {
    return parseInt(process.env.BTCPC_GENESIS_TIMESTAMP);
  }
  const genesis = stateStore.getEpoch ? stateStore.getEpoch(0) : null;
  if (genesis && genesis.started_at) return new Date(genesis.started_at).getTime();
  return null;
}

async function calcCurrentEpochNumber() {
  const genesis = await getGenesisTimestamp();
  if (!genesis) return 0;
  return Math.floor((Date.now() - genesis) / EPOCH_DURATION_MS);
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

program
  .name("btcpc-cli")
  .description("BTCPC network command line interface")
  .version("0.1.0");

// --- status ----------------------------------------------------------------

program
  .command("status")
  .description("Show current network status")
  .action(async () => {
    try {
      await connect();

      const currentEpochNum = await calcCurrentEpochNumber();
      const period = getCurrentPeriod(currentEpochNum);
      const reward = getBlockReward(currentEpochNum);

      // Time until next epoch
      const genesis = await getGenesisTimestamp();
      let timeToNext = "-";
      if (genesis) {
        const nextEpochStart = genesis + (currentEpochNum + 1) * EPOCH_DURATION_MS;
        const msLeft = nextEpochStart - Date.now();
        timeToNext = msLeft > 0 ? durationStr(msLeft) : "imminent";
      }

      // Total mined from stateStore epochs
      let totalMined = 0;
      for (let mi = 0; mi <= currentEpochNum; mi++) {
        const ep = stateStore.getEpoch ? stateStore.getEpoch(mi) : null;
        if (ep) totalMined += ep.block_reward || 0;
      }

      // Active miners
      const activeMiners = nodeRegistry.getRegisteredNodes().length;

      // Network work from stateStore
      let totalWork = 0;
      for (let wi = 0; wi <= currentEpochNum; wi++) {
        const ep = stateStore.getEpoch ? stateStore.getEpoch(wi) : null;
        if (ep) totalWork += ep.total_work || 0;
      }

      // Current difficulty from latest epoch
      const latestEpoch = await getLatestEpoch();
      const difficulty = latestEpoch && latestEpoch.difficulty ? latestEpoch.difficulty : 1.0;
      const nextAdjustmentEpoch = Math.ceil((currentEpochNum + 1) / DIFFICULTY_ADJUSTMENT_INTERVAL) * DIFFICULTY_ADJUSTMENT_INTERVAL;
      const epochsUntilAdjustment = nextAdjustmentEpoch - currentEpochNum;

      console.log("");
      console.log("BTCPC Network Status");
      console.log("====================");
      console.log("");
      console.log("  Current epoch:       " + formatNumber(currentEpochNum));
      console.log("  Period:              " + (period ? period.period + " (" + period.duration_months + " months)" : "-"));
      console.log("  Block reward:        " + formatBTCPC(reward) + " BTCPC");
      console.log("  Next epoch in:       " + timeToNext);
      console.log("  Total mined:         " + formatBTCPC(totalMined) + " BTCPC");
      console.log("  Active miners:       " + formatNumber(activeMiners));
      console.log("  Network work:        " + formatNumber(totalWork));
      console.log("  Difficulty:          " + difficulty.toFixed(8));
      console.log("  Next adjustment:     epoch " + formatNumber(nextAdjustmentEpoch) + " (" + formatNumber(epochsUntilAdjustment) + " epochs)");
      console.log("");

      // Agentic engine status
      try {
        const engineMonitor = require("../src/installer/engine-monitor");
        const engines = engineMonitor.summary();
        if (engines.length > 0) {
          console.log("  AI Agent Engines");
          console.log("  ----------------");
          for (const e of engines) {
            const skill = e.skill_registered ? "skill ✓" : "skill not registered (run btcpc-install)";
            const inv = e.invocations > 0
              ? `${e.invocations} calls, ${e.success_rate}% ok`
              : "no calls yet";
            console.log("  " + e.label.padEnd(22) + skill + "  |  " + inv);
          }
          console.log("");
        }
      } catch (_) {}

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- balance ---------------------------------------------------------------

program
  .command("balance [account]")
  .description("Show BTCPC balance for an account")
  .action(async (account) => {
    try {
      await connect();

      const username = account || process.env.BTCPC_MINER || "shindevlin";
      const balance = stateStore.getBalance(username, "BTCPC");
      const stakePool = stateStore.getStakePool ? stateStore.getStakePool(username) : null;
      const stakedTotal = stakePool ? (stakePool.staked_amount || 0) : 0;
      let totalEarned = 0;
      let epochsMined = 0;
      // Compute proofs from stateStore
      if (stateStore.getAllComputeProofs) {
        for (const proofs of Object.values(stateStore.getAllComputeProofs())) {
          for (const p of (proofs || [])) {
            if (p && p.node_id === username) {
              epochsMined++;
              totalEarned += p.reward || 0;
            }
          }
        }
      }

      console.log("");
      console.log("BTCPC Balance: " + username);
      console.log("=".repeat(20 + username.length));
      console.log("");
      console.log("  Balance:             " + formatBTCPC(balance) + " BTCPC");
      console.log("  Staked:              " + formatBTCPC(stakedTotal) + " BTCPC");
      console.log("  Total earned:        " + formatBTCPC(totalEarned) + " BTCPC");
      console.log("  Epochs mined:        " + formatNumber(epochsMined));
      console.log("");

      // Mining proofs from stateStore compute proofs
      const allProofsForBalance = stateStore.getAllComputeProofs ? stateStore.getAllComputeProofs() : {};
      const userProofsForBalance = [];
      for (const [epochNum, proofs] of Object.entries(allProofsForBalance)) {
        for (const p of (proofs || [])) {
          if (p && p.node_id === username) userProofsForBalance.push({ ...p, epoch: epochNum });
        }
      }
      if (userProofsForBalance.length > 0) {
        console.log("  Mining Proofs (soulbound): " + userProofsForBalance.length);
        for (const p of userProofsForBalance) {
          const date = p.timestamp ? new Date(p.timestamp).toISOString().split("T")[0] : "-";
          const rewardStr = (p.reward || 0).toFixed(2);
          console.log("    Epoch " + pad(String(p.epoch), 6) + pad(rewardStr, 12, true) + " BTCPC    " + pad(p.model || "-", 18) + date);
        }
        console.log("");
      }

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- epoch -----------------------------------------------------------------

program
  .command("epoch [number]")
  .description("Show details for a specific epoch")
  .action(async (number) => {
    try {
      await connect();

      let epoch;
      if (number !== undefined) {
        const epochNum = parseInt(number);
        const ep = stateStore.getEpoch ? stateStore.getEpoch(epochNum) : null;
        epoch = ep ? Object.assign({ epoch_number: epochNum }, ep) : null;
      } else {
        epoch = await getLatestEpoch();
      }

      if (!epoch) {
        console.error("error: epoch not found");
        await disconnect();
        process.exit(1);
      }

      const period = getCurrentPeriod(epoch.epoch_number);
      const minerCount = epoch.commitments ? epoch.commitments.length : 0;

      console.log("");
      console.log("Epoch " + epoch.epoch_number);
      console.log("=".repeat(10 + String(epoch.epoch_number).length));
      console.log("");
      console.log("  Status:              " + epoch.status);
      console.log("  Period:              " + (period ? period.period : "-"));
      console.log("  Block reward:        " + formatBTCPC(epoch.block_reward) + " BTCPC");
      console.log("  Total work:          " + formatNumber(epoch.total_work));
      console.log("  Miners:              " + formatNumber(minerCount));
      console.log("  Consensus hash:      " + (epoch.consensus_hash || "-"));
      console.log("  Started:             " + ts(epoch.started_at));
      console.log("  Ended:               " + ts(epoch.ended_at));
      console.log("");

      if (epoch.rewards_distributed && epoch.rewards_distributed.length > 0) {
        console.log("  Rewards Distributed");
        console.log("  -------------------");
        const hdr = ["Node", "Amount"];
        const w = [26, 24];
        const a = [false, true];
        printRow(hdr, w, a);
        printSep(w);
        for (const r of epoch.rewards_distributed) {
          printRow([String(r.node_id), formatBTCPC(r.amount) + " BTCPC"], w, a);
        }
        console.log("");
      }

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- blocks ----------------------------------------------------------------

program
  .command("blocks [count]")
  .description("List recent epochs")
  .action(async (count) => {
    try {
      await connect();

      const n = parseInt(count) || 10;
      const chainHeight = stateStore.getChainHeight();
      const epochs = [];
      for (let bi = chainHeight; bi >= 0 && epochs.length < n; bi--) {
        const ep = stateStore.getEpoch ? stateStore.getEpoch(bi) : null;
        if (ep) epochs.push(Object.assign({ epoch_number: bi }, ep));
      }

      if (epochs.length === 0) {
        console.log("\n  No epochs found.\n");
        await disconnect();
        return;
      }

      console.log("");
      console.log("Recent Epochs (last " + epochs.length + ")");
      console.log("=".repeat(30));
      console.log("");

      const hdr = ["Epoch", "Reward", "Work", "Miners", "Status", "Timestamp"];
      const w = [8, 24, 10, 7, 10, 24];
      const a = [true, true, true, true, false, false];

      printRow(hdr, w, a);
      printSep(w);

      for (const e of epochs) {
        printRow([
          String(e.epoch_number),
          formatBTCPC(e.block_reward),
          formatNumber(e.total_work),
          String(e.commitments ? e.commitments.length : 0),
          e.status,
          ts(e.started_at)
        ], w, a);
      }
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- supply ----------------------------------------------------------------

program
  .command("supply")
  .description("Show BTCPC supply information")
  .action(async () => {
    try {
      await connect();

      const currentEpochNum = await calcCurrentEpochNumber();
      const period = getCurrentPeriod(currentEpochNum);

      // Total mined from stateStore
      let totalMined = 0;
      for (let mi = 0; mi <= currentEpochNum; mi++) {
        const ep = stateStore.getEpoch ? stateStore.getEpoch(mi) : null;
        if (ep) totalMined += ep.block_reward || 0;
      }
      const remaining = TOTAL_SUPPLY - totalMined;

      // Next halving estimate
      let nextHalvingStr = "-";
      if (period && period.period < 11) {
        const epochsLeft = period.end_epoch - currentEpochNum;
        const msLeft = epochsLeft * EPOCH_DURATION_MS;
        const nextDate = new Date(Date.now() + msLeft);
        nextHalvingStr = nextDate.toISOString().split("T")[0] + " (~" + durationStr(msLeft) + ")";
      }

      console.log("");
      console.log("BTCPC Supply");
      console.log("============");
      console.log("");
      console.log("  Total supply:        " + formatNumber(TOTAL_SUPPLY) + ".00000000 BTCPC");
      console.log("  Mined:               " + formatBTCPC(totalMined) + " BTCPC");
      console.log("  Remaining:           " + formatBTCPC(remaining) + " BTCPC");
      console.log("  Percentage mined:    " + pct(totalMined, TOTAL_SUPPLY));
      console.log("  Current period:      " + (period ? period.period + " of 11" : "-"));
      console.log("  Next halving:        " + nextHalvingStr);
      console.log("");

      // Period table
      console.log("  Emission Schedule");
      console.log("  -----------------");
      const hdr = ["Period", "Duration", "Allotment", "Reward/Epoch", "Cumulative"];
      const w = [7, 12, 20, 20, 20];
      const a = [true, true, true, true, true];
      printRow(hdr, w, a);
      printSep(w);

      const periods = getPeriodTable();
      let cum = 0;
      for (const p of periods) {
        cum += p.allotment;
        const durLabel = p.duration_months >= 12
          ? (p.duration_months / 12).toFixed(1) + " years"
          : p.duration_months + " months";
        const marker = period && p.period === period.period ? " <" : "";
        printRow([
          String(p.period),
          durLabel,
          formatNumber(Math.round(p.allotment)),
          formatBTCPC(p.reward_per_epoch),
          formatNumber(Math.round(cum)) + marker
        ], w, a);
      }
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- work ------------------------------------------------------------------

program
  .command("work [count]")
  .description("List recent work proofs (epoch commitments)")
  .action(async (count) => {
    try {
      await connect();

      const n = parseInt(count) || 10;

      // Collect work proofs from stateStore compute proofs
      const allComputeProofs = stateStore.getAllComputeProofs ? stateStore.getAllComputeProofs() : {};
      const rows = [];
      const epochNums = Object.keys(allComputeProofs).map(Number).sort((a, b) => b - a);
      for (const epochNum of epochNums) {
        if (rows.length >= n) break;
        for (const p of (allComputeProofs[epochNum] || [])) {
          if (!p) continue;
          const nodeInfo = nodeRegistry.getNode(p.node_id);
          const models = nodeInfo && nodeInfo.models && nodeInfo.models.length > 0
            ? nodeInfo.models.join(", ")
            : (p.model || "-");
          rows.push({
            epoch: epochNum,
            model: models,
            tokens: p.tokens_generated || 0,
            work: p.tokens_generated || 0,
            timestamp: p.timestamp
          });
        }
      }

      if (rows.length === 0) {
        console.log("\n  No work proofs found.\n");
        await disconnect();
        return;
      }

      // Trim to requested count
      const display = rows.slice(0, parseInt(count) || 10);

      console.log("");
      console.log("Recent Work Proofs (last " + display.length + ")");
      console.log("=".repeat(35));
      console.log("");

      const hdr = ["Epoch", "Model", "Tokens", "Work", "Timestamp"];
      const w = [8, 30, 10, 10, 24];
      const al = [true, false, true, true, false];

      printRow(hdr, w, al);
      printSep(w);

      for (const r of display) {
        printRow([
          String(r.epoch),
          r.model.length > 30 ? r.model.substring(0, 27) + "..." : r.model,
          formatNumber(r.tokens),
          formatNumber(r.work),
          ts(r.timestamp)
        ], w, al);
      }
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

// --- wallet ----------------------------------------------------------------

function prompt(question, hidden) {
  return new Promise(function (resolve) {
    const rl = readline.createInterface({
      input: process.stdin,
      output: process.stdout
    });
    if (hidden) {
      // Mute output for password entry
      const origWrite = process.stdout.write;
      rl.question(question, function (answer) {
        process.stdout.write = origWrite;
        rl.close();
        console.log("");
        resolve(answer);
      });
      process.stdout.write = function () { return true; };
    } else {
      rl.question(question, function (answer) {
        rl.close();
        resolve(answer);
      });
    }
  });
}

const walletCmd = program
  .command("wallet")
  .description("Wallet management commands");

// --- wallet create ---------------------------------------------------------

walletCmd
  .command("create <username>")
  .description("Create a new BTCPC account with BIP-39 mnemonic and 2FA")
  .action(async (username) => {
    try {
      // Validate username before prompting for password
      const check = accountManager.validateUsername(username);
      if (!check.valid) {
        console.error("error: " + check.reason);
        process.exit(1);
      }

      console.log("");
      console.log("Creating BTCPC account: " + username);
      console.log("=".repeat(30 + username.length));
      console.log("");

      const password = await prompt("  Set 2FA password: ", true);
      if (!password || password.length < 8) {
        console.error("error: password must be at least 8 characters");
        process.exit(1);
      }
      const confirm = await prompt("  Confirm password:  ", true);
      if (password !== confirm) {
        console.error("error: passwords do not match");
        process.exit(1);
      }

      await connect();

      const result = await accountManager.createAccount(username, null, password);

      console.log("");
      console.log("  Account created successfully.");
      console.log("");
      console.log("  *** WRITE DOWN YOUR RECOVERY PHRASE ***");
      console.log("  *** This is the ONLY way to recover your account ***");
      console.log("");
      console.log("  Mnemonic: " + result.mnemonic);
      console.log("");
      console.log("  Wallets (all derived from your mnemonic):");
      console.log("    BTCPC:    " + result.chainWallets.btcpc);
      console.log("    EVM:      " + result.chainWallets.evm + "  (Base, Arbitrum, Optimism)");
      console.log("    Solana:   " + result.chainWallets.solana);
      console.log("    Bitcoin:  " + result.chainWallets.bitcoin);
      console.log("    TON:      " + result.chainWallets.ton);
      console.log("    Hive:     @" + result.chainWallets.hive);
      console.log("");
      console.log("  Import your mnemonic into MetaMask, Phantom, or Electrum");
      console.log("  to manage funds on those chains.");
      console.log("");
      console.log("  BTCPC Keys:");
      console.log("    Owner:   " + result.publicKeys.owner);
      console.log("    Active:  " + result.publicKeys.active);
      console.log("    Posting: " + result.publicKeys.posting);
      console.log("    Memo:    " + result.publicKeys.memo);
      console.log("");
      console.log("  2FA Public Key: " + (result.twoFactorPublicKey || "none"));
      console.log("  Auth Profile:   " + result.authProfile);
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet recover --------------------------------------------------------

walletCmd
  .command("recover")
  .description("Recover a BTCPC account from a 12-word mnemonic")
  .action(async () => {
    try {
      console.log("");
      console.log("BTCPC Account Recovery");
      console.log("======================");
      console.log("");

      const mnemonic = await prompt("  Enter 12-word mnemonic: ");
      if (!mnemonic) {
        console.error("error: mnemonic is required");
        process.exit(1);
      }

      const words = mnemonic.trim().split(/\s+/);
      if (words.length !== 12) {
        console.error("error: mnemonic must be exactly 12 words (got " + words.length + ")");
        process.exit(1);
      }

      if (!keyManager.validateMnemonic(mnemonic.trim())) {
        console.error("error: invalid BIP-39 mnemonic");
        process.exit(1);
      }

      await connect();

      const result = await accountManager.recoverAccount(mnemonic.trim());

      console.log("");
      if (result.found) {
        console.log("  Account found: " + result.username);
      } else {
        console.log("  No on-chain account found for this mnemonic.");
        console.log("  Keys derived successfully — you can create a new account.");
      }
      console.log("");
      console.log("  Address:  " + result.address);
      console.log("");
      console.log("  Public Keys:");
      console.log("    Owner:   " + result.publicKeys.owner);
      console.log("    Active:  " + result.publicKeys.active);
      console.log("    Posting: " + result.publicKeys.posting);
      console.log("    Memo:    " + result.publicKeys.memo);
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet set-password ---------------------------------------------------

walletCmd
  .command("set-password <username>")
  .description("Set or change the password for a BTCPC account (stored in secretStore)")
  .action(async (username) => {
    try {
      console.log("");
      console.log("Set Password for '" + username + "'");
      console.log("=".repeat(40));

      // Check if the account has an existing password
      var secretStore;
      try {
        secretStore = require("../src/services/secretStore");
        await secretStore.load();
      } catch (e) {
        console.error("error: secretStore unavailable: " + e.message);
        process.exit(1);
      }

      var existingUser = secretStore.getUser(username);
      var hasExistingPassword = existingUser && existingUser.password_hash;

      if (hasExistingPassword) {
        // Verify old password first
        console.log("  This account already has a password.");
        var oldPass = await prompt("  Enter current password: ", true);
        var verified = await secretStore.verifyPassword(username, oldPass);
        if (!verified) {
          console.error("  error: incorrect current password");
          process.exit(1);
        }
        console.log("  Current password verified ✓");
      } else {
        console.log("  No password set yet for this account.");
      }

      // Set new password
      console.log("");
      var newPass = await prompt("  New password (min 8 chars): ", true);
      if (!newPass || newPass.length < 8) {
        console.error("  error: password must be at least 8 characters");
        process.exit(1);
      }
      var confirmPass = await prompt("  Confirm new password:       ", true);
      if (newPass !== confirmPass) {
        console.error("  error: passwords don't match");
        process.exit(1);
      }

      if (existingUser) {
        await secretStore.updateUser(username, { password: newPass });
      } else {
        await secretStore.createUser(username, { password: newPass });
      }

      console.log("");
      console.log("  ✅ Password set for '" + username + "'");
      console.log("  This password works for:");
      console.log("    - Telegram bot login (/start → Username + Password)");
      console.log("    - API authentication");
      console.log("    - Node .env (BTCPC_PASSWORD=)");
      console.log("");
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- wallet reset-password (via active key) --------------------------------

walletCmd
  .command("reset-password <username>")
  .description("Reset a forgotten password by proving ownership with the active key (from mnemonic)")
  .action(async (username) => {
    try {
      console.log("");
      console.log("Reset Password for '" + username + "'");
      console.log("=".repeat(40));
      console.log("");
      console.log("  This requires your 12-word mnemonic to prove you own the account.");
      console.log("  The mnemonic will NOT be stored — only used to derive the active key,");
      console.log("  verify it matches the on-chain key, and then forgotten.");
      console.log("");

      var mnemonic = await prompt("  Enter 12-word mnemonic: ");
      if (!mnemonic) {
        console.error("  error: mnemonic required");
        process.exit(1);
      }
      mnemonic = mnemonic.trim();

      if (!keyManager.validateMnemonic(mnemonic)) {
        console.error("  error: invalid BIP-39 mnemonic");
        process.exit(1);
      }

      // Derive the active key from the mnemonic
      var keys = await keyManager.mnemonicToKeys(mnemonic);
      var derivedActivePub = keys.active.publicKey;

      // Check against on-chain active key
      var onChainAccount = stateStore.getAccount ? stateStore.getAccount(username) : null;
      if (onChainAccount && onChainAccount.public_keys && onChainAccount.public_keys.active) {
        if (onChainAccount.public_keys.active !== derivedActivePub) {
          console.error("  error: mnemonic does not match on-chain active key for '" + username + "'");
          console.error("  On-chain:  " + onChainAccount.public_keys.active.slice(0, 20) + "...");
          console.error("  Derived:   " + derivedActivePub.slice(0, 20) + "...");
          process.exit(1);
        }
        console.log("  Active key verified against on-chain key ✓");
      } else {
        console.log("  ⚠️  No active key on chain for '" + username + "' — proceeding on mnemonic validity alone");
      }

      // Wipe mnemonic from memory
      mnemonic = null;

      // Set new password
      console.log("");
      var newPass = await prompt("  New password (min 8 chars): ", true);
      if (!newPass || newPass.length < 8) {
        console.error("  error: password must be at least 8 characters");
        process.exit(1);
      }
      var confirmPass = await prompt("  Confirm new password:       ", true);
      if (newPass !== confirmPass) {
        console.error("  error: passwords don't match");
        process.exit(1);
      }

      var secretStore;
      try {
        secretStore = require("../src/services/secretStore");
        await secretStore.load();
      } catch (e) {
        console.error("error: secretStore unavailable: " + e.message);
        process.exit(1);
      }

      var existingUser = secretStore.getUser(username);
      if (existingUser) {
        await secretStore.updateUser(username, { password: newPass });
      } else {
        await secretStore.createUser(username, { password: newPass });
      }

      console.log("");
      console.log("  ✅ Password reset for '" + username + "'");
      console.log("  The old password no longer works.");
      console.log("  Mnemonic discarded — not stored anywhere.");
      console.log("");
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

