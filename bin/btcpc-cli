program
  .command("sign-challenge <challenge>")
  .description("Sign a Telegram verification challenge with your posting key")
  .action(async (challenge) => {
    try {
      if (!challenge.startsWith("BTCPC-VERIFY-")) {
        console.error("error: challenge must start with BTCPC-VERIFY-");
        process.exit(1);
      }

      const postingKey = await prompt("  Enter your posting private key (hex): ");
      if (!postingKey || postingKey.trim().length !== 64) {
        console.error("error: posting key must be a 64-character hex string");
        process.exit(1);
      }

      const { signTransaction } = keyManager;
      const result = signTransaction(challenge, postingKey.trim());

      console.log("");
      console.log("  Challenge signed successfully.");
      console.log("");
      console.log("  Send this to the bot:");
      console.log("  /verify " + result.signature + ":" + result.recovery);
      console.log("");
    } catch (err) {
      console.error("error: " + err.message);
      process.exit(1);
    }
  });

// --- dreams ----------------------------------------------------------------

const GenesisDream = require("../src/models/GenesisDream");
const {
  getDreams: fetchDreams,
  getDream: fetchDream,
  inscribeDream,
  transferDream
} = require("../src/controllers/dreamController");

program
  .command("dreams [account]")
  .description("List all genesis dreams owned by an account")
  .action(async (account) => {
    try {
      await connect();

      const username = account || "shindevlin";
      const dreams = await fetchDreams(username);

      if (dreams.length === 0) {
        console.log("\n  No genesis dreams found for '" + username + "'.\n");
        await disconnect();
        return;
      }

      console.log("");
      console.log("Genesis Dreams: " + username + " (" + dreams.length + ")");
      console.log("=".repeat(25 + username.length));
      console.log("");

      const hdr = ["Block", "Inscription", "Status", "Original Miner", "Transferred"];
      const w = [7, 36, 12, 16, 12];
      const a = [true, false, false, false, false];

      printRow(hdr, w, a);
      printSep(w);

      for (const d of dreams) {
        const hasInscription = d.inscription && d.inscription.project && d.inscription.tag;
        const inscriptionTag = hasInscription
          ? d.inscription.tag.length > 34
            ? d.inscription.tag.substring(0, 31) + "..."
            : d.inscription.tag
          : "[uninscribed]";
        const status = hasInscription ? "inscribed" : "uninscribed";

        printRow([
          String(d.block_number),
          inscriptionTag,
          status,
          d.original_miner,
          d.transferred ? "yes" : "no"
        ], w, a);
      }
      console.log("");

      await disconnect();
    } catch (err) {
      console.error("error:", err.message);
      process.exit(1);
    }
  });

