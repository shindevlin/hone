#!/usr/bin/env node
"use strict";

/**
 * btcpc-chain-monitor — Cross-Chain Address Monitoring Daemon
 * Shin Devlin
 *
 * Watches EVM chains (Base, Arbitrum, Ethereum), Solana, and Bitcoin
 * for balance changes on addresses registered to BTCPC accounts.
 * When activity is detected, records a CROSS_CHAIN_ACTIVITY ledger entry
 * that flows into the next block.
 *
 * Design: polling-based, no WebSocket subscriptions, no API keys required.
 * Uses only public RPC endpoints. Self-healing: RPC failures are logged and
 * retried on the next poll interval — never crash the daemon.
 *
 * Usage:
 *   node bin/btcpc-chain-monitor
 *
 * Environment:
 *   BTCPC_MONITOR_INTERVAL_MS  — poll interval in ms (default: 60000)
 *   BTCPC_ROLES                — set to include "monitor" in btcpc-all
 */

var path = require("path");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

var ledger = require("../src/services/ledger");
var stateStore = require("../src/chain/stateStore");
var chainMonitor = require("../src/services/chainMonitor");

function log(msg) { console.log("[chain-monitor] " + msg); }
function warn(msg) { console.warn("[chain-monitor] WARN: " + msg); }
function err(msg) { console.error("[chain-monitor] ERROR: " + msg); }

// ─── Bootstrap ───────────────────────────────────────────────────

log("BTCPC cross-chain address monitor starting");
log("Poll interval: " + chainMonitor.POLL_INTERVAL_MS + "ms");

var monitoredChains = ["base", "arbitrum", "ethereum", "solana", "bitcoin"];
log("Monitored chains: " + monitoredChains.join(", "));

// Create the monitor, wiring in ledger + stateStore
var monitor = chainMonitor.createChainMonitor({
  ledger: ledger,
  stateStore: stateStore,
});

// Start polling
monitor.start();

// ─── Graceful shutdown ───────────────────────────────────────────

function shutdown(signal) {
  log("received " + signal + ", shutting down");
  monitor.stop();
  process.exit(0);
}

process.on("SIGINT", function () { shutdown("SIGINT"); });
process.on("SIGTERM", function () { shutdown("SIGTERM"); });

// Log heartbeat every 5 minutes so `docker logs` shows we're alive
setInterval(function () {
  var accounts;
  try {
    accounts = stateStore.getAllAccounts();
  } catch (_) {
    accounts = [];
  }

  var withEvm     = accounts.filter(function (a) { return a.chain_addresses && a.chain_addresses.evm; }).length;
  var withSolana  = accounts.filter(function (a) { return a.chain_addresses && a.chain_addresses.solana; }).length;
  var withBitcoin = accounts.filter(function (a) { return a.chain_addresses && a.chain_addresses.bitcoin; }).length;

  log(
    "heartbeat — accounts=" + accounts.length +
    " evm=" + withEvm +
    " solana=" + withSolana +
    " bitcoin=" + withBitcoin
  );
}, 300000);
