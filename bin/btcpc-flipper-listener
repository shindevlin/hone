#!/usr/bin/env node
"use strict";

/**
 * btcpc-flipper-listener — auto-detect Flipper and sync sensor data
 *
 * Runs as a background daemon. When a Flipper Zero is connected via USB,
 * automatically flushes its buffered sensor readings to the BTCPC chain.
 *
 * Store-and-forward: when the chain API is unreachable, readings are written
 * to ~/.btcpc/flipper-buffer.jsonl and drained on the next successful call.
 *
 * Sub-GHz relay: subghz readings include relay_account for reward attribution
 * when the submitting node is not the device owner.
 *
 * Usage: node bin/btcpc-flipper-listener
 */

var fs   = require("fs");
var path = require("path");
var http = require("http");
var os   = require("os");
var { execSync, execFileSync } = require("child_process");

var CHECK_INTERVAL_MS = 10000; // check every 10 seconds
var FLUSH_INTERVAL_MS = 30000; // flush readings every 30 seconds
var lastFlush = 0;

var CHAIN_HOST  = "http://localhost:4242";
var ACCOUNT     = process.env.BTCPC_MINER || "josh";
var RELAY_ACCOUNT = process.env.RELAY_ACCOUNT || "natoshisakamoto";
var AUTH_TOKEN  = process.env.BTCPC_AUTH_TOKEN || "";

// ── Store-and-forward buffer ─────────────────────────────────────────────────
var BUFFER_DIR  = path.join(os.homedir(), ".btcpc");
var BUFFER_FILE = path.join(BUFFER_DIR, "flipper-buffer.jsonl");
var BUFFER_MAX  = 10000; // max lines before oldest are dropped

function ensureBufferDir() {
    try {
        if (!fs.existsSync(BUFFER_DIR)) fs.mkdirSync(BUFFER_DIR, { recursive: true });
    } catch (_) {}
}

function bufferReading(entry) {
    ensureBufferDir();
    try {
        // Read existing lines
        var existing = [];
        if (fs.existsSync(BUFFER_FILE)) {
            existing = fs.readFileSync(BUFFER_FILE, "utf8")
                .split("\n")
                .filter(function(l) { return l.trim().length > 0; });
        }
        existing.push(JSON.stringify(entry));
        // Cap at BUFFER_MAX — drop oldest
        if (existing.length > BUFFER_MAX) {
            existing = existing.slice(existing.length - BUFFER_MAX);
        }
        fs.writeFileSync(BUFFER_FILE, existing.join("\n") + "\n", "utf8");
    } catch (e) {
        log("Buffer write error: " + e.message);
    }
}

function readBuffer() {
    try {
        if (!fs.existsSync(BUFFER_FILE)) return [];
        return fs.readFileSync(BUFFER_FILE, "utf8")
            .split("\n")
            .filter(function(l) { return l.trim().length > 0; })
            .map(function(l) {
                try { return JSON.parse(l); } catch (_) { return null; }
            })
            .filter(Boolean);
    } catch (_) {
        return [];
    }
}

function clearBuffer() {
    try {
        if (fs.existsSync(BUFFER_FILE)) fs.writeFileSync(BUFFER_FILE, "", "utf8");
    } catch (_) {}
}

// ── Logging ──────────────────────────────────────────────────────────────────
function log(msg) { console.log("[flipper-listener] " + msg); }

// ── Flipper detection ─────────────────────────────────────────────────────────
function findFlipperPort() {
    try {
        var files = fs.readdirSync("/dev").filter(function(f) { return f.startsWith("ttyACM"); });
        for (var i = 0; i < files.length; i++) {
            var port = "/dev/" + files[i];
            try {
                var sysPath = "/sys/class/tty/" + files[i] + "/device/../manufacturer";
                var mfg = fs.readFileSync(sysPath, "utf8").trim().toLowerCase();
                if (mfg.includes("flipper")) return port;
            } catch (_) {}
        }
        // Fallback: check lsusb for Flipper USB VID:PID 0483:5740
        try {
            var lsusb = execSync("lsusb 2>/dev/null", { encoding: "utf8" });
            if (lsusb.includes("0483:5740") && files.length > 0) return "/dev/" + files[0];
        } catch (_) {}
    } catch (_) {}
    return null;
}

/**
 * Configure the tty in raw mode at 115200 baud, same as btcpc-flipper-bridge.
 * Must be called before opening the file descriptor.
 */
function configureTty(port) {
    execFileSync("stty", ["-F", port, "115200", "raw", "-echo", "-echoe",
        "-echok", "-echoctl", "-echoke"], { stdio: "ignore" });
}

/**
 * Send a JSON command to the Flipper and wait for a JSON response.
 * Uses serialport if available, else falls back to raw file I/O (with stty config).
 */
function sendCommand(port, cmd) {
    return new Promise(function(resolve, reject) {
        var serialport;
        try {
            serialport = require("serialport");
        } catch (_) {
            serialport = null;
        }

        if (serialport) {
            // ── serialport path ─────────────────────────────────────
            var sp = new serialport.SerialPort({ path: port, baudRate: 115200 });
            var data = "";
            sp.on("data", function(chunk) { data += chunk.toString(); });
            sp.on("open", function() {
                sp.write(JSON.stringify(cmd) + "\n");
                setTimeout(function() {
                    sp.close(function() {});
                    var lines = data.trim().split("\n");
                    // Find the last non-empty line that parses as JSON
                    for (var i = lines.length - 1; i >= 0; i--) {
                        var line = lines[i].trim();
                        if (!line) continue;
                        try { return resolve(JSON.parse(line)); } catch (_) {}
                    }
                    resolve({ raw: data });
                }, 2000);
            });
            sp.on("error", reject);
        } else {
            // ── raw file I/O fallback ────────────────────────────────
            // Configure the tty first (required for raw binary mode)
            try {
                configureTty(port);
            } catch (e) {
                return reject(new Error("stty config failed: " + e.message));
            }

            var fd;
            try {
                fd = fs.openSync(port, "r+");
            } catch (e) {
                return reject(new Error("open failed: " + e.message));
            }

            var json = JSON.stringify(cmd) + "\n";
            try {
                fs.writeSync(fd, Buffer.from(json, "utf8"));
            } catch (e) {
                try { fs.closeSync(fd); } catch (_) {}
                return reject(new Error("write failed: " + e.message));
            }

            // Poll for a complete JSON line (up to 4 s)
            var readBuf = "";
            var chunkBuf = Buffer.alloc(256);
            var deadline = Date.now() + 4000;
            var result = null;

            while (Date.now() < deadline) {
                try {
                    var n = fs.readSync(fd, chunkBuf, 0, chunkBuf.length);
                    if (n > 0) readBuf += chunkBuf.slice(0, n).toString("utf8");
                } catch (e) {
                    if (e.code !== "EAGAIN" && e.code !== "EWOULDBLOCK") {
                        try { fs.closeSync(fd); } catch (_) {}
                        return reject(e);
                    }
                    // no data yet — spin briefly
                    var waitEnd = Date.now() + 50;
                    while (Date.now() < waitEnd) {}
                }

                var nl = readBuf.indexOf("\n");
                if (nl >= 0) {
                    var line = readBuf.slice(0, nl).trim();
                    readBuf = readBuf.slice(nl + 1);
                    if (!line) continue;
                    try { result = JSON.parse(line); break; } catch (_) { /* skip non-JSON debug output */ }
                }
            }

            try { fs.closeSync(fd); } catch (_) {}
            if (result) {
                resolve(result);
            } else {
                resolve({ raw: readBuf });
            }
        }
    });
}

/**
 * Build the POST body for a sensor reading.
 * Includes relay_account for subghz readings when the submitter is not the
 * device owner (ACCOUNT !== RELAY_ACCOUNT).
 */
function buildBody(sensorType, value, metadata) {
    var body = {
        account:  ACCOUNT,
        value:    value,
        metadata: metadata || {},
    };
    // Sub-GHz relay attribution: only set when the submitting node is not the owner
    if (sensorType === "subghz" && ACCOUNT !== RELAY_ACCOUNT) {
        body.relay_account = RELAY_ACCOUNT;
    }
    return body;
}

/**
 * POST a sensor reading to the chain via HTTP.
 * Returns a Promise that resolves with the parsed response, or rejects on
 * network error (ECONNREFUSED, timeout, etc.) so callers can buffer.
 */
function postReading(sensorId, value, metadata, sensorType) {
    return new Promise(function(resolve, reject) {
        var encodedId = encodeURIComponent(sensorId);
        var bodyObj   = buildBody(sensorType || "unknown", value, metadata);
        var bodyStr   = JSON.stringify(bodyObj);
        var options = {
            method: "POST",
            hostname: "localhost",
            port: 4242,
            path: "/api/sensors/" + encodedId + "/readings",
            headers: {
                "Content-Type":   "application/json",
                "Content-Length": Buffer.byteLength(bodyStr),
            },
        };
        if (AUTH_TOKEN) {
            options.headers["Authorization"] = "Bearer " + AUTH_TOKEN;
        }

        var req = http.request(options, function(res) {
            var raw = "";
            res.on("data", function(c) { raw += c; });
            res.on("end", function() {
                try { resolve(JSON.parse(raw)); } catch (_) { resolve({ raw: raw }); }
            });
        });
        req.on("error", reject);
        req.setTimeout(8000, function() {
            req.destroy(new Error("request timeout"));
        });
        req.write(bodyStr);
        req.end();
    });
}

/**
 * Drain any buffered readings (oldest first).
 * Returns the number of entries successfully submitted.
 */
async function drainBuffer() {
    var entries = readBuffer();
    if (entries.length === 0) return 0;

    log("draining " + entries.length + " buffered readings");
    var remaining = [];
    var drained = 0;

    for (var i = 0; i < entries.length; i++) {
        var e = entries[i];
        try {
            var result = await postReading(e.sensorId, e.value, e.metadata, e.sensorType);
            if (result && (result.success || result.duplicate)) {
                drained++;
            } else {
                // Server rejected it — don't re-buffer, just skip
                log("Buffered reading rejected for " + e.sensorId + ": " + JSON.stringify(result));
                drained++;
            }
        } catch (err) {
            // API still unreachable — stop draining, keep remaining
            remaining = entries.slice(i);
            break;
        }
    }

    // Rewrite the file with only the unsubmitted entries
    try {
        ensureBufferDir();
        if (remaining.length > 0) {
            fs.writeFileSync(BUFFER_FILE,
                remaining.map(function(x) { return JSON.stringify(x); }).join("\n") + "\n",
                "utf8");
        } else {
            clearBuffer();
        }
    } catch (_) {}

    return drained;
}

async function flushReadings(port) {
    try {
        log("Flushing readings from Flipper...");
        var resp = await sendCommand(port, { cmd: "flush_readings" });

        if (resp && resp.readings && resp.readings.length > 0) {
            log("Got " + resp.readings.length + " readings from Flipper");

            // Drain any previously buffered readings first
            var buffered = readBuffer();
            if (buffered.length > 0) {
                await drainBuffer();
            }

            var submitted = 0;
            for (var i = 0; i < resp.readings.length; i++) {
                var r = resp.readings[i];
                var sensorType = r.type || "unknown";
                var sensorId   = ACCOUNT + "/flipper-" + sensorType;
                var value      = (r.rssi !== undefined) ? r.rssi : (r.value !== undefined ? r.value : 0);
                var metadata   = {
                    type:               sensorType,
                    source:             "flipper-zero",
                    signal_strength_dbm: typeof r.rssi === "number" ? r.rssi : undefined,
                };
                // Pass through any extra fields the Flipper returns
                if (r.unit)                         metadata.unit        = r.unit;
                if (typeof r.battery_pct === "number") metadata.battery_pct = r.battery_pct;

                try {
                    var result = await postReading(sensorId, value, metadata, sensorType);
                    if (result && (result.success || result.duplicate)) {
                        submitted++;
                    } else {
                        log("Reading rejected for " + sensorId + ": " + JSON.stringify(result));
                    }
                } catch (e) {
                    // API unreachable — buffer this reading and the rest
                    log("Post error for " + sensorId + " (buffering): " + e.message);
                    for (var j = i; j < resp.readings.length; j++) {
                        var rb = resp.readings[j];
                        var st = rb.type || "unknown";
                        var sid = ACCOUNT + "/flipper-" + st;
                        var rv = (rb.rssi !== undefined) ? rb.rssi : (rb.value !== undefined ? rb.value : 0);
                        var rm = {
                            type:               st,
                            source:             "flipper-zero",
                            signal_strength_dbm: typeof rb.rssi === "number" ? rb.rssi : undefined,
                        };
                        if (rb.unit)                           rm.unit        = rb.unit;
                        if (typeof rb.battery_pct === "number") rm.battery_pct = rb.battery_pct;
                        bufferReading({ sensorId: sid, value: rv, metadata: rm, sensorType: st });
                    }
                    break;
                }
            }
            log("Submitted " + submitted + "/" + resp.readings.length + " to chain");
        } else {
            log("No readings to flush");
            // Still try to drain the buffer if API is reachable
            var pending = readBuffer();
            if (pending.length > 0) {
                await drainBuffer();
            }
        }
    } catch (e) {
        log("Flush error: " + e.message);
    }
}

log("BTCPC Flipper Listener started");
log("Checking for Flipper every " + (CHECK_INTERVAL_MS / 1000) + "s");
log("Account: " + ACCOUNT + " | Relay account: " + RELAY_ACCOUNT);

setInterval(async function() {
    var port = findFlipperPort();

    if (port) {
        var now = Date.now();
        if (now - lastFlush > FLUSH_INTERVAL_MS) {
            try {
                var ping = await sendCommand(port, { cmd: "ping" });
                if (ping && ping.status === "ok") {
                    log("Flipper connected on " + port + " (v" + (ping.version || "?") + ")");
                    await flushReadings(port);
                    lastFlush = now;
                } else {
                    log("Flipper ping: no BTCPC app response on " + port);
                }
            } catch (e) {
                log("Serial error: " + e.message);
            }
        }
    }
}, CHECK_INTERVAL_MS);

// Keep alive
setInterval(function() {}, 60000);
