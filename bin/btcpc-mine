#!/usr/bin/env node
/**
 * BTCPC Mining Daemon
 *
 * Connects to Ollama for inference-based mining. MongoDB is optional
 * (Phase F) — chain state lives in stateStore; Mongo is only used for
 * inference job tracking when available.
 *
 * Usage:
 *   node bin/btcpc-mine
 *   ./bin/btcpc-mine
 *
 * Environment:
 *   MONGODB_URI          - MongoDB connection string (optional, Phase F)
 *   BTCPC_MONGO_MODE     - Set to "disabled" to skip Mongo entirely
 *   OLLAMA_URL           - Ollama API endpoint (default: http://100.122.145.60:11434)
 *   BTCPC_MODEL          - Model to use for inference (default: qwen3.5:27b)
 *   BTCPC_WORK_PER_EPOCH - Number of inference tasks per epoch (default: 3)
 */

"use strict";

const path = require('path');

// Load environment variables from project root
require('dotenv').config({ path: path.resolve(__dirname, '..', '.env') });

const mongoose = require('mongoose');
const { startMiner, stopMiner } = require('../src/mining/miner');

const MONGODB_URI = process.env.MONGODB_URI || '';

// Phase F: mongoEnabled flag — downstream inference job tracking checks this
let mongoEnabled = false;

async function connectMongo() {
  const mongoMode = (process.env.BTCPC_MONGO_MODE || '').toLowerCase();
  if (mongoMode === 'disabled') {
    console.log('[BTCPC] MongoDB: DISABLED via BTCPC_MONGO_MODE=disabled');
    return;
  }
  if (!MONGODB_URI) {
    console.warn('[BTCPC] MongoDB: enabled but unreachable — MONGODB_URI not set, falling back to stateStore');
    return;
  }
  try {
    await mongoose.connect(MONGODB_URI, { serverSelectionTimeoutMS: 3000 });
    mongoEnabled = true;
    console.log('[BTCPC] MongoDB: enabled and connected');
  } catch (err) {
    console.warn(`[BTCPC] MongoDB: enabled but unreachable — falling back to stateStore (${err.message})`);
  }
}

async function main() {
  const ts = new Date().toISOString();
  console.log(`[BTCPC] ${ts} -- BTCPC Mining Daemon`);

  await connectMongo();

  // Graceful shutdown
  const shutdown = async (signal) => {
    console.log(`\n[BTCPC] Received ${signal}, shutting down...`);
    stopMiner();
    if (mongoEnabled) {
      await mongoose.connection.close();
    }
    console.log('[BTCPC] Shutdown complete');
    process.exit(0);
  };

  process.on('SIGINT', () => shutdown('SIGINT'));
  process.on('SIGTERM', () => shutdown('SIGTERM'));

  // Start mining
  await startMiner();

  // Keep the process alive — inference jobs run in the background
  // and complete in future epochs. Without this, Node exits after
  // startMiner() returns because no timers/sockets hold the event loop.
  setInterval(() => {}, 60000);
}

main().catch(err => {
  console.error(`[BTCPC] Fatal error: ${err.message}`);
  console.error(err.stack);
  process.exit(1);
});
