#!/usr/bin/env node
"use strict";

/**
 * btcpc-gnss-relay — RTCM3 stream interceptor + multi-caster
 * Shin Devlin
 *
 * Intercepts RTCM3 correction data from a Hyfix GNSS base station via
 * ARP spoofing, then forwards copies to NTRIP casters (onocoy, RTK Direct)
 * and records data on the BTCPC chain as IoT sensor readings.
 *
 * Architecture:
 *   Hyfix (BTCPC_GNSS_DEVICE_IP) → UDP → GEODNET
 *                                 ↓ (intercepted via ARP spoof + tcpdump)
 *                           This relay
 *                             ├→ onocoy   (NTRIP/TCP)
 *                             ├→ RTK Direct (NTRIP/TCP)
 *                             └→ BTCPC chain (sensor reading via local API)
 *
 * Requires root (or cap_net_raw + cap_net_admin on tcpdump/arpspoof).
 * Run via the btcpc-gnss-relay.service system service.
 *
 * Usage:
 *   sudo node bin/btcpc-gnss-relay
 *   (or: systemctl start btcpc-gnss-relay)
 *
 * Environment (all have defaults, configure in .env):
 *   BTCPC_GNSS_DEVICE_IP    — Hyfix IP on local network (default: 192.168.68.54)
 *   BTCPC_GNSS_GATEWAY_IP   — Router/gateway IP (default: 192.168.68.1)
 *   BTCPC_GNSS_IFACE        — Network interface to sniff (default: auto-detect)
 *   BTCPC_GNSS_GEODNET_IP   — GEODNET server IP (default: 52.8.236.207)
 *   BTCPC_GNSS_GEODNET_PORT — GEODNET port (default: 2201)
 *   BTCPC_GNSS_MINER        — BTCPC account to earn sensor rewards
 *   BTCPC_API_PORT          — local BTCPC API port (default: 4242)
 *   BTCPC_AUTH_TOKEN        — JWT for local API (from .env)
 *   BTCPC_ONOCOY_USER/PASS  — onocoy NTRIP credentials
 *   BTCPC_RTK_USER/PASS/MOUNT — RTK Direct NTRIP credentials
 *   BTCPC_GNSS_FORWARD_CASTERS — set "true" to enable caster forwarding
 */

var { execSync, spawn } = require("child_process");
var net = require("net");
var http = require("http");
var os = require("os");
var path = require("path");

require("dotenv").config({ path: path.resolve(__dirname, "..", ".env") });

// ─── Config ──────────────────────────────────────────────────────

var DEVICE_IP   = process.env.BTCPC_GNSS_DEVICE_IP || "192.168.68.54";
var GATEWAY_IP  = process.env.BTCPC_GNSS_GATEWAY_IP || "192.168.68.1";
var GEODNET_IP  = process.env.BTCPC_GNSS_GEODNET_IP || "52.8.236.207";
var GEODNET_PORT = parseInt(process.env.BTCPC_GNSS_GEODNET_PORT) || 2201;
var MINER_ACCOUNT = process.env.BTCPC_GNSS_MINER || process.env.BTCPC_MINER || "shindevlin";
var API_PORT    = parseInt(process.env.BTCPC_API_PORT) || 4242;
var AUTH_TOKEN  = process.env.BTCPC_AUTH_TOKEN || "";
var FORWARD_CASTERS = process.env.BTCPC_GNSS_FORWARD_CASTERS === "true";

// Auto-detect the network interface that can reach DEVICE_IP
var IFACE = process.env.BTCPC_GNSS_IFACE || process.env.BTCPC_GNSS_WIFI_IFACE || autoDetectIface();

function autoDetectIface() {
  try {
    // Use `ip route get` to find which interface reaches the device
    var out = execSync("ip route get " + DEVICE_IP + " 2>/dev/null", { encoding: "utf8" }).trim();
    var m = out.match(/dev\s+(\S+)/);
    if (m) return m[1];
  } catch (_) {}
  // Fall back to scanning interfaces for one on the same /24
  var prefix = DEVICE_IP.split(".").slice(0, 3).join(".");
  var ifaces = os.networkInterfaces();
  for (var name in ifaces) {
    for (var info of ifaces[name]) {
      if (info.family === "IPv4" && info.address.startsWith(prefix)) return name;
    }
  }
  return "enp0s31f6"; // last-resort default
}

// NTRIP caster destinations
var CASTERS = [
  {
    name: "onocoy",
    host: process.env.BTCPC_ONOCOY_HOST || "servers.onocoy.com",
    port: parseInt(process.env.BTCPC_ONOCOY_PORT) || 2121,
    username: process.env.BTCPC_ONOCOY_USER || "",
    password: process.env.BTCPC_ONOCOY_PASS || "",
    mountpoint: process.env.BTCPC_ONOCOY_MOUNT || "",
    enabled: FORWARD_CASTERS && !!(process.env.BTCPC_ONOCOY_USER),
  },
  {
    name: "rtkdirect",
    host: process.env.BTCPC_RTK_HOST || "ntrip.rtkdirect.com",
    port: parseInt(process.env.BTCPC_RTK_PORT) || 2101,
    username: process.env.BTCPC_RTK_USER || "",
    password: process.env.BTCPC_RTK_PASS || "",
    mountpoint: process.env.BTCPC_RTK_MOUNT || "",
    enabled: FORWARD_CASTERS && !!(process.env.BTCPC_RTK_USER),
  },
];

function log(msg) { console.log("[gnss-relay] " + msg); }
function warn(msg) { console.warn("[gnss-relay] WARN: " + msg); }

// ─── ARP Spoofing ────────────────────────────────────────────────

var arpProcesses = [];

function startArpSpoof() {
  log("ARP spoof: " + DEVICE_IP + " ↔ " + GATEWAY_IP + " on " + IFACE);
  try { execSync("sysctl -w net.ipv4.ip_forward=1", { stdio: "ignore" }); } catch (_) {}

  var arp1 = spawn("arpspoof", ["-i", IFACE, "-t", DEVICE_IP, GATEWAY_IP], { stdio: "ignore" });
  var arp2 = spawn("arpspoof", ["-i", IFACE, "-t", GATEWAY_IP, DEVICE_IP], { stdio: "ignore" });
  arpProcesses.push(arp1, arp2);

  arp1.on("exit", function (c) { if (c !== null) warn("arpspoof[1] exited " + c); });
  arp2.on("exit", function (c) { if (c !== null) warn("arpspoof[2] exited " + c); });
  log("ARP spoof active");
}

function stopArpSpoof() {
  arpProcesses.forEach(function (p) { try { p.kill("SIGTERM"); } catch (_) {} });
  arpProcesses = [];
  try { execSync("sysctl -w net.ipv4.ip_forward=0", { stdio: "ignore" }); } catch (_) {}
}

// ─── NTRIP Caster Connections ────────────────────────────────────

var casterConns = {};

function buildNtripRequest(caster) {
  var auth = Buffer.from(caster.username + ":" + caster.password).toString("base64");
  var mp = caster.mountpoint ? "/" + caster.mountpoint : "/";
  return "POST " + mp + " HTTP/1.1\r\n" +
    "Host: " + caster.host + "\r\n" +
    "Ntrip-Version: Ntrip/2.0\r\n" +
    "Authorization: Basic " + auth + "\r\n" +
    "User-Agent: BTCPC-GNSS-Relay/1.0\r\n" +
    "Content-Type: application/octet-stream\r\n" +
    "Transfer-Encoding: chunked\r\n\r\n";
}

function connectCaster(caster) {
  if (!caster.enabled) return;
  var key = caster.name;
  if (casterConns[key] && !casterConns[key].destroyed) return;

  log("Connecting to " + caster.name + " (" + caster.host + ":" + caster.port + ")");
  var sock = net.createConnection({ host: caster.host, port: caster.port, timeout: 10000 });

  sock.on("connect", function () {
    sock.write(buildNtripRequest(caster));
    casterConns[key] = sock;
    casterConns[key].ready = false;
    log(caster.name + ": connected, awaiting ICY 200");
  });
  sock.on("data", function (data) {
    var r = data.toString();
    if (r.indexOf("200") !== -1 || r.indexOf("ICY 200") !== -1) {
      log(caster.name + ": streaming ✓");
      casterConns[key].ready = true;
    } else if (r.indexOf("401") !== -1) {
      warn(caster.name + ": auth failed (401)");
    } else {
      log(caster.name + ": " + r.trim().slice(0, 80));
    }
  });
  sock.on("error", function (e) {
    warn(caster.name + ": " + e.message + " — retry in 30s");
    casterConns[key] = null;
    setTimeout(function () { connectCaster(caster); }, 30000);
  });
  sock.on("close", function () {
    log(caster.name + ": disconnected — retry in 30s");
    casterConns[key] = null;
    setTimeout(function () { connectCaster(caster); }, 30000);
  });
  sock.on("timeout", function () { sock.destroy(); });
}

function forwardToCasters(rtcmData) {
  for (var c of CASTERS) {
    var conn = casterConns[c.name];
    if (conn && conn.ready && !conn.destroyed) {
      try {
        conn.write(rtcmData.length.toString(16) + "\r\n");
        conn.write(rtcmData);
        conn.write("\r\n");
        stats[c.name] = (stats[c.name] || 0) + rtcmData.length;
      } catch (e) {
        warn(c.name + ": write error: " + e.message);
      }
    }
  }
}

// ─── BTCPC Chain Recording ───────────────────────────────────────

var sensorId = MINER_ACCOUNT + "/gnss-base";
var sensorIdEncoded = encodeURIComponent(sensorId);
var _sensorRegistered = false;

function apiPost(urlPath, payload, cb) {
  var bodyStr = JSON.stringify(payload);
  var headers = {
    "Content-Type": "application/json",
    "Content-Length": Buffer.byteLength(bodyStr),
  };
  if (AUTH_TOKEN) headers["Authorization"] = "Bearer " + AUTH_TOKEN;
  var req = http.request({
    hostname: "127.0.0.1", port: API_PORT, path: urlPath,
    method: "POST", timeout: 8000, headers: headers,
  }, function (res) {
    var d = "";
    res.on("data", function (c) { d += c; });
    res.on("end", function () { cb && cb(null, res.statusCode, d); });
  });
  req.on("error", function (e) { cb && cb(e); });
  req.on("timeout", function () { req.destroy(); });
  req.write(bodyStr);
  req.end();
}

function ensureSensorRegistered(cb) {
  if (_sensorRegistered) return cb();
  apiPost("/api/sensors", {
    account: MINER_ACCOUNT, name: "gnss-base",
    type: "gps", unit: "rtcm3_frame", decimals: 0,
    region: "gnss-base/" + DEVICE_IP,
    hardware_model: "Hyfix MobileCM",
  }, function (err, status) {
    if (!err && (status === 201 || status === 409)) {
      _sensorRegistered = true;
      if (status === 201) log("sensor registered: " + sensorId);
    }
    cb();
  });
}

function recordOnChain(rtcmType, payloadBytes) {
  ensureSensorRegistered(function () {
    apiPost("/api/sensors/" + sensorIdEncoded + "/readings", {
      account: MINER_ACCOUNT,
      value: rtcmType,
      metadata: {
        type: "gps", unit: "rtcm3_frame", source: "hyfix-mobilecm",
        rtcm_type: rtcmType,
        payload_bytes: payloadBytes,
        device_ip: DEVICE_IP,
      },
    }, function (err, status) {
      if (err) warn("chain record error: " + err.message);
      else if (status !== 201 && status !== 200 && status !== 422) {
        warn("chain record HTTP " + status);
      }
    });
  });
}

// ─── Packet Capture ──────────────────────────────────────────────

var stats = { captured: 0, bytes: 0, chainRecords: 0 };
var chainRecordInterval = 30; // record every Nth RTCM packet

function startCapture() {
  log("Starting capture on " + IFACE);
  log("Filter: src " + DEVICE_IP + " → " + GEODNET_IP + ":" + GEODNET_PORT + " (UDP)");

  var tcpdump = spawn("tcpdump", [
    "-i", IFACE, "-n", "-l", "-B", "4096", "-w", "-",
    "src host " + DEVICE_IP + " and dst host " + GEODNET_IP +
    " and udp and dst port " + GEODNET_PORT,
  ], { stdio: ["ignore", "pipe", "ignore"] });

  var buf = Buffer.alloc(0);
  var seenGlobal = false;

  tcpdump.stdout.on("data", function (chunk) {
    buf = Buffer.concat([buf, chunk]);

    while (buf.length >= 16) {
      // Skip pcap global header (magic 0xa1b2c3d4 or 0xd4c3b2a1)
      var magic = buf.readUInt32LE(0);
      if (!seenGlobal && (magic === 0xa1b2c3d4 || magic === 0xd4c3b2a1)) {
        buf = buf.slice(24);
        seenGlobal = true;
        continue;
      }
      if (buf.length < 16) break;

      var inclLen = buf.readUInt32LE(8);
      var totalLen = 16 + inclLen;
      if (buf.length < totalLen) break;

      if (inclLen > 42) {
        var ipHeaderLen = (buf[16 + 14] & 0x0f) * 4;
        var udpStart = 16 + 14 + ipHeaderLen;
        var udpPayloadStart = udpStart + 8;
        var udpLen = buf.readUInt16BE(udpStart + 4);
        var payloadLen = udpLen - 8;

        if (payloadLen > 0 && udpPayloadStart + payloadLen <= totalLen) {
          var payload = buf.slice(udpPayloadStart, udpPayloadStart + payloadLen);

          if (payload[0] === 0xd3) {
            stats.captured++;
            stats.bytes += payloadLen;

            forwardToCasters(payload);

            // Record on chain every Nth packet to avoid flooding
            if (stats.captured % chainRecordInterval === 0) {
              var rtcmType = ((payload[1] & 0x03) << 10) | (payload[2] << 2) | ((payload[3] >> 6) & 0x03);
              recordOnChain(rtcmType, payloadLen);
              stats.chainRecords++;
            }
          }
        }
      }

      buf = buf.slice(totalLen);
    }
  });

  tcpdump.on("exit", function (code) {
    warn("tcpdump exited " + code + " — restarting in 5s");
    setTimeout(startCapture, 5000);
  });
}

// ─── Stats ───────────────────────────────────────────────────────

function logStats() {
  var activeCasters = CASTERS
    .filter(function (c) { return c.enabled; })
    .map(function (c) {
      var conn = casterConns[c.name];
      return c.name + "=" + (conn && conn.ready ? "live" : "offline");
    }).join(" ");
  log("captured=" + stats.captured + " bytes=" + stats.bytes +
    " chain=" + stats.chainRecords +
    (activeCasters ? " | " + activeCasters : ""));
}

// ─── Main ────────────────────────────────────────────────────────

function main() {
  log("BTCPC GNSS Relay — Hyfix MobileCM → BTCPC chain");
  log("device: " + DEVICE_IP + "  gateway: " + GATEWAY_IP);
  log("interface: " + IFACE + "  geodnet: " + GEODNET_IP + ":" + GEODNET_PORT);
  log("miner: " + MINER_ACCOUNT + "  sensor: " + sensorId);
  log("caster forwarding: " + (FORWARD_CASTERS ? "enabled" : "disabled (set BTCPC_GNSS_FORWARD_CASTERS=true to enable)"));
  log("");

  startArpSpoof();

  if (FORWARD_CASTERS) {
    for (var c of CASTERS) connectCaster(c);
  }

  // Give ARP spoof 3 seconds to poison caches before capturing
  setTimeout(function () {
    startCapture();
    log("Relay active — intercepting RTCM3 stream");
  }, 3000);

  setInterval(logStats, 30000);
}

function shutdown(sig) {
  log("Shutdown (" + sig + ")");
  stopArpSpoof();
  Object.keys(casterConns).forEach(function (k) {
    if (casterConns[k]) { try { casterConns[k].destroy(); } catch (_) {} }
  });
  process.exit(0);
}

process.on("SIGINT",  function () { shutdown("SIGINT"); });
process.on("SIGTERM", function () { shutdown("SIGTERM"); });

main();
