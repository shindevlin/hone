{
  "name": "hone",
  "version": "1.0.0",
  "description": "Bitcoin Proof of Compute — manage your HONE nodes, wallet, and earnings",
  "author": "Shin Devlin <shindevlin@proton.me>",
  "tools": [
    {
      "name": "hone_balance",
      "description": "Show HONE balance for an account",
      "exec": "node ${HONE_DIR}/bin/hone-cli balance ${account}",
      "parameters": {
        "account": { "type": "string", "description": "HONE account name", "required": false }
      }
    },
    {
      "name": "hone_status",
      "description": "Show status of all running HONE nodes on this device",
      "exec": "node ${HONE_DIR}/bin/hone-cli status"
    },
    {
      "name": "hone_mine_start",
      "description": "Start the HONE inference miner",
      "exec": "systemctl --user start hone-miner"
    },
    {
      "name": "hone_mine_stop",
      "description": "Stop the HONE inference miner",
      "exec": "systemctl --user stop hone-miner"
    },
    {
      "name": "hone_send",
      "description": "Send HONE tokens to another account",
      "exec": "node ${HONE_DIR}/bin/hone-cli transfer ${to} ${amount}",
      "parameters": {
        "to":     { "type": "string", "description": "Recipient account name", "required": true },
        "amount": { "type": "number", "description": "Amount of HONE to send", "required": true }
      }
    },
    {
      "name": "hone_logs",
      "description": "Show recent HONE node logs",
      "exec": "journalctl --user -u hone-miner -n 50 --no-pager"
    },
    {
      "name": "hone_install",
      "description": "Run the HONE node setup wizard",
      "exec": "node ${HONE_DIR}/bin/hone-install"
    }
  ],
  "env": {
    "HONE_DIR": "~/.hone/repo"
  }
}
