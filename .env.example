# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/urs-nerdcore-node

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Telegram API
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_API_URL=https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}

# Hive Blockchain
HIVE_NODE_URL=https://api.hive.engine/
HIVE_PRIVATE_KEY=your-hive-private-key
HIVE_PUBLIC_ADDRESS=your-hive-address

# TON Blockchain
TON_VKEY_FILE=/path/to/ton-vkey.json
TON_PASSPHRASE="Devnet"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers Content Security Policy
CSP_REPORT_URI=/report-csp-violation

# Admin (Optional)
ADMIN_EMAIL=your-email@example.com
