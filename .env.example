# Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/urs-nerdcore-node

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Ollama — only set this if you need a non-default address
# Default: http://host.docker.internal:11434 (works on all platforms)
# OLLAMA_URL=http://host.docker.internal:11434

# Mining
# BTCPC_MINER=yourwallet
# BTCPC_MODEL=qwen3:4b

# Telegram API
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_API_URL=https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}

# Hive Blockchain
HIVE_NODE_URL=https://api.hive.engine/
HIVE_PRIVATE_KEY=your-hive-private-key
HIVE_PUBLIC_ADDRESS=your-hive-address

# TON Blockchain
TON_VKEY_FILE=/path/to/ton-vkey.json
TON_PASSPHRASE="Devnet"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers Content Security Policy
CSP_REPORT_URI=/report-csp-violation

# Admin (Optional)
ADMIN_EMAIL=your-email@example.com

# BTCPC Purchase Payment Addresses
BTCPC_PURCHASE_ETH_ADDRESS=0xBDe88F2B3a224B242704bD166804E0E12c75e830
BTCPC_PURCHASE_SOL_ADDRESS=
BTCPC_PURCHASE_TON_ADDRESS=
