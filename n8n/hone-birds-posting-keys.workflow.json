{
  "id": "5YHWKOF8CHCeOMOK",
  "name": "HONE: birds posting-key refresh",
  "active": false,
  "nodes": [
    {
      "id": "6b0f0b1e-0001-4c3a-9f00-000000000001",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -260
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## HONE birds: posting-key refresh\nEvery 3 hours: reads all accounts' posting public keys from the local Hone node (http://127.0.0.1:4242/api/accounts) and pushes them to the birds indexer (https://honemesh.net/api/birds/admin/posting-keys).\nThe indexer only accepts sightings and photos signed by an account's posting key; this table is how it checks them (ferryvps can't reach a node).\nSecret: the indexer admin token lives in this workflow's static data (also in /etc/hone-birds.env on ferryvps). No other keys needed.\nSource: shindevlin/hone, n8n/hone-birds-posting-keys.workflow.json"
      }
    },
    {
      "id": "6b0f0b1e-0002-4c3a-9f00-000000000002",
      "name": "Every 3 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 3
            }
          ]
        }
      }
    },
    {
      "id": "6b0f0b1e-0003-4c3a-9f00-000000000003",
      "name": "Get accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://127.0.0.1:4242/api/accounts",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6b0f0b1e-0004-4c3a-9f00-000000000004",
      "name": "Build key table",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst keys = {};\nfor (const a of ($input.first().json.accounts || [])) {\n  const p = a.keys && a.keys.posting;\n  if (p && /^[0-9a-fA-F]{64}$/.test(p)) keys[a.account] = p.toLowerCase();\n}\nif (Object.keys(keys).length < 10) throw new Error('node returned too few accounts');\nreturn [{ json: { keys, token: sd.token, count: Object.keys(keys).length } }];"
      }
    },
    {
      "id": "6b0f0b1e-0005-4c3a-9f00-000000000005",
      "name": "Push to indexer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://honemesh.net/api/birds/admin/posting-keys",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Hone-Admin",
              "value": "={{ $json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.keys) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6b0f0b1e-0006-4c3a-9f00-000000000006",
      "name": "Run on demand",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 3 hours": {
      "main": [
        [
          {
            "node": "Get accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get accounts": {
      "main": [
        [
          {
            "node": "Build key table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build key table": {
      "main": [
        [
          {
            "node": "Push to indexer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "Get accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "staticData": {
    "global": {
      "token": "__TOKEN__"
    }
  }
}