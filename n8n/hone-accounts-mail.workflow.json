{
  "name": "HONE: account verification emails",
  "nodes": [
    {
      "parameters": {
        "content": "## HONE account emails\nEvery minute: read unsent verification emails from the HONE indexer outbox, send each with the mail credential, then acknowledge it (the indexer deletes it).\n\nSetup:\n1. Credential `HONE indexer admin` (Header Auth): name `X-Hone-Admin`, value = HONE_DEVICES_ADMIN_TOKEN from /etc/hone-birds.env on ferryvps.\n2. Pick the sending mailbox in **Send email** (SMTP credential).\n3. Activate.\n\nThe outbox keeps a message at most 1 hour; codes expire after 30 minutes.",
        "height": 300,
        "width": 420
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, -340]
    },
    {
      "parameters": { "rule": { "interval": [ { "field": "minutes", "minutesInterval": 1 } ] } },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://honemesh.net/api/accounts/admin/outbox",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Get outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "HONE indexer admin" } }
    },
    {
      "parameters": {
        "fromEmail": "HONE <hello@honemesh.net>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": { "appendAttribution": false }
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [440, 0],
      "credentials": { "smtp": { "id": "", "name": "HONE mail (choose mailbox)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://honemesh.net/api/accounts/admin/outbox/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: [ $('Get outbox').item.json.id ] }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "HONE indexer admin" } }
    }
  ],
  "connections": {
    "Every minute": { "main": [ [ { "node": "Get outbox", "type": "main", "index": 0 } ] ] },
    "Get outbox": { "main": [ [ { "node": "Send email", "type": "main", "index": 0 } ] ] },
    "Send email": { "main": [ [ { "node": "Acknowledge", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none" },
  "active": false
}
