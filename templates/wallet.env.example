# BTCPC wallet configuration
# Copy to .btcpc/wallet.env in your project root and fill in your values.
# Add .btcpc/wallet.env to your .gitignore — it contains credentials.

# Your BTCPC account name.
# Create one: btcpc wallet create yourname
# Or via Telegram: message @btcpcbot  /create yourname
BTCPC_ACCOUNT=

# API key for paid endpoints (e.g. /v1/chat/completions).
# Currently equals your account name — rotate-able tokens in a future release.
# Get tokens: btcpc faucet claim $BTCPC_ACCOUNT
# Or via Telegram: message @btcpcbot  /faucet
BTCPC_API_KEY=

# Node endpoint to connect to.
# Defaults to https://btcpc.net — override to use your own node.
# BTCPC_API_URL=https://btcpc.net
