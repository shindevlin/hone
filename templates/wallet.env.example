# HONE wallet configuration
# Copy to .hone/wallet.env in your project root and fill in your values.
# Add .hone/wallet.env to your .gitignore — it contains credentials.

# Your HONE account name.
# Create one: hone wallet create yourname
# Or via Telegram: message @honebot  /create yourname
HONE_ACCOUNT=

# API key for paid endpoints (e.g. /v1/chat/completions).
# Generate a secure random key: hone wallet api-key-gen --mnemonic "your twelve words"
# Get tokens first: hone faucet claim $HONE_ACCOUNT
# Or via Telegram: message @honebot  /faucet
HONE_API_KEY=

# Node endpoint to connect to.
# Defaults to https://honemesh.net — override to use your own node.
# HONE_API_URL=https://honemesh.net
